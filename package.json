{
  "name": "next-step-studios",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/fetch-releases.mjs && node scripts/verify-content.mjs && node scripts/make-pdfs.mjs && node scripts/make-cheatsheet.mjs && node scripts/make-brand-zip.mjs && astro build",
    "preview": "astro preview",
    "pdfs": "node scripts/make-pdfs.mjs && node scripts/make-cheatsheet.mjs",
    "cheatsheet": "node scripts/make-cheatsheet.mjs",
    "snapshot": "node scripts/snapshot-policies.mjs",
    "og": "node scripts/make-og-pages.mjs",
    "releases": "node scripts/fetch-releases.mjs",
    "brand": "node scripts/make-brand-assets.mjs && node scripts/make-brand-zip.mjs",
    "banners": "node scripts/make-banners.mjs",
    "brand:zip": "node scripts/make-brand-zip.mjs",
    "logos": "node scripts/make-brand-assets.mjs && node scripts/make-brand-zip.mjs",
    "status": "node scripts/status-publish.mjs",
    "contact": "node server/index.mjs",
    "hash-password": "node server/hash-password.mjs",
    "assets": "node scripts/make-brand-assets.mjs && node scripts/make-brand-zip.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@fontsource-variable/space-grotesk": "^5.1.0",
    "astro": "^5.1.0"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1"
  }
}
