---
const shortcuts = [
  { keys: ['Ctrl', 'K'], action: 'Open the command palette' },
  { keys: ['/'], action: 'Go to the search page' },
  { keys: ['?'], action: 'Open this list' },
  { keys: ['Esc'], action: 'Close the palette, menu or this dialog' },
  { keys: ['Tab'], action: 'Move through links and controls' },
  { keys: ['Enter'], action: 'Follow the focused link, or run the focused control' },
];
---

<dialog class="shortcuts" data-shortcuts aria-labelledby="shortcuts-title">
  <div class="shortcuts-head">
    <div>
      <p class="label">Reference</p>
      <h2 id="shortcuts-title">Keyboard shortcuts</h2>
    </div>
    <button type="button" class="tool-btn" data-shortcuts-close aria-label="Close shortcuts">✕</button>
  </div>
  <dl class="shortcut-list">
    {shortcuts.map((shortcut) => (
      <div class="shortcut-row">
        <dt>
          {shortcut.keys.map((key) => <kbd>{key}</kbd>)}
        </dt>
        <dd>{shortcut.action}</dd>
      </div>
    ))}
  </dl>
  <p class="shortcuts-note">
    Shortcuts are ignored while typing in a field, so they never interfere with search.
  </p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-shortcuts]');
  const close = document.querySelector<HTMLButtonElement>('[data-shortcuts-close]');
  const trigger = document.querySelector<HTMLElement>('[data-shortcuts-open]');

  if (dialog) {
    const open = () => {
      if (!dialog.open) dialog.showModal();
    };

    const isTyping = (target: EventTarget | null) => {
      const element = target as HTMLElement | null;
      if (!element) return false;
      return (
        element.tagName === 'INPUT' ||
        element.tagName === 'TEXTAREA' ||
        element.tagName === 'SELECT' ||
        element.isContentEditable
      );
    };

    document.addEventListener('keydown', (event) => {
      if (event.key === '?' && !event.metaKey && !event.ctrlKey && !event.altKey && !isTyping(event.target)) {
        event.preventDefault();
        open();
      }
    });

    trigger?.addEventListener('click', open);
    close?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
