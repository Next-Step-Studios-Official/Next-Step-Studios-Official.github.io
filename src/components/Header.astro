---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import { SITE } from '../lib/site';

const { path } = Astro.props as { path: string };

type NavEntry = { href: string; label: string };
type NavGroup = { label: string; id: string; links: NavEntry[] };

const navLinks: NavEntry[] = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/devlog', label: 'Devlog' },
  { href: '/commands', label: 'Commands' },
];

const navMenus: NavGroup[] = [
  {
    id: 'studio',
    label: 'Studio',
    links: [
      { href: '/about', label: 'About' },
      { href: '/roadmap', label: 'Roadmap' },
      { href: '/changelog', label: 'Changelog' },
      { href: '/status', label: 'Status' },
      { href: '/stack', label: 'Stack' },
      { href: '/faq', label: 'FAQ' },
    ],
  },
  {
    id: 'community',
    label: 'Community',
    links: [
      { href: '/social', label: 'Social' },
      { href: '/links', label: 'Official links' },
      { href: '/downloads', label: 'Downloads' },
    ],
  },
];

const navTail: NavEntry[] = [
  { href: '/policies', label: 'Policies' },
  { href: '/contact', label: 'Contact' },
];

const menuLinks: NavEntry[] = [
  ...navLinks,
  ...navMenus.flatMap((group) => group.links),
  ...navTail,
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const isGroupActive = (group: NavGroup) => group.links.some((link) => isActive(link.href));
---

<header class="site-header" data-header>
  <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>

  <div class="container header-inner">
    <a class="wordmark" href="/">
      <Image class="wordmark-logo" src={logo} width={30} height={30} alt="" aria-hidden="true" />
      <span>Next Step <span class="wordmark-dim">Studios</span></span>
    </a>

    <div class="header-tools">
      <nav class="nav" aria-label="Primary">
        {navLinks.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
        ))}

        {navMenus.map((group) => (
          <div class="nav-dropdown" data-nav-dropdown>
            <button
              type="button"
              class:list={['nav-dropdown-trigger', { 'is-current': isGroupActive(group) }]}
              data-nav-trigger
              aria-expanded="false"
              aria-controls={`nav-menu-${group.id}`}
            >
              {group.label}
              <span class="nav-caret" aria-hidden="true">▾</span>
            </button>
            <ul class="nav-menu" id={`nav-menu-${group.id}`} data-nav-menu hidden>
              {group.links.map((link) => (
                <li>
                  <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}

        {navTail.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
        ))}
      </nav>

      <a class="tool-btn tool-btn--search" href="/search" aria-label="Search the site">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="6.8" cy="6.8" r="4.4" stroke="currentColor" stroke-width="1.3" />
          <path d="M10.2 10.2 14 14" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
        </svg>
        <span class="tool-btn-label">Search</span>
      </a>

      <button
        type="button"
        class="tool-btn palette-trigger"
        data-palette-open
        aria-label="Open the command palette"
        aria-keyshortcuts="Control+K Meta+K"
      >
        <span class="tool-btn-label">Jump to</span>
        <kbd class="tool-kbd" data-palette-kbd>Ctrl K</kbd>
      </button>

      <button
        type="button"
        class="tool-btn menu-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="Open menu"
      >
        <span class="menu-bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="site-menu" data-drawer hidden>
  <div class="drawer-backdrop" data-drawer-close></div>
  <div class="drawer-panel" role="dialog" aria-modal="true" aria-label="Site menu">
    <div class="drawer-head">
      <span class="label">Menu</span>
      <button type="button" class="tool-btn" data-drawer-close aria-label="Close menu">✕</button>
    </div>

    <nav class="drawer-nav" aria-label="Site">
      {menuLinks.map((link, index) => (
        <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
          <span class="drawer-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        </a>
      ))}
    </nav>

    <div class="drawer-foot">
      <a class="drawer-search" href="/search">
        <span>Search everything</span>
        <span aria-hidden="true">→</span>
      </a>
      <button type="button" class="drawer-search" data-palette-open>
        <span>Jump to a page</span>
        <kbd class="tool-kbd">Ctrl K</kbd>
      </button>
      <a class="drawer-mail" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
    </div>
  </div>
</div>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const progress = document.querySelector<HTMLElement>('[data-scroll-progress]');
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
  const kbd = document.querySelector<HTMLElement>('[data-palette-kbd]');
  if (kbd && isMac) kbd.textContent = '⌘K';

  const setProgress = () => {
    const doc = document.documentElement;
    const max = doc.scrollHeight - window.innerHeight;
    const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    if (progress) progress.style.width = `${(ratio * 100).toFixed(2)}%`;
    header?.classList.toggle('is-scrolled', window.scrollY > 8);
  };
  setProgress();
  window.addEventListener('scroll', setProgress, { passive: true });
  window.addEventListener('resize', setProgress);

  // Desktop dropdowns: click to open, Escape or an outside click to close.
  const dropdowns = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-dropdown]'));

  const closeDropdowns = (except?: HTMLElement) => {
    dropdowns.forEach((dropdown) => {
      if (dropdown === except) return;
      dropdown.querySelector('[data-nav-trigger]')?.setAttribute('aria-expanded', 'false');
      const menu = dropdown.querySelector<HTMLElement>('[data-nav-menu]');
      if (menu) menu.hidden = true;
    });
  };

  dropdowns.forEach((dropdown) => {
    const trigger = dropdown.querySelector<HTMLButtonElement>('[data-nav-trigger]');
    const menu = dropdown.querySelector<HTMLElement>('[data-nav-menu]');
    if (!trigger || !menu) return;

    trigger.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') === 'true';
      closeDropdowns(dropdown);
      trigger.setAttribute('aria-expanded', String(!open));
      menu.hidden = open;
    });

    dropdown.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        trigger.setAttribute('aria-expanded', 'false');
        menu.hidden = true;
        trigger.focus();
      }
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (!target.closest('[data-nav-dropdown]')) closeDropdowns();
  });

  document.addEventListener('focusin', (event) => {
    const target = event.target as HTMLElement;
    if (!target.closest('[data-nav-dropdown]')) closeDropdowns();
  });

  let closeTimer: number | undefined;

  const openDrawer = () => {
    if (!drawer || !toggle) return;
    window.clearTimeout(closeTimer);
    drawer.hidden = false;
    // Force a style flush so the slide-in transition always runs, even when
    // requestAnimationFrame is throttled in a background tab.
    void drawer.offsetWidth;
    drawer.classList.add('is-open');
    document.body.classList.add('drawer-open');
    toggle.setAttribute('aria-expanded', 'true');
    header?.classList.add('is-menu-open');
    const first = drawer.querySelector<HTMLElement>('.drawer-nav a');
    window.setTimeout(() => first?.focus(), 120);
  };

  const closeDrawer = (returnFocus = true) => {
    if (!drawer || !toggle) return;
    if (drawer.hidden) return;
    drawer.classList.remove('is-open');
    toggle.setAttribute('aria-expanded', 'false');
    header?.classList.remove('is-menu-open');
    document.body.classList.remove('drawer-open');
    if (returnFocus) toggle.focus();
    closeTimer = window.setTimeout(() => {
      drawer.hidden = true;
    }, 340);
  };

  toggle?.addEventListener('click', () => {
    if (!drawer) return;
    if (drawer.classList.contains('is-open')) closeDrawer();
    else openDrawer();
  });

  drawer?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('[data-drawer-close]') || target.closest('a')) closeDrawer();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && drawer?.classList.contains('is-open')) closeDrawer();
  });

  // Keep Tab inside the drawer while it is open.
  drawer?.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab' || !drawer.classList.contains('is-open')) return;
    const focusable = Array.from(
      drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
    ).filter((element) => element.offsetParent !== null);
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  window.addEventListener('site:closedrawer', () => closeDrawer(false));

  window
    .matchMedia('(min-width: 1025px)')
    .addEventListener('change', (event) => {
      if (event.matches) closeDrawer(false);
    });
</script>
