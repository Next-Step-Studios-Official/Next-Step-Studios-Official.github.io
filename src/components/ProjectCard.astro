---
interface Props {
  title: string;
  tagline: string;
  summary: string;
  status: string;
  category: string;
  href?: string;
  cover?: string;
}

const { title, tagline, summary, status, category, href, cover } = Astro.props;
import StatusBadge from './StatusBadge.astro';
---

{ href ? (
  <a class="panel panel-link project-card project-card--covered" href={href}>
    {cover && (
      <img class="project-card-cover" src={cover} alt="" width={1100} height={619} loading="lazy" />
    )}
    <div class="project-card-top">
      <span class="project-card-cat">{category}</span>
      <StatusBadge status={status} />
    </div>
    <h3>{title}</h3>
    <p>{tagline}</p>
    <span class="project-card-foot">View project <span class="card-arrow" aria-hidden="true">↗</span></span>
  </a>
) : (
  <div class="panel project-card">
    {cover && (
      <img class="project-card-cover" src={cover} alt="" width={1100} height={619} loading="lazy" />
    )}
    <div class="project-card-top">
      <span class="project-card-cat">{category}</span>
      <StatusBadge status={status} />
    </div>
    <h3>{title}</h3>
    <p>{tagline}</p>
  </div>
) }
