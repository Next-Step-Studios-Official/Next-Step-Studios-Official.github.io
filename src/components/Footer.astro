---
import { Image } from 'astro:assets';
import logoMark from '../assets/brand/logo-mark.png';
import { SITE } from '../lib/site';
import { discordInvite, DISCORD } from '../lib/discord';
import { TEAM_WORD } from '../lib/contributors';

const year = new Date().getFullYear();
const invite = discordInvite();

const studioLinks = [
  { href: '/projects', label: 'Projects' },
  { href: '/devlog', label: 'Devlog' },
  { href: '/commands', label: 'Commands' },
  { href: '/modules', label: 'Modules' },
  { href: '/search', label: 'Search' },
  { href: '/step', label: 'How Step works' },
  { href: '/team', label: 'Team' },
  { href: '/archive', label: 'Archive' },
  { href: '/links', label: 'Official links' },
];

const referenceLinks = [
  { href: '/roadmap', label: 'Roadmap' },
  { href: '/changelog', label: 'Changelog' },
  { href: '/status', label: 'Status' },
  { href: '/stack', label: 'Stack' },
  { href: '/faq', label: 'FAQ' },
  { href: '/glossary', label: 'Glossary' },
  { href: '/press', label: 'Press kit' },
  { href: '/brand', label: 'Brand' },
  { href: '/sitemap', label: 'Sitemap' },
];

const policyLinks = [
  { href: '/policies', label: 'All Bot policies' },
  { href: '/trust', label: 'Trust centre' },
  { href: '/policies/bot/privacy', label: 'Privacy Policy' },
  { href: '/policies/bot/terms', label: 'Terms of Service' },
  { href: '/downloads', label: 'Downloads' },
  { href: '/website-privacy', label: 'Website privacy' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col footer-brand">
        <a class="wordmark" href="/">
          <Image class="wordmark-logo" src={logoMark} width={34} height={34} alt="" aria-hidden="true" />
          <span>Next Step <span class="wordmark-dim">Studios</span></span>
        </a>
        <p class="footer-note">
          An independent creative and software studio run by {SITE.operator}, with a team of
          {TEAM_WORD} people. No accounts, no tracking, no advertising.
        </p>
        <a class="footer-mail" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
        {invite && (
          <a class="footer-mail" href={invite} rel="noopener">
            Join the {DISCORD.serverName} Discord →
          </a>
        )}
      </div>

      <nav class="footer-col" aria-label="Studio">
        <p class="label">Studio</p>
        <ul class="footer-links">
          {studioLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Reference">
        <p class="label">Reference</p>
        <ul class="footer-links">
          {referenceLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Discord bot policies">
        <p class="label">Documents</p>
        <ul class="footer-links">
          {policyLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
        <ul class="footer-links footer-links--minor">
          <li><a href="/contact">Contact</a></li>
          <li><a href="/contact#privacy-requests">Privacy requests</a></li>
          <li><a href="/rss.xml">Devlog RSS</a></li>
          <li><a href="/policies/rss.xml">Policy RSS</a></li>
          <li><button type="button" class="footer-shortcuts" data-shortcuts-open>Keyboard shortcuts</button></li>
        </ul>
      </nav>
    </div>

    <div class="footer-base">
      <p>© {year} <span class="wordmark-dim">{SITE.name}</span> · {SITE.operator}</p>
      <p>Public-facing name of an independent studio. Not a registered company.</p>
    </div>
  </div>
</footer>
