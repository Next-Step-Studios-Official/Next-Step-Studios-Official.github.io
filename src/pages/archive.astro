---
import Base from '../layouts/Base.astro';
import brandAssets from '../data/brand-assets.json';
import { statSync } from 'node:fs';

const zipPath = 'public/downloads/next-step-studios-brand-kit.zip';
const zipBytes = statSync(zipPath).size;
const zipSize = `${(zipBytes / 1024 / 1024).toFixed(2)} MB`;

const current = brandAssets.marks.find((mark) => mark.id === 'logo')!;
const retired = brandAssets.marks.find((mark) => mark.id === 'neon-emblem-2026-07-25')!;

const fileFor = (
  mark: (typeof brandAssets.marks)[number],
  size: number,
  format: string,
  variant = 'standard',
) => mark.files.find((file) => file.size === size && file.format === format && file.variant === variant);

const kb = (bytes: number) => `${Math.max(1, Math.round(bytes / 1024))} KB`;
const totalFiles = current.files.length + retired.files.length;

const whiteTile = '/brand/archive/logo-white-tile-2026-11-21.png';
const whiteTileBytes = statSync(`public${whiteTile}`).size;
---

<Base
  title="Archive"
  description="Every Next Step Studios mark, including retired artwork, at four sizes in PNG, JPG and SVG — with a permanent address for each file."
  path="/archive"
>
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack">
        <p class="eyebrow">Brand archive</p>
        <h1 class="display display--page">Every mark, kept.</h1>
        <p class="lede">
          Old logos do not stop appearing because a studio replaced them. This page keeps each
          mark at a permanent address, in every size and format, so an article written years ago
          still points at the file it described.
        </p>
        <div class="meta-bar">
          <span>{totalFiles} files</span>
          <span>4 sizes · 3 formats</span>
          <span>Nothing overwritten or deleted</span>
        </div>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/downloads/next-step-studios-brand-kit.zip" download>
            Download everything (.zip) <span class="btn-arrow" aria-hidden="true">↓</span>
          </a>
          <a class="btn" href="/press">Press kit</a>
          <a class="btn" href="/brand">Usage rules</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--flush">
    <div class="container">
      <div class="archive-current">
        <div class="archive-previews">
          <figure class="archive-preview archive-preview--light">
            <img src="/brand/press/logo-512.png" width="512" height="512" alt="Current Next Step Studios logo, transparent" />
            <figcaption>Transparent · for light surfaces</figcaption>
          </figure>
          <figure class="archive-preview archive-preview--dark">
            <img src="/brand/press/logo-light-512.png" width="512" height="512" alt="Current Next Step Studios logo with a light outline for dark surfaces" />
            <figcaption>Light outline · for dark surfaces</figcaption>
          </figure>
        </div>

        <div>
          <p class="label">Current · since 25 July 2026</p>
          <h2 class="archive-title">The ninja mark</h2>
          <p class="archive-copy">
            A transparent PNG master cut from the original artwork, with white removed from the
            outside only. White details inside the mark — the eyes, the highlights — are still
            there. The JPGs are flattened on <code>#07080B</code> and use the light-outline
            treatment, because a black ninja on a near-black background otherwise disappears.
          </p>
          <p class="archive-copy archive-copy--muted">
            The SVG files wrap the transparent PNG at each size. They scale in layout without a
            blurry browser resize, but they are not a vector redraw.
          </p>
        </div>
      </div>

      <div class="asset-block">
        <div class="section-head">
          <h2>Current mark · downloads</h2>
          <span class="label">{current.files.length} files</span>
        </div>
        <div class="asset-table-wrap">
          <table class="asset-table">
            <thead>
              <tr>
                <th scope="col">Size</th>
                <th scope="col">PNG</th>
                <th scope="col">JPG · dark</th>
                <th scope="col">SVG</th>
                <th scope="col">Light PNG</th>
                <th scope="col">Light SVG</th>
              </tr>
            </thead>
            <tbody>
              {
                brandAssets.sizes.map((size) => (
                  <tr>
                    <th scope="row">{size} × {size}</th>
                    {([
                      ['png', 'standard'],
                      ['jpg', 'light'],
                      ['svg', 'standard'],
                    ] as const).map(([format, variant]) => {
                      const file = fileFor(current, size, format, variant);
                      return (
                        <td>
                          {file ? (
                            <a href={file.path} download>
                              {kb(file.bytes)}
                            </a>
                          ) : (
                            '—'
                          )}
                        </td>
                      );
                    })}
                    {['png', 'svg'].map((format) => {
                      const file = fileFor(current, size, format, 'light');
                      return (
                        <td>
                          {file ? (
                            <a href={file.path} download>
                              {kb(file.bytes)}
                            </a>
                          ) : (
                            '—'
                          )}
                        </td>
                      );
                    })}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="asset-note">Link text shows the file size, not the dimensions twice. Every link downloads the file directly.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Retired · 25 July 2026</p>
          <h2 class="section-title" style="margin-top: 0.65rem;">Neon orbit emblem</h2>
        </div>
        <span class="label">{retired.files.length} files</span>
      </div>

      <div class="retired-grid">
        <div class="panel retired-preview">
          <img src="/brand/archive/neon-emblem-2026-07-25-512.png" width="512" height="512" alt="Retired neon orbit emblem" loading="lazy" />
        </div>
        <div>
          <p class="archive-copy">
            The mark used before the current logo. Kept because old posts, videos and documents
            still show it, and a press kit that erases its own history is not much of an archive.
            Its white background has been removed the same way, and the bright artwork needs no
            light-outline treatment.
          </p>
          <p class="archive-copy archive-copy--muted">
            The original flattened 1024px file is still at
            <a class="text-link" href="/brand/archive/neon-emblem-2026-07-25.png" download>neon-emblem-2026-07-25.png</a>
            and has not been touched.
          </p>
        </div>
      </div>

      <div class="asset-block">
        <div class="asset-table-wrap">
          <table class="asset-table">
            <thead>
              <tr>
                <th scope="col">Size</th>
                <th scope="col">PNG</th>
                <th scope="col">JPG · dark</th>
                <th scope="col">SVG</th>
              </tr>
            </thead>
            <tbody>
              {
                brandAssets.sizes.map((size) => (
                  <tr>
                    <th scope="row">{size} × {size}</th>
                    {([
                      ['png', 'standard'],
                      ['jpg', 'light'],
                      ['svg', 'standard'],
                    ] as const).map(([format, variant]) => {
                      const file = fileFor(retired, size, format, variant);
                      return (
                        <td>
                          {file ? (
                            <a href={file.path} download>
                              {kb(file.bytes)}
                            </a>
                          ) : (
                            '—'
                          )}
                        </td>
                      );
                    })}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Superseded · 21 November 2026</p>
          <h2 class="section-title" style="margin-top: 0.65rem;">The white-tile edition</h2>
        </div>
      </div>
      <div class="retired-grid">
        <div class="panel retired-preview retired-preview--white">
          <img src={whiteTile} width="1024" height="1024" alt="The superseded white-tile version of the Next Step Studios logo" loading="lazy" />
        </div>
        <div>
          <p class="archive-copy">
            The logo as it appeared before transparency: the same artwork on a solid white tile.
            The live files were replaced in place, so this flattened copy is the record of how
            the mark used to look.
          </p>
          <p class="archive-links">
            <a class="text-link" href={whiteTile} download>PNG · 1024px · {kb(whiteTileBytes)}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div class="panel panel--pad">
          <p class="label">How the archive works</p>
          <p class="archive-copy archive-copy--muted">
            A mark is never overwritten once it has been superseded. New artwork gets a new
            filename; the old files stay where they are. That is why the retired emblem still
            resolves, and why the white-tile edition is kept as a dated file.
          </p>
        </div>
        <div class="panel panel--pad">
          <p class="label">Download everything</p>
          <p class="archive-copy archive-copy--muted">
            One ZIP with every file on this page, plus a README explaining which treatment to use
            where. {zipSize}, {totalFiles} brand files.
          </p>
          <a class="btn btn-primary" href="/downloads/next-step-studios-brand-kit.zip" download style="margin-top: 1rem;">
            Brand kit .zip <span class="btn-arrow" aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .archive-current {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    margin-bottom: 2.5rem;
  }

  .archive-previews { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

  .archive-preview {
    margin: 0;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-panel);
  }

  .archive-preview img { display: block; width: 100%; height: auto; }

  .archive-preview figcaption {
    padding: 0.6rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    border-top: 1px solid var(--color-line-soft);
  }

  .archive-preview--light {
    background-color: #e9eef7;
    background-image:
      linear-gradient(45deg, #d3dae6 25%, transparent 25%),
      linear-gradient(-45deg, #d3dae6 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #d3dae6 75%),
      linear-gradient(-45deg, transparent 75%, #d3dae6 75%);
    background-size: 22px 22px;
    background-position: 0 0, 0 11px, 11px -11px, -11px 0;
  }

  .archive-preview--dark { background: #07080b; }

  .archive-title { font-size: clamp(1.8rem, 4vw, 2.6rem); margin-top: 0.75rem; }

  .archive-copy { color: var(--color-ink-dim); font-size: 0.975rem; line-height: 1.65; margin-top: 1rem; }
  .archive-copy--muted { color: var(--color-muted); font-size: 0.9rem; }

  .asset-block { margin-top: 2rem; }
  .asset-table-wrap { overflow-x: auto; border: 1px solid var(--color-line); border-radius: 12px; }

  .asset-table { width: 100%; border-collapse: collapse; min-width: 620px; }

  .asset-table th,
  .asset-table td {
    padding: 0.8rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--color-line-soft);
    font-size: 0.875rem;
  }

  .asset-table thead th {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    background: var(--color-panel);
  }

  .asset-table tbody tr:last-child th,
  .asset-table tbody tr:last-child td { border-bottom: 0; }

  .asset-table tbody th { font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-ink); }
  .asset-table td a { color: var(--color-accent-soft); text-decoration: none; }
  .asset-table td a:hover { text-decoration: underline; }

  .asset-note { color: var(--color-muted); font-size: 0.8rem; margin-top: 0.75rem; }

  .retired-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    margin-top: 1.5rem;
  }

  .retired-preview { padding: 1rem; background: #07080b; display: grid; place-items: center; }
  .retired-preview--white { background: #ffffff; }
  .retired-preview img { max-width: 100%; height: auto; display: block; }

  @media (max-width: 860px) {
    .archive-current,
    .retired-grid { grid-template-columns: 1fr; }
    .archive-previews { grid-template-columns: 1fr 1fr; }
  }
</style>
