---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import supportBanner from '../assets/banners/support.jpg';
import { SITE } from '../lib/site';

const mailto = `mailto:${SITE.contactEmail}`;
---

<Base
  title="Contact"
  description="How to contact Next Step Studios — email only, including how to submit a privacy request."
  path="/contact"
>
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack">
        <p class="eyebrow">Contact</p>
        <h1 class="display display--page">One address. One person reading it.</h1>
        <p class="lede">
          Email is the only public contact route. There is no contact form on this site,
          because a form would mean collecting and storing what you write.
        </p>
        <figure class="page-banner">
          <Image
            src={supportBanner}
            alt="Next Step Studios Support — we’re here to help."
            widths={[600, 900, 1200]}
            sizes="(max-width: 900px) 100vw, 1100px"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--flush">
    <div class="container">
      <div class="split" style="align-items: start;">
        <div class="panel panel--pad">
          <p class="label">Email</p>
          <a
            href={mailto}
            style="display: block; font-family: var(--font-mono); font-size: clamp(0.95rem, 2vw, 1.15rem); color: var(--color-accent-soft); margin-top: 0.85rem; word-break: break-all;"
          >
            {SITE.contactEmail}
          </a>
          <p style="color: var(--color-muted); font-size: 0.875rem; margin-top: 1.1rem;">
            This is a temporary address and may later be replaced with one on the studio's
            own domain. This page will always show the current one.
          </p>
          <p style="color: var(--color-muted); font-size: 0.875rem; margin-top: 0.85rem;">
            There is no ticketing system and no response-time guarantee. Messages are read
            and answered by one person.
          </p>
        </div>

        <div>
          <h2 id="privacy-requests" style="font-size: clamp(1.3rem, 2.4vw, 1.65rem); scroll-margin-top: 6rem;">
            Privacy requests
          </h2>
          <div class="prose" style="margin-top: 1rem;">
            <p>
              Requests for access to, correction of, or deletion of personal information are
              handled by email. Nothing about the request is submitted automatically, and no
              portal or form exists.
            </p>
            <p>To make a request, email the address above and include:</p>
            <ul>
              <li>the subject line <strong>Privacy Request</strong>;</li>
              <li>your Discord user ID, so the right records can be identified;</li>
              <li>whether you are asking for access, correction, or deletion;</li>
              <li>anything specific the request applies to, such as an application or a support ticket.</li>
            </ul>
            <p>
              The <a href="/policies/bot/privacy">Privacy Policy</a> and
              <a href="/policies/bot/data-retention">Data Retention and Deletion Policy</a>
              describe what the Discord bot stores. Both are drafts pending review, so where
              they describe behaviour that has not been verified, treat the description as
              provisional rather than as a confirmed commitment.
            </p>
            <p style="color: var(--color-ink);">
              <strong>Never send passwords, bot tokens, API keys or Discord account
              credentials.</strong> Nothing in a legitimate request requires them.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="tickets">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="label">In the Discord server</p>
          <h2 class="section-title" style="margin-top: 0.5rem;">Support tickets.</h2>
        </div>
        <a class="text-link" href="/social">Get the invite →</a>
      </div>

      <div class="split" style="align-items: start;">
        <div class="panel panel--pad">
          <p class="label">How it works</p>
          <ol class="ticket-steps">
            <li>Join the server with the public invite link.</li>
            <li>Open the ticket channel and choose the ticket type that matches the question.</li>
            <li>A private channel is created, visible to you and the staff team.</li>
            <li>Reply there, or use the waiting and close commands when the topic is resolved.</li>
          </ol>
          <p class="ticket-note">
            The exact channel names are not published here, because they are configuration that
            changes. The bot's <span class="mono">/ticket-panel</span> command is the authoritative
            entry point, and staff can point you to it.
          </p>
        </div>

        <div class="panel panel--pad">
          <p class="label">When email is the better route</p>
          <ul class="ticket-alt">
            <li>You no longer have access to the server.</li>
            <li>The request is about data, privacy or deletion.</li>
            <li>It concerns a moderation decision you want reviewed.</li>
            <li>It is a security report.</li>
          </ul>
          <p class="ticket-note">
            Ticket conversations are visible to staff and are retained as described in the
            <a class="text-link" href="/policies/bot/data-retention">Data Retention Policy</a>.
            Email is read by one person.
          </p>
          <div class="doc-actions" style="margin-top: 1rem;">
            <a class="btn" href={`mailto:${SITE.contactEmail}`}>Email the studio</a>
            <a class="text-link doc-action-link" href="/commands">Ticket commands →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="notice notice--neutral">
        <p class="notice-body">
          This website itself collects nothing — no accounts, no forms, no cookies, no
          analytics. See the <a class="text-link" href="/website-privacy">website privacy notice</a>
          for the details, including what the hosting layer may log.
        </p>
      </div>
    </div>
  </section>
</Base>
