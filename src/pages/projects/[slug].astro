---
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import { getCollection, render } from 'astro:content';
import { BOT_MODULES, MODULE_STATUS_LABEL, modulesByGroup, moduleCommandCount } from '../../lib/modules';
import { countPlacesDocs, getPlacesDocs } from '../../lib/placesDocs';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, tagline, status, category, summary, gallery } = entry.data;

const isBot = entry.id === 'next-step-bot';
const isPlaces = entry.id === 'places-left-behind';
const placesCounts = isPlaces ? countPlacesDocs(await getPlacesDocs()) : null;
const metaDescription = summary.length > 170 ? `${summary.slice(0, 155).trimEnd()}…` : summary;
const groups = modulesByGroup();

const projectSchema = {
  '@type': 'CreativeWork',
  name: title,
  description: summary,
  genre: category,
  creativeWorkStatus: status,
  ...(entry.data.updated ? { dateModified: entry.data.updated.toISOString() } : {}),
  creator: { '@id': `${(Astro.site ?? new URL('https://next-step-studios-official.github.io')).origin}#organization` },
};

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(date);
---

<Base
  title={title}
  description={metaDescription}
  path={`/projects/${entry.id}`}
  schema={projectSchema}
  ogImage={`og/project-${entry.id}.png`}
  ogAlt={`${title} — Next Step Studios`}
>
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack">
        <Breadcrumbs
          items={[
            { label: 'Home', href: '/' },
            { label: 'Projects', href: '/projects' },
            { label: title },
          ]}
        />
        <h1 class="display display--page">{title}</h1>
        <p class="lede">{tagline}</p>
        <div class="meta-bar" style="border-bottom: 0; padding-bottom: 0;">
          <span style="display: inline-flex; align-items: center; gap: 0.6rem;">
            Status <StatusBadge status={status} />
          </span>
          <span>Category · {category}</span>
          <span>{isBot ? 'Operated by the studio, for one server' : 'Made by the studio'}</span>
          {isBot && <span>{BOT_MODULES.length} modules · {moduleCommandCount()} commands listed</span>}
          {entry.data.updated && <span>Status reviewed {formatDate(entry.data.updated)}</span>}
        </div>
      </div>
    </div>
  </section>

  {gallery.length > 0 ? (
    <div class="container project-gallery-top">
      <ProjectGallery images={gallery} />
    </div>
  ) : (
    entry.data.cover && (
      <div class="container">
        <img
          class="project-hero-cover"
          src={entry.data.cover}
          alt=""
          width={1100}
          height={594}
          loading="eager"
        />
      </div>
    )
  )}

  {
    isPlaces && (
      <section class="section section--flush">
        <div class="container">
          <div class="panel panel--pad project-docs-callout">
            <div>
              <p class="label">Documentation · {placesCounts?.total} documents</p>
              <h2>Licensing, policies and engineering notes</h2>
              <p>
                The game's own documents, reproduced from its repository with their source
                versions and statuses: {placesCounts?.current} current, {placesCounts?.draft}
                draft or future draft, and {placesCounts?.reference} engineering references.
                None of the custom agreements has been reviewed by a lawyer.
              </p>
            </div>
            <a class="btn btn-primary" href="/docs/places-left-behind">
              View all documentation <span class="btn-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>

  {
    isBot && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow">Module register</p>
              <h2 class="section-title" style="margin-top: 0.75rem;">Every module in the source</h2>
              <p class="section-sub">
                Read from the bot's cogs. “In source” means the module and its commands
                exist in the code — not that the feature has been verified on the server.
                Where the project page still calls an area planned, that is what it says here.
              </p>
            </div>
            <a class="read-time text-link" href="/modules">{BOT_MODULES.length} modules →</a>
          </div>

          {groups.map(({ group, modules }) => (
            <div class="module-group">
              <div class="module-group-head">
                <h3>{group}</h3>
                <span class="label">
                  {modules.length} {modules.length === 1 ? 'module' : 'modules'}
                </span>
              </div>
              <div class="module-grid">
                {modules.map((module) => (
                  <article class="panel module">
                    <span class={`module-status module-status--${module.status}`}>
                      {MODULE_STATUS_LABEL[module.status]}
                    </span>
                    <h4>{module.name}</h4>
                    <p>{module.summary}</p>
                    {module.commands && (
                      <div class="module-commands">
                        {module.commands.map((command) => (
                          <code class="cmd">{command}</code>
                        ))}
                      </div>
                    )}
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <div class="panel panel--pad project-next">
        <p class="label">Where this goes</p>
        <p>
          The status is not a countdown. The <a class="text-link" href="/roadmap">roadmap</a>
          explains what each status means, and the <a class="text-link" href="/devlog">devlog</a>
          records what changed. If something is unclear,
          <a class="text-link" href="/contact">contact the studio</a>.
        </p>
      </div>
    </div>
  </section>

  <style>
    .project-gallery-top {
      margin-bottom: clamp(1.75rem, 4vw, 3rem);
    }

    .project-docs-callout {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem 2rem;
      border-color: rgba(143, 182, 255, 0.24);
      background:
        linear-gradient(110deg, rgba(77, 141, 255, 0.06), rgba(167, 139, 250, 0.035)),
        var(--color-surface);
    }

    .project-docs-callout > div {
      max-width: 62ch;
    }

    .project-docs-callout h2 {
      margin-top: 0.55rem;
      font-size: clamp(1.25rem, 2.6vw, 1.6rem);
      letter-spacing: -0.025em;
    }

    .project-docs-callout p:last-child {
      margin-top: 0.55rem;
      color: var(--color-muted);
      font-size: 0.9375rem;
      line-height: 1.65;
    }

    .project-next p:last-child {
      margin: 0.65rem 0 0;
      max-width: 72ch;
      color: var(--color-muted);
      font-size: 0.9375rem;
      line-height: 1.65;
    }
  </style>
</Base>
