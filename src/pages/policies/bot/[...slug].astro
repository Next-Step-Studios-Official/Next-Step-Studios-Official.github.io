---
import Base from '../../../layouts/Base.astro';
import DraftNotice from '../../../components/DraftNotice.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../../lib/site';
import { githubUrlForSlug } from '../../../lib/documents';
import { readingLabel } from '../../../lib/reading';

export async function getStaticPaths() {
  const policies = await getCollection('policies');
  return policies.map((entry) => ({
    params: { slug: entry.id.replace(/^bot\//, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const all = (await getCollection('policies')).sort((a, b) => a.data.order - b.data.order);
const index = all.findIndex((policy) => policy.id === entry.id);
const previous = index > 0 ? all[index - 1] : undefined;
const next = index < all.length - 1 ? all[index + 1] : undefined;

const slugOf = (id: string) => id.replace(/^bot\//, '');
const toc = headings.filter((heading) => heading.depth === 2);
---

<Base title={entry.data.shortTitle} description={entry.data.summary} path="/policies">
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack" style="max-width: 62rem;">
        <p class="eyebrow">
          <a href="/policies" class="text-link">Policies</a> · Discord bot · v{entry.data.version}
        </p>
        <h1 class="display display--page">{entry.data.title}</h1>
        <div class="meta-bar">
          <span>Version {entry.data.version}</span>
          <span>{entry.data.docStatus}</span>
          <span>Applies to · Discord bot</span>
          <span>{readingLabel(entry.body)}</span>
        </div>
        <DraftNotice docStatus={entry.data.docStatus} version={entry.data.version} />
        <div class="doc-actions">
          <a class="btn btn-primary" href={`/downloads/${slugOf(entry.id)}.pdf`} download={`${slugOf(entry.id)}.pdf`}>
            Download PDF
            <span class="btn-arrow" aria-hidden="true">↓</span>
          </a>
          <a class="btn" href={`/downloads/${slugOf(entry.id)}.md`} download={`${slugOf(entry.id)}.md`}>
            Markdown
          </a>
          <a class="btn" href={`/downloads/${slugOf(entry.id)}.txt`} download={`${slugOf(entry.id)}.txt`}>
            Plain text
          </a>
          <a class="text-link doc-action-link" href={`/downloads/print/${slugOf(entry.id)}`}>
            Print edition →
          </a>
          <a class="text-link doc-action-link" href="/downloads" style="font-size: 0.8125rem;">
            All files →
          </a>
          <a
            class="text-link doc-action-link"
            href={githubUrlForSlug(slugOf(entry.id))}
            rel="noopener"
            style="font-size: 0.8125rem;"
          >
            View on GitHub ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="doc-layout">
      <article class="prose">
        <Content />
      </article>

      <aside aria-label="On this page">
        <nav class="toc">
          <p class="label">On this page</p>
          <ol>
            {toc.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </nav>
      </aside>
    </div>

    <nav
      aria-label="Policy navigation"
      style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding-block: 1.5rem; border-top: 1px solid var(--color-line-soft);"
    >
      <span>
        {previous && (
          <a class="text-link" href={`/policies/bot/${slugOf(previous.id)}`} style="font-size: 0.875rem;">
            ← {previous.data.shortTitle}
          </a>
        )}
      </span>
      <span>
        {next && (
          <a class="text-link" href={`/policies/bot/${slugOf(next.id)}`} style="font-size: 0.875rem;">
            {next.data.shortTitle} →
          </a>
        )}
      </span>
    </nav>

    <div class="notice notice--neutral" role="note" style="margin-bottom: 3rem;">
      <p class="notice-body">
        This document covers the Next Step Studios Discord bot only. Questions or requests
        concerning it go to <a class="text-link" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.
        See also the <a class="text-link" href="/website-privacy">website privacy notice</a>.
      </p>
    </div>
  </div>

  <script>
    const toc = document.querySelector<HTMLElement>('.toc');

    if (toc) {
      const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
      // Heading ids can begin with a digit ("1-introduction"), which is not a
      // valid CSS selector, so ids are resolved directly rather than queried.
      const targets = links
        .map((link) => {
          const href = link.getAttribute('href') ?? '';
          return href.length > 1 ? document.getElementById(href.slice(1)) : null;
        })
        .filter((target): target is HTMLElement => Boolean(target));

      // The heading that has passed the reading line is the current section.
      // A scroll calculation is used rather than an IntersectionObserver so the
      // state is always correct, including after anchor jumps.
      const activate = () => {
        if (targets.length === 0) return;
        let current = targets[0].id;

        for (const target of targets) {
          if (target.getBoundingClientRect().top <= 180) current = target.id;
        }

        links.forEach((link) => {
          link.classList.toggle('is-active', link.getAttribute('href') === `#${current}`);
        });
      };

      activate();
      window.addEventListener('scroll', activate, { passive: true });
      window.addEventListener('resize', activate);
    }
  </script>
</Base>
