---
import Base from '../../../layouts/Base.astro';
import DraftNotice from '../../../components/DraftNotice.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../../lib/site';
import { githubUrlForSlug } from '../../../lib/documents';
import { readingLabel } from '../../../lib/reading';
import { snapshotsFor } from '../../../lib/policyVersions';

export async function getStaticPaths() {
  const policies = await getCollection('policies');
  return policies.map((entry) => ({
    params: { slug: entry.id.replace(/^bot\//, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const all = (await getCollection('policies')).sort((a, b) => a.data.order - b.data.order);
const index = all.findIndex((policy) => policy.id === entry.id);
const previous = index > 0 ? all[index - 1] : undefined;
const next = index < all.length - 1 ? all[index + 1] : undefined;

const slugOf = (id: string) => id.replace(/^bot\//, '');
const toc = headings.filter((heading) => heading.depth === 2);
const versions = snapshotsFor(slugOf(entry.id));

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).format(date);

const articleSchema = {
  '@type': 'Article',
  '@id': `${new URL(`/policies/bot/${slugOf(entry.id)}`, Astro.site ?? SITE.url).toString()}#article`,
  headline: entry.data.title,
  description: entry.data.summary,
  dateModified: entry.data.updated.toISOString(),
  version: entry.data.version,
  inLanguage: 'en-GB',
  isPartOf: { '@id': `${(Astro.site ?? SITE.url).origin}#website` },
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@id': `${(Astro.site ?? SITE.url).origin}#organization` },
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site ?? SITE.url).toString() },
    { '@type': 'ListItem', position: 2, name: 'Policies', item: new URL('/policies', Astro.site ?? SITE.url).toString() },
    { '@type': 'ListItem', position: 3, name: entry.data.shortTitle, item: new URL(`/policies/bot/${slugOf(entry.id)}`, Astro.site ?? SITE.url).toString() },
  ],
};
---

<Base
  title={entry.data.shortTitle}
  description={entry.data.summary}
  path="/policies"
  schema={[articleSchema, breadcrumbSchema]}
  ogImage={`og/policy-${slugOf(entry.id)}.png`}
  ogAlt={`${entry.data.shortTitle} — Next Step Studios`}
>
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack" style="max-width: 62rem;">
        <p class="eyebrow">
          <a href="/policies" class="text-link">Policies</a> · Discord bot · v{entry.data.version}
        </p>
        <h1 class="display display--page">{entry.data.title}</h1>
        <div class="meta-bar">
          <span>Version {entry.data.version}</span>
          <span>{entry.data.docStatus}</span>
          <span>Applies to · Discord bot</span>
          <span>{readingLabel(entry.body)}</span>
          <span>Updated {formatDate(entry.data.updated)}</span>
        </div>
        <DraftNotice docStatus={entry.data.docStatus} version={entry.data.version} />
        <div class="plain-summary panel panel--pad" id="plain-language">
          <div class="plain-summary-head">
            <p class="label">In plain language</p>
            <span>Summary · not the document</span>
          </div>
          <p>{entry.data.plainSummary}</p>
        </div>
        <div class="reading-controls" data-reading-controls aria-label="Reading options">
          <span class="label">Reading</span>
          <div class="reading-group" role="group" aria-label="Text size">
            <button type="button" data-reading-size="sm" aria-pressed="false">A−</button>
            <button type="button" data-reading-size="md" aria-pressed="true">A</button>
            <button type="button" data-reading-size="lg" aria-pressed="false">A+</button>
          </div>
          <div class="reading-group" role="group" aria-label="Line width">
            <button type="button" data-reading-width="normal" aria-pressed="true">Normal width</button>
            <button type="button" data-reading-width="wide" aria-pressed="false">Wide</button>
          </div>
        </div>

        <div class="doc-actions">
          <a class="btn btn-primary" href={`/downloads/${slugOf(entry.id)}.pdf`} download={`${slugOf(entry.id)}.pdf`} data-astro-prefetch="false">
            Download PDF
            <span class="btn-arrow" aria-hidden="true">↓</span>
          </a>
          <a class="btn" href={`/downloads/${slugOf(entry.id)}.md`} download={`${slugOf(entry.id)}.md`} data-astro-prefetch="false">
            Markdown
          </a>
          <a class="btn" href={`/downloads/${slugOf(entry.id)}.txt`} download={`${slugOf(entry.id)}.txt`} data-astro-prefetch="false">
            Plain text
          </a>
          <a class="text-link doc-action-link" href={`/downloads/print/${slugOf(entry.id)}`}>
            Print edition →
          </a>
          <a class="text-link doc-action-link" href={`/policies/versions/${slugOf(entry.id)}`} style="font-size: 0.8125rem;">
            Version history ({versions.length}) →
          </a>
          <a class="text-link doc-action-link" href="/downloads" style="font-size: 0.8125rem;">
            All files →
          </a>
          <a
            class="text-link doc-action-link"
            href={githubUrlForSlug(slugOf(entry.id))}
            rel="noopener"
            style="font-size: 0.8125rem;"
          >
            View on GitHub ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="doc-layout">
      <aside class="doc-aside">
        <details class="toc" data-toc>
          <summary class="toc-summary">
            <span class="label">On this page</span>
            <span class="toc-caret" aria-hidden="true">▾</span>
          </summary>
          <ol>
            {toc.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </details>
      </aside>

      <article class="prose" data-policy-prose>
        <Content />
      </article>
    </div>

    <nav
      aria-label="Policy navigation"
      style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding-block: 1.5rem; border-top: 1px solid var(--color-line-soft);"
    >
      <span>
        {previous && (
          <a class="text-link" href={`/policies/bot/${slugOf(previous.id)}`} style="font-size: 0.875rem;">
            ← {previous.data.shortTitle}
          </a>
        )}
      </span>
      <span>
        {next && (
          <a class="text-link" href={`/policies/bot/${slugOf(next.id)}`} style="font-size: 0.875rem;">
            {next.data.shortTitle} →
          </a>
        )}
      </span>
      <span>
        <a class="text-link" href="#main" style="font-size: 0.875rem;">Back to top ↑</a>
      </span>
    </nav>

    <div class="notice notice--neutral" role="note" style="margin-bottom: 3rem;">
      <p class="notice-body">
        This document covers the Next Step Studios Discord bot only. Questions or requests
        concerning it go to <a class="text-link" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.
        See also the <a class="text-link" href="/website-privacy">website privacy notice</a>.
      </p>
    </div>
  </div>

  <style>
    .plain-summary {
      margin-top: 1rem;
      border-left: 2px solid var(--color-accent);
    }

    .plain-summary-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.5rem 1rem;
      margin-bottom: 0.7rem;
    }

    .plain-summary-head > span {
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: 0.625rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .plain-summary > p {
      margin: 0;
      max-width: 76ch;
      color: var(--color-ink-dim);
      font-size: 0.9375rem;
      line-height: 1.7;
    }
  </style>

  <script>
    // Reading controls: three text sizes and two measures, remembered locally.
    // Preferences live in localStorage only, never on a server.
    const controls = document.querySelector<HTMLElement>('[data-reading-controls]');
    if (controls) {
      const root = document.documentElement;
      const storedSize = localStorage.getItem('nss-reading-size') ?? 'md';
      const storedWidth = localStorage.getItem('nss-reading-width') ?? 'normal';

      const apply = (size: string, width: string) => {
        root.dataset.readingSize = size;
        root.dataset.readingWidth = width;
        controls.querySelectorAll<HTMLButtonElement>('[data-reading-size]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.readingSize === size));
        });
        controls.querySelectorAll<HTMLButtonElement>('[data-reading-width]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.readingWidth === width));
        });
      };

      apply(storedSize, storedWidth);

      controls.querySelectorAll<HTMLButtonElement>('[data-reading-size]').forEach((button) => {
        button.addEventListener('click', () => {
          const size = button.dataset.readingSize ?? 'md';
          localStorage.setItem('nss-reading-size', size);
          apply(size, root.dataset.readingWidth ?? 'normal');
        });
      });

      controls.querySelectorAll<HTMLButtonElement>('[data-reading-width]').forEach((button) => {
        button.addEventListener('click', () => {
          const width = button.dataset.readingWidth ?? 'normal';
          localStorage.setItem('nss-reading-width', width);
          apply(root.dataset.readingSize ?? 'md', width);
        });
      });
    }

    const toc = document.querySelector<HTMLElement>('.toc');

    if (toc) {
      const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
      // Heading ids can begin with a digit ("1-introduction"), which is not a
      // valid CSS selector, so ids are resolved directly rather than queried.
      const targets = links
        .map((link) => {
          const href = link.getAttribute('href') ?? '';
          return href.length > 1 ? document.getElementById(href.slice(1)) : null;
        })
        .filter((target): target is HTMLElement => Boolean(target));

      // The heading that has passed the reading line is the current section.
      // A scroll calculation is used rather than an IntersectionObserver so the
      // state is always correct, including after anchor jumps.
      const activate = () => {
        if (targets.length === 0) return;
        let current = targets[0].id;

        for (const target of targets) {
          if (target.getBoundingClientRect().top <= 180) current = target.id;
        }

        links.forEach((link) => {
          const active = link.getAttribute('href') === `#${current}`;
          link.classList.toggle('is-active', active);
          if (active) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      };

      // Choosing a section on a phone should reveal the text, not leave the
      // expanded contents covering it.
      links.forEach((link) =>
        link.addEventListener('click', () => {
          if (window.matchMedia('(max-width: 900px)').matches) {
            toc.removeAttribute('open');
          }
        }),
      );

      activate();
      window.addEventListener('scroll', activate, { passive: true });
      window.addEventListener('resize', activate);
    }
  </script>
</Base>
