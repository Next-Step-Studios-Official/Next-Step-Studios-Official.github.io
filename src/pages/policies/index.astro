---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import {
  POLICY_SCOPES,
  POLICY_SCOPE_DESCRIPTIONS,
  POLICY_SCOPE_LABELS,
  downloadKey,
  githubUrlForPolicy,
  isDraftDocument,
  policyPath,
  scopeOf,
} from '../../lib/documents';
import { readingLabel } from '../../lib/reading';
import { numberWord } from '../../lib/words';

const scopeRank = { bot: 0, website: 1 } as const;
const policies = (await getCollection('policies')).sort(
  (a, b) => scopeRank[scopeOf(a.id)] - scopeRank[scopeOf(b.id)] || a.data.order - b.data.order,
);

const draftCount = policies.filter((policy) => isDraftDocument(policy.data.docStatus)).length;
const currentCount = policies.length - draftCount;
const countWord = numberWord(policies.length);
const CountWord = countWord.charAt(0).toUpperCase() + countWord.slice(1);

const scopes = POLICY_SCOPES.map((scope) => {
  const items = policies.filter((policy) => scopeOf(policy.id) === scope);
  return {
    scope,
    label: POLICY_SCOPE_LABELS[scope],
    description: POLICY_SCOPE_DESCRIPTIONS[scope],
    items,
    current: items.filter((policy) => !isDraftDocument(policy.data.docStatus)).length,
  };
});
---

<Base
  title="Policies"
  description="The public policy documents for Next Step Studios, in two separate sets: the Discord bot and this website."
  path="/policies"
  ogImage="og/policies.png"
>
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack">
        <p class="eyebrow">Policies</p>
        <h1 class="display display--page">The rules, for each thing they cover.</h1>
        <p class="lede">
          {CountWord} public documents in two separate sets: {scopes[0].items.length} for the
          Discord bot and {scopes[1].items.length} for this website. Each says what it applies
          to, what version it is, and whether it is current or still a draft.
        </p>
        <div class="meta-bar">
          <span>{policies.length} documents</span>
          <span>{scopes.length} separate scopes</span>
          <span>{currentCount} current · {draftCount} draft</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--flush">
    <div class="container">
      <h2 class="sr-only">Policy scopes</h2>

      <div class="split" style="margin-bottom: 2rem;">
        {
          scopes.map(({ scope, label, description, items, current }) => (
            <div class="panel panel--pad" id={scope} style="scroll-margin-top: 6rem;">
              <p class="label">{label} · {items.length} documents</p>
              <p style="color: var(--color-muted); font-size: 0.9375rem; margin-top: 0.6rem;">
                {description}
              </p>
              <p class="read-time" style="margin-top: 0.85rem;">
                {current === items.length
                  ? 'All current'
                  : current === 0
                    ? 'All drafts for review'
                    : `${current} current · ${items.length - current} draft`}
              </p>
              <a
                class="text-link"
                href={`/policies?scope=${scope}#documents`}
                data-scope-jump={scope}
                style="display: inline-block; margin-top: 0.75rem; font-size: 0.875rem;"
              >
                Filter to {label} →
              </a>
            </div>
          ))
        }
      </div>

      <div class="notice" role="note">
        <span class="status status--draft">{draftCount} drafts</span>
        <p class="notice-body">
          {draftCount} of {policies.length} documents are marked <strong>draft for review</strong>
          and <strong>not yet effective</strong>. They are published so they have stable addresses
          and can be read without the bot being online. {currentCount} describe the published site
          and are marked <strong>current</strong>. Nothing here claims legal compliance.
        </p>
      </div>

      <div class="toolbar" id="documents" style="margin-top: 1.5rem; scroll-margin-top: 6rem;" data-docs-toolbar>
        <div class="toolbar-row">
          <label class="search-field">
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="6.8" cy="6.8" r="4.4" stroke="currentColor" stroke-width="1.3" />
              <path d="M10.2 10.2 14 14" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
            </svg>
            <input
              type="search"
              data-doc-search
              placeholder={`Search the ${countWord} documents…`}
              aria-label="Search documents by title or summary"
              autocomplete="off"
            />
          </label>
          <span class="read-time" data-doc-count aria-live="polite">{policies.length} documents</span>
        </div>

        <div class="toolbar-row">
          <div class="chip-group" role="group" aria-label="Filter by scope" data-scope-chips>
            <button type="button" class="chip" aria-pressed="true" data-scope="all">
              All scopes <span class="chip-count">{policies.length}</span>
            </button>
            {
              scopes.map(({ scope, label, items }) => (
                <button type="button" class="chip" aria-pressed="false" data-scope={scope}>
                  {label} <span class="chip-count">{items.length}</span>
                </button>
              ))
            }
          </div>
        </div>

        <div class="toolbar-row">
          <div class="chip-group" role="group" aria-label="Filter by status" data-status-chips>
            <button type="button" class="chip" aria-pressed="true" data-doc-status="all">
              All statuses <span class="chip-count">{policies.length}</span>
            </button>
            <button type="button" class="chip" aria-pressed="false" data-doc-status="current">
              Current <span class="chip-count">{currentCount}</span>
            </button>
            <button type="button" class="chip" aria-pressed="false" data-doc-status="draft">
              Draft <span class="chip-count">{draftCount}</span>
            </button>
          </div>
          <button type="button" class="toolbar-reset" data-doc-reset hidden>Clear filters</button>
        </div>

        <p class="doc-filter-note">
          The search, scope and status are kept in the address, so a filtered list can be
          linked or reloaded.
        </p>
      </div>

      <div class="doc-grid" data-doc-grid style="margin-top: 1.25rem;">
        {
          policies.map((policy) => {
            const scope = scopeOf(policy.id);
            const label = POLICY_SCOPE_LABELS[scope];
            const draft = isDraftDocument(policy.data.docStatus);
            const key = downloadKey(policy.id);
            return (
              <article
                class="panel doc-card"
                data-doc
                data-scope={scope}
                data-status={draft ? 'draft' : 'current'}
                data-search={`${policy.data.title} ${policy.data.shortTitle} ${policy.data.summary} ${policy.data.plainSummary} ${label}`.toLowerCase()}
              >
                <span class={draft ? 'status status--draft' : 'status status--ready'} style="align-self: flex-start;">
                  v{policy.data.version} · {draft ? 'draft' : 'current'}
                </span>
                <h3>
                  <a href={policyPath(policy.id)}>{policy.data.shortTitle}</a>
                </h3>
                <p>{policy.data.summary}</p>
                <div class="doc-card-meta">
                  <span>{readingLabel(policy.body)}</span>
                  <span>Applies to · {label}</span>
                </div>
                <div class="doc-card-actions">
                  <a class="text-link" href={policyPath(policy.id)} aria-label={`Read ${policy.data.shortTitle}`}>Read →</a>
                  <a class="text-link" href={`${policyPath(policy.id)}#plain-language`} aria-label={`Plain-language summary of ${policy.data.shortTitle}`}>Plain summary</a>
                  <a class="text-link" href={`/downloads/${key}.md`} download={`${key}.md`} data-astro-prefetch="false" aria-label={`Download ${policy.data.shortTitle} as Markdown`}>
                    Download .md
                  </a>
                  <a class="text-link" href={`/downloads/${key}.pdf`} download={`${key}.pdf`} data-astro-prefetch="false" aria-label={`Download ${policy.data.shortTitle} as PDF`}>
                    PDF
                  </a>
                  {githubUrlForPolicy(policy.id) && (
                    <a class="text-link" href={githubUrlForPolicy(policy.id) ?? undefined} rel="noopener" aria-label={`${policy.data.shortTitle} on GitHub`}>
                      GitHub ↗
                    </a>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>

      <p class="empty-state" data-doc-empty>
        No document matches those filters. Try a shorter word, another scope or status, or
        clear the filters.
      </p>

      <p style="color: var(--color-muted); font-size: 0.875rem; margin-top: 1.25rem;">
        Every document can also be downloaded as Markdown, plain text, PDF or a print page, with
        no form or email address required. <a class="text-link" href="/downloads">All downloads →</a>
      </p>

      <div class="split" style="margin-top: 2rem;">
        <div class="panel panel--pad" id="future" style="scroll-margin-top: 6rem;">
          <p class="label">Future products</p>
          <p style="color: var(--color-muted); font-size: 0.9375rem; margin-top: 0.6rem;">
            Games, apps and anything else the studio releases will get their own document set
            before release. No placeholder policy is published for a product that does not exist,
            and nothing here claims to cover one.
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 0.85rem;">
            <a class="text-link" href="/projects" style="font-size: 0.875rem;">Projects →</a>
            <a class="text-link" href="/roadmap" style="font-size: 0.875rem;">Roadmap →</a>
          </div>
        </div>
        <div class="panel panel--pad">
          <p class="label">Privacy requests</p>
          <p style="color: var(--color-muted); font-size: 0.9375rem; margin-top: 0.6rem;">
            There is no automated request system. Requests for access, correction or deletion
            are sent by email and handled by the studio operator.
          </p>
          <a class="text-link" href="/contact#privacy-requests" style="display: inline-block; margin-top: 0.85rem; font-size: 0.875rem;">
            How to submit a request →
          </a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .doc-filter-note {
      margin: 0.75rem 0 0;
      color: var(--color-muted);
      font-size: 0.8125rem;
    }
    .toolbar-reset[hidden] { display: none; }
  </style>

  <script>
    const toolbar = document.querySelector<HTMLElement>('[data-docs-toolbar]');
    const grid = document.querySelector<HTMLElement>('[data-doc-grid]');
    const emptyEl = document.querySelector<HTMLElement>('[data-doc-empty]');

    if (toolbar && grid) {
      const search = toolbar.querySelector<HTMLInputElement>('[data-doc-search]');
      const countEl = toolbar.querySelector<HTMLElement>('[data-doc-count]');
      const scopeChips = Array.from(toolbar.querySelectorAll<HTMLButtonElement>('[data-scope-chips] .chip'));
      const statusChips = Array.from(toolbar.querySelectorAll<HTMLButtonElement>('[data-status-chips] .chip'));
      const reset = toolbar.querySelector<HTMLButtonElement>('[data-doc-reset]');
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-doc]'));

      const validScope = (value: string | null) =>
        value && scopeChips.some((chip) => chip.dataset.scope === value) ? value : 'all';
      const validStatus = (value: string | null) =>
        value && statusChips.some((chip) => chip.dataset.docStatus === value) ? value : 'all';

      let scope = 'all';
      let status = 'all';

      const paintScope = () => {
        scopeChips.forEach((chip) => {
          chip.setAttribute('aria-pressed', String(chip.dataset.scope === scope));
        });
      };

      const paintStatus = () => {
        statusChips.forEach((chip) => {
          chip.setAttribute('aria-pressed', String(chip.dataset.docStatus === status));
        });
      };

      const readUrl = () => {
        const params = new URLSearchParams(window.location.search);
        scope = validScope(params.get('scope'));
        status = validStatus(params.get('status'));
        if (search) search.value = params.get('q') ?? '';
        paintScope();
        paintStatus();
      };

      const syncUrl = () => {
        const url = new URL(window.location.href);
        if (scope === 'all') url.searchParams.delete('scope');
        else url.searchParams.set('scope', scope);
        if (status === 'all') url.searchParams.delete('status');
        else url.searchParams.set('status', status);
        const query = (search?.value ?? '').trim();
        if (query) url.searchParams.set('q', query);
        else url.searchParams.delete('q');
        window.history.replaceState({}, '', url);
      };

      const apply = () => {
        const query = (search?.value ?? '').trim().toLowerCase();
        let visible = 0;

        cards.forEach((card) => {
          const matchesQuery = !query || (card.dataset.search ?? '').includes(query);
          const matchesScope = scope === 'all' || card.dataset.scope === scope;
          const matchesStatus = status === 'all' || card.dataset.status === status;
          const matches = matchesQuery && matchesScope && matchesStatus;
          card.classList.toggle('is-hidden', !matches);
          if (matches) visible += 1;
        });

        if (countEl) {
          countEl.textContent =
            visible === cards.length
              ? `${cards.length} documents`
              : `${visible} of ${cards.length} documents`;
        }

        emptyEl?.classList.toggle('is-visible', visible === 0);
        if (reset) {
          reset.hidden = !(scope !== 'all' || status !== 'all' || Boolean(query));
        }
      };

      const setScope = (value: string, updateUrl = true) => {
        scope = value;
        paintScope();
        apply();
        if (updateUrl) syncUrl();
      };

      const setStatus = (value: string, updateUrl = true) => {
        status = value;
        paintStatus();
        apply();
        if (updateUrl) syncUrl();
      };

      scopeChips.forEach((chip) => {
        chip.addEventListener('click', () => setScope(chip.dataset.scope ?? 'all'));
      });

      statusChips.forEach((chip) => {
        chip.addEventListener('click', () => setStatus(chip.dataset.docStatus ?? 'all'));
      });

      document.querySelectorAll<HTMLElement>('[data-scope-jump]').forEach((link) => {
        link.addEventListener('click', (event) => {
          event.preventDefault();
          setScope(link.dataset.scopeJump ?? 'all');
          document.getElementById('documents')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      reset?.addEventListener('click', () => {
        scope = 'all';
        status = 'all';
        if (search) search.value = '';
        paintScope();
        paintStatus();
        apply();
        syncUrl();
      });

      window.addEventListener('popstate', () => {
        readUrl();
        apply();
      });

      search?.addEventListener('input', () => {
        apply();
        syncUrl();
      });

      readUrl();
      apply();
      syncUrl();
    }
  </script>
</Base>
