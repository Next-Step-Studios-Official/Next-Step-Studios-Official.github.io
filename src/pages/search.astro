---
import Base from '../layouts/Base.astro';

const indexUrl = `${import.meta.env.BASE_URL}search-index.json`;
---

<Base
  title="Search"
  description="Search every policy, devlog entry, command, FAQ answer and page on the Next Step Studios site. The index is a file; nothing is sent anywhere."
  path="/search"
  ogImage="og/search.png"
>
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack">
        <p class="eyebrow">Search</p>
        <h1 class="display display--page">Search the whole site.</h1>
        <p class="lede">
          Every policy, devlog entry, command, FAQ answer, roadmap item and page — read from one
          generated file. The query stays in this browser; there is nothing on the other end to
          receive it.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--flush">
    <div class="container" data-search-root data-index-url={indexUrl}>
      <noscript>
        <div class="notice notice--neutral" role="note" style="margin-bottom: 1.25rem;">
          <span class="status status--info">JavaScript off</span>
          <p class="notice-body">
            Search reads its index in the browser, so it needs JavaScript. The
            <a class="text-link" href="/policies">policy index</a>,
            <a class="text-link" href="/commands">command reference</a> and
            <a class="text-link" href="/sitemap">sitemap</a> can be browsed without it.
          </p>
        </div>
      </noscript>

      <div class="search-bar">
        <label class="search-field search-field--lg">
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="6.8" cy="6.8" r="4.4" stroke="currentColor" stroke-width="1.3" />
            <path d="M10.2 10.2 14 14" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
          </svg>
          <input
            type="search"
            data-search-input
            placeholder="Search the site…"
            aria-label="Search the site"
            autocomplete="off"
            enterkeyhint="search"
            spellcheck="false"
          />
        </label>
        <span class="read-time" data-search-status aria-live="polite">Type to search</span>
      </div>

      <div class="search-suggestions" data-search-suggestions role="group" aria-label="Spelling suggestion" hidden>
        <span class="label">Did you mean</span>
        <div class="search-suggestion-list" data-search-suggestion-list></div>
      </div>

      <div class="search-filter-row">
        <div class="chip-group search-types" role="group" aria-label="Filter by type" data-search-types>
          <button type="button" class="chip" data-type="all" aria-pressed="true">
            Everything <span class="chip-count" data-type-count></span>
          </button>
          <button type="button" class="chip" data-type="Policy" aria-pressed="false">
            Policies <span class="chip-count" data-type-count></span>
          </button>
          <button type="button" class="chip" data-type="Command" aria-pressed="false">
            Commands <span class="chip-count" data-type-count></span>
          </button>
          <button type="button" class="chip" data-type="Module" aria-pressed="false">
            Modules <span class="chip-count" data-type-count></span>
          </button>
          <button type="button" class="chip" data-type="Project" aria-pressed="false">
            Projects <span class="chip-count" data-type-count></span>
          </button>
          <button type="button" class="chip" data-type="Roadmap" aria-pressed="false">
            Roadmap <span class="chip-count" data-type-count></span>
          </button>
          <button type="button" class="chip" data-type="Devlog" aria-pressed="false">
            Devlog <span class="chip-count" data-type-count></span>
          </button>
          <button type="button" class="chip" data-type="FAQ" aria-pressed="false">
            FAQ <span class="chip-count" data-type-count></span>
          </button>
          <button type="button" class="chip" data-type="Glossary" aria-pressed="false">
            Glossary <span class="chip-count" data-type-count></span>
          </button>
          <button type="button" class="chip" data-type="Page" aria-pressed="false">
            Pages <span class="chip-count" data-type-count></span>
          </button>
        </div>
        <button type="button" class="toolbar-reset" data-search-reset hidden>Clear search</button>
      </div>

      <ol class="search-results" data-search-results></ol>

      <div class="search-empty" data-search-empty>
        <p class="search-empty-title">Nothing matched.</p>
        <p class="search-empty-body">
          Try a shorter word, or one that would appear in the text rather than in a title.
          The <a class="text-link" href="/commands">command reference</a> and the
          <a class="text-link" href="/policies">policy index</a> are also browsable directly.
        </p>
      </div>

      <p class="search-note">
        Use <kbd>↑</kbd> and <kbd>↓</kbd> to move through results and <kbd>Enter</kbd> to open
        one. Type counts show matches for the current query; the selected type only narrows
        the list. The index includes full policy text and is generated at build time. It is
        loaded once, when you focus the field or start typing, and then held in memory for this
        page only. The query and type filter stay in the address, so a search can be linked.
      </p>
    </div>
  </section>

  <script>
    const root = document.querySelector<HTMLElement>('[data-search-root]');

    if (root) {
      const input = root.querySelector<HTMLInputElement>('[data-search-input]');
      const resultsEl = root.querySelector<HTMLElement>('[data-search-results]');
      const statusEl = root.querySelector<HTMLElement>('[data-search-status]');
      const emptyEl = root.querySelector<HTMLElement>('[data-search-empty]');
      const suggestionsEl = root.querySelector<HTMLElement>('[data-search-suggestions]');
      const suggestionList = root.querySelector<HTMLElement>('[data-search-suggestion-list]');
      const typeChips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-search-types] .chip'));
      const reset = root.querySelector<HTMLButtonElement>('[data-search-reset]');
      const indexUrl = root.dataset.indexUrl ?? '/search-index.json';

      type Entry = { type: string; title: string; url: string; section?: string; text: string };

      let entries: Entry[] | null = null;
      let loading = false;
      const validType = (value: string | null) =>
        value && typeChips.some((chip) => chip.dataset.type === value) ? value : 'all';
      let activeType = validType(new URLSearchParams(window.location.search).get('type'));
      let lastQuery = '';
      let vocabulary: string[] = [];

      const escapeHtml = (value: string) =>
        value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

      const escapeRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

      const highlight = (value: string, terms: string[]) => {
        const safe = escapeHtml(value);
        if (terms.length === 0) return safe;
        const pattern = new RegExp(`(${terms.map(escapeRegExp).join('|')})`, 'gi');
        return safe.replace(pattern, '<mark>$1</mark>');
      };

      const snippet = (text: string, terms: string[]) => {
        const lower = text.toLowerCase();
        let at = -1;
        for (const term of terms) {
          const found = lower.indexOf(term);
          if (found >= 0 && (at < 0 || found < at)) at = found;
        }
        if (at < 0) return text.slice(0, 180).trim();
        const start = Math.max(0, at - 90);
        const end = Math.min(text.length, at + 150);
        return `${start > 0 ? '…' : ''}${text.slice(start, end).trim()}${end < text.length ? '…' : ''}`;
      };

      const levenshtein = (left: string, right: string) => {
        if (left === right) return 0;
        if (!left.length) return right.length;
        if (!right.length) return left.length;

        let previous = Array.from({ length: right.length + 1 }, (_, index) => index);
        for (let row = 1; row <= left.length; row += 1) {
          const current = [row];
          for (let column = 1; column <= right.length; column += 1) {
            current[column] = Math.min(
              previous[column] + 1,
              current[column - 1] + 1,
              previous[column - 1] + (left[row - 1] === right[column - 1] ? 0 : 1),
            );
          }
          previous = current;
        }
        return previous[right.length];
      };

      const buildVocabulary = (list: Entry[]) => {
        const words = new Set<string>();
        for (const entry of list) {
          const source = `${entry.title} ${entry.section ?? ''}`.toLowerCase();
          for (const word of source.match(/[a-z][a-z0-9'-]{2,}/g) ?? []) words.add(word);
        }
        return [...words].sort();
      };

      // Counts describe the current query, not the type filter. Clicking a type
      // should not change the other type counts, only the visible results.
      const updateTypeCounts = (matching: Entry[]) => {
        const counts = new Map<string, number>([['all', matching.length]]);
        for (const entry of matching) {
          counts.set(entry.type, (counts.get(entry.type) ?? 0) + 1);
        }
        typeChips.forEach((chip) => {
          const value = chip.dataset.type ?? 'all';
          const count = chip.querySelector<HTMLElement>('[data-type-count]');
          if (count) count.textContent = String(counts.get(value) ?? 0);
        });
      };

      const updateReset = () => {
        if (reset) reset.hidden = !((input?.value ?? '').trim() || activeType !== 'all');
      };

      const nearestWord = (term: string) => {
        const limit = term.length < 5 ? 1 : 2;
        let best = term;
        let bestDistance = limit + 1;

        for (const word of vocabulary) {
          if (Math.abs(word.length - term.length) > limit) continue;
          const distance = levenshtein(term, word);
          if (distance < bestDistance) {
            best = word;
            bestDistance = distance;
          }
        }

        return bestDistance <= limit ? best : term;
      };

      const clearSuggestions = () => {
        if (suggestionsEl) suggestionsEl.hidden = true;
        suggestionList?.replaceChildren();
      };

      const showSuggestions = (query: string) => {
        if (!suggestionsEl || !suggestionList) return;
        const stopWords = new Set([
          'the', 'and', 'for', 'what', 'when', 'where', 'which', 'who', 'why', 'how',
          'does', 'did', 'can', 'could', 'would', 'should', 'with', 'from', 'that', 'this',
          'have', 'has', 'are', 'was', 'were', 'you', 'your', 'about', 'into', 'its',
        ]);
        const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
        const corrected = terms.map((term) =>
          term.length >= 3 && !stopWords.has(term) ? nearestWord(term) : term,
        );
        if (corrected.every((term, index) => term === terms[index])) {
          clearSuggestions();
          return;
        }

        const phrase = corrected.join(' ');
        suggestionList.replaceChildren();
        const button = document.createElement('button');
        button.className = 'search-suggestion';
        button.type = 'button';
        button.textContent = phrase;
        button.addEventListener('click', () => {
          if (!input) return;
          input.value = phrase;
          run(phrase);
          syncUrl(phrase);
          input.focus();
        });
        suggestionList.append(button);
        suggestionsEl.hidden = false;
      };

      const render = (query: string) => {
        if (!entries || !resultsEl) return;
        const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
        const matching = entries.filter((entry) => {
          const haystack = `${entry.title} ${entry.section ?? ''} ${entry.text}`.toLowerCase();
          return terms.every((term) => haystack.includes(term));
        });
        const matchingForType =
          activeType === 'all' ? matching : matching.filter((entry) => entry.type === activeType);

        const scored = matchingForType
          .map((entry) => {
            const haystack = `${entry.title} ${entry.section ?? ''} ${entry.text}`.toLowerCase();
            let score = 0;
            for (const term of terms) {
              if (entry.title.toLowerCase().includes(term)) score += 12;
              if ((entry.section ?? '').toLowerCase().includes(term)) score += 4;
              score += Math.min(6, haystack.split(term).length - 1);
            }
            return { entry, score };
          })
          .sort((a, b) => b.score - a.score)
          .slice(0, 40);

        resultsEl.innerHTML = scored
          .map(
            ({ entry }) => `
          <li class="result">
            <a class="result-link" href="${entry.url}">
              <span class="result-type">${escapeHtml(entry.type)}</span>
              <span class="result-title">${highlight(entry.title, terms)}</span>
              ${entry.section ? `<span class="result-section">${escapeHtml(entry.section)}</span>` : ''}
              <span class="result-snippet">${highlight(snippet(entry.text, terms), terms)}</span>
            </a>
          </li>`,
          )
          .join('');

        const totalMatches = matchingForType.length;
        if (statusEl) {
          statusEl.textContent =
            totalMatches === 0
              ? '0 matches'
              : totalMatches > 40
                ? `40 of ${totalMatches} matches`
                : `${totalMatches} ${totalMatches === 1 ? 'match' : 'matches'}`;
        }

        updateTypeCounts(matching);
        updateReset();
        emptyEl?.classList.toggle('is-visible', scored.length === 0);
        if (scored.length === 0) showSuggestions(query);
        else clearSuggestions();
      };

      const run = (query: string) => {
        lastQuery = query;
        if (query.trim().length < 2) {
          resultsEl && (resultsEl.innerHTML = '');
          if (statusEl) statusEl.textContent = 'Type to search';
          emptyEl?.classList.remove('is-visible');
          clearSuggestions();
          if (entries) updateTypeCounts(entries);
          updateReset();
          return;
        }
        render(query);
      };

      const load = async () => {
        if (entries || loading) return;
        loading = true;
        try {
          const response = await fetch(indexUrl);
          entries = (await response.json()) as Entry[];
          vocabulary = buildVocabulary(entries);
          updateTypeCounts(entries);
          if (statusEl) statusEl.textContent = `${entries.length} entries indexed`;
          if (lastQuery) render(lastQuery);
        } catch {
          if (statusEl) statusEl.textContent = 'Search index unavailable';
        } finally {
          loading = false;
        }
      };

      const syncUrl = (query: string) => {
        const url = new URL(window.location.href);
        if (query.trim().length >= 2) url.searchParams.set('q', query);
        else url.searchParams.delete('q');
        if (activeType === 'all') url.searchParams.delete('type');
        else url.searchParams.set('type', activeType);
        window.history.replaceState({}, '', url);
      };

      input?.addEventListener('focus', load);
      input?.addEventListener('input', () => {
        load();
        run(input.value);
        syncUrl(input.value);
      });

      const resultLinks = () =>
        Array.from(resultsEl?.querySelectorAll<HTMLAnchorElement>('.result-link') ?? []);

      input?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown') {
          const first = resultLinks()[0];
          if (first) {
            event.preventDefault();
            first.focus();
          }
          return;
        }
        if (event.key !== 'Enter') return;
        const first = resultLinks()[0];
        if (first) {
          event.preventDefault();
          first.click();
        }
      });

      // Once a result has focus, the arrow keys keep moving through the list
      // instead of jumping back to the browser's scroll behaviour.
      resultsEl?.addEventListener('keydown', (event) => {
        const keys = ['ArrowDown', 'ArrowUp', 'Home', 'End', 'Escape'];
        if (!keys.includes(event.key)) return;
        const links = resultLinks();
        if (links.length === 0) return;
        if (event.key === 'Escape') {
          event.preventDefault();
          input?.focus();
          return;
        }
        const current = links.indexOf(document.activeElement as HTMLAnchorElement);
        const target =
          event.key === 'Home'
            ? 0
            : event.key === 'End'
              ? links.length - 1
              : event.key === 'ArrowDown'
                ? (current + 1) % links.length
                : current <= 0
                  ? -1
                  : current - 1;
        event.preventDefault();
        if (target < 0) input?.focus();
        else links[target]?.focus();
      });

      typeChips.forEach((chip) => {
        chip.addEventListener('click', () => {
          activeType = chip.dataset.type ?? 'all';
          typeChips.forEach((other) => other.setAttribute('aria-pressed', String(other === chip)));
          run(input?.value ?? '');
          syncUrl(input?.value ?? '');
        });
      });

      typeChips.forEach((chip) => {
        chip.setAttribute('aria-pressed', String(chip.dataset.type === activeType));
      });

      reset?.addEventListener('click', () => {
        if (input) {
          input.value = '';
          input.focus();
        }
        activeType = 'all';
        typeChips.forEach((chip) => {
          chip.setAttribute('aria-pressed', String(chip.dataset.type === 'all'));
        });
        run('');
        syncUrl('');
        updateReset();
      });

      window.addEventListener('popstate', () => {
        const params = new URLSearchParams(window.location.search);
        activeType = validType(params.get('type'));
        typeChips.forEach((chip) => {
          chip.setAttribute('aria-pressed', String(chip.dataset.type === activeType));
        });
        const query = params.get('q') ?? '';
        if (input) input.value = query;
        updateReset();
        if (query.trim().length >= 2) {
          load();
          run(query);
        } else {
          run('');
        }
      });

      const initial = new URLSearchParams(window.location.search).get('q') ?? '';
      if (input && initial) {
        input.value = initial;
        load();
        run(initial);
      }
      updateReset();
    }
  </script>

  <style>
    .search-suggestions[hidden] {
      display: none;
    }

    .search-suggestions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.75rem;
      margin: 1rem 0 1.25rem;
      padding: 0.7rem 0.85rem;
      border: 1px solid var(--color-line);
      border-left: 2px solid var(--color-accent);
      border-radius: 2px;
      background: var(--color-surface);
    }

    .search-suggestion-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    /* The suggestion button is created after load, so it has no Astro scope
       attribute. Scope the rule through the rendered wrapper instead. */
    .search-suggestions :global(.search-suggestion) {
      min-height: 2.75rem;
      padding: 0.4rem 0.65rem;
      border: 1px solid var(--color-line);
      border-radius: 2px;
      background: var(--color-surface-2);
      color: var(--color-ink);
      font: inherit;
      font-size: 0.875rem;
      text-align: left;
      cursor: pointer;
    }

    .search-suggestions :global(.search-suggestion:hover) {
      border-color: var(--color-accent);
    }

    .search-filter-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem 1rem;
      margin-top: 1rem;
    }

    .search-filter-row .search-types { margin-top: 0; }
    .chip-count:empty { display: none; }
    .toolbar-reset[hidden] { display: none; }
  </style>
</Base>
