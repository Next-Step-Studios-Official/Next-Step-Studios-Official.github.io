---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
import { DISCORD, ELSEWHERE, isLinked } from '../lib/social';

const invite = DISCORD.inviteUrl.trim();
const unlinkedSlots = ELSEWHERE.filter((link) => !isLinked(link)).length;

const rules = [
  {
    title: 'Community Guidelines',
    body: 'How people are expected to treat each other in the server — the short version is: be decent.',
    href: '/policies/bot/community-guidelines',
  },
  {
    title: 'Acceptable Use',
    body: 'What the Bot may and may not be used for, including the things that get access removed.',
    href: '/policies/bot/acceptable-use',
  },
  {
    title: 'Moderation',
    body: 'How reports are handled, who decides, and what happens after a decision.',
    href: '/policies/bot/moderation',
  },
];
---

<Base
  title="Social"
  description="Every official Next Step Studios link in one place — the Discord server, its channels, and any other account the studio holds."
  path="/social"
>
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack">
        <p class="eyebrow">Social</p>
        <h1 class="display display--page">Everywhere this studio is, in one list.</h1>
        <p class="lede">
          Discord is where the community lives. This page is the single authoritative record of
          the server, its channels and any other account the studio holds. If a link is not on
          this page, it is not official — no matter who is posting it.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--flush">
    <div class="container">
      <div class="split" style="align-items: start;">
        <div class="panel panel--pad">
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
            <div>
              <p class="label" style="margin: 0;">Discord server</p>
              <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); margin-top: 0.6rem;">{DISCORD.serverName}</h2>
            </div>
          </div>

          <p style="color: var(--color-muted); margin-top: 1rem; font-size: 0.9375rem;">
            {DISCORD.description}
          </p>

          {
            invite ? (
              <a class="btn btn-primary" href={invite} rel="me noopener" style="margin-top: 1.5rem;">
                Join the server
              </a>
            ) : (
              <div class="notice notice--neutral" style="margin-top: 1.5rem;">
                <p class="notice-body" style="margin: 0;">
                  The invite link has not been published yet. It will appear here — and only
                  here — as soon as it exists.
                </p>
              </div>
            )
          }

          <p class="label" style="margin-top: 2rem;">Inside the server</p>
          <ul class="channel-list">
            {
              DISCORD.channels.map((channel) => (
                <li class="channel">
                  <span class="channel-name">#{channel.name}</span>
                  <span class="channel-purpose">{channel.purpose}</span>
                  {isLinked(channel) ? (
                    <a class="text-link channel-link" href={channel.href}>Open</a>
                  ) : (
                    <span class="channel-link channel-link--pending">link pending</span>
                  )}
                </li>
              ))
            }
          </ul>
          <p style="color: var(--color-muted); font-size: 0.8125rem; margin-top: 1rem;">
            Channel links are added as each one is created. Anything marked
            <em>link pending</em> exists in the plan, not yet in the server.
          </p>
        </div>

        <div class="prose">
          <h2 style="margin-top: 0; padding-top: 0; border-top: 0;">Why this page is short</h2>
          <p>
            A studio listing ten half-used accounts is harder to trust than one listing the two
            it actually maintains. Only accounts that are genuinely run by the studio appear
            here. Slots without a link are shown deliberately, so nobody has to guess whether a
            convincing-looking account belongs to this studio.
          </p>

          <h2>Impersonation and lookalikes</h2>
          <p>
            Someone will eventually make an account with this studio's name on it. The test is
            simple: if the account is not linked from this page, it is not this studio. Reports
            of impersonation can go to the contact address below.
          </p>

          <h2>The rules of the room</h2>
          <p>
            The Discord server and the Bot share the same standards. They are written down
            rather than assumed, even though the Bot's policies are still drafts:
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid">
        {
          rules.map((rule) => (
            <a class="panel panel--pad card-link" href={rule.href}>
              <p class="label">Policy</p>
              <h3 style="font-size: 1.05rem; margin-top: 0.7rem;">{rule.title}</h3>
              <p style="color: var(--color-muted); font-size: 0.9rem; margin-top: 0.6rem;">{rule.body}</p>
              <span class="text-link" style="display: inline-block; margin-top: 1rem;">Read →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Elsewhere</p>
          <h2 class="section-title" style="margin-top: 0.75rem;">Other accounts</h2>
        </div>
        <p style="color: var(--color-muted); font-size: 0.9375rem; max-width: 34ch;">
          {unlinkedSlots === ELSEWHERE.length
            ? 'No other accounts exist yet. When one does, it is added here first.'
            : unlinkedSlots === 0
              ? 'Every account on this list is live and official.'
              : 'Only the accounts with a link are live. The rest are planned, not published.'}
        </p>
      </div>

      <ul class="social-grid">
        {
          ELSEWHERE.map((link) => (
            <li class="panel panel--pad social-card">
              <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem;">
                <h3 style="font-size: 1.05rem;">{link.label}</h3>
                {isLinked(link) ? (
                  <a class="text-link" href={link.href} rel="me noopener">Follow →</a>
                ) : (
                  <span class="social-pending">not linked</span>
                )}
              </div>
              <p style="color: var(--color-muted); font-size: 0.9rem; margin-top: 0.55rem;">{link.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="notice notice--neutral">
        <p class="notice-body">
          No account is ever run on your behalf, and the studio never asks for a Discord
          password, bot token or backup code — not here, not in the server, not by email. If
          something asks, it is not this studio. Anything else can go to
          <a class="text-link" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.
        </p>
      </div>
    </div>
  </section>
</Base>
