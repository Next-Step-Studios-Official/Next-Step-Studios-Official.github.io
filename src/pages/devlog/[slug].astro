---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { readingLabel } from '../../lib/reading';

export async function getStaticPaths() {
  const posts = (await getCollection('devlog')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return posts.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, previous: posts[index + 1], next: posts[index - 1] },
  }));
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);

const seriesPosts = entry.data.series
  ? (await getCollection('devlog'))
      .filter((post) => post.data.series === entry.data.series)
      .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  : [];
const seriesIndex = seriesPosts.findIndex((post) => post.id === entry.id);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
---

<Base title={entry.data.title} description={entry.data.summary} path="/devlog">
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack">
        <p class="eyebrow"><a href="/devlog" class="text-link">Devlog</a></p>
        <h1 class="display display--page">{entry.data.title}</h1>
        <div class="meta-bar" style="border-bottom: 0; padding-bottom: 0;">
          <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          <span>{readingLabel(entry.body)}</span>
          {entry.data.series && (
            <span>Series · {entry.data.series} · part {seriesIndex + 1} of {seriesPosts.length}</span>
          )}
          {entry.data.tags.map((tag) => (
            <a class="tag-link" href={`/devlog/tag/${tag}`}>#{tag}</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 52rem;">
      <article class="prose">
        <Content />
      </article>

      {entry.data.series && (
        <aside class="series-box" aria-label={`Series: ${entry.data.series}`}>
          <p class="label">Series · {entry.data.series}</p>
          <ol class="series-list">
            {seriesPosts.map((post, index) => (
              <li>
                <a
                  href={`/devlog/${post.id}`}
                  aria-current={post.id === entry.id ? 'page' : undefined}
                >
                  <span class="series-index">{String(index + 1).padStart(2, '0')}</span>
                  <span>{post.data.title}</span>
                  {post.id === entry.id && <span class="series-here">You are here</span>}
                </a>
              </li>
            ))}
          </ol>
        </aside>
      )}

      <nav
        aria-label="Devlog navigation"
        style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-top: 3rem; padding-top: 1.35rem; border-top: 1px solid var(--color-line-soft);"
      >
        <span>
          {
            previous && (
              <a class="text-link" href={`/devlog/${previous.id}`} style="font-size: 0.875rem;">
                ← {previous.data.title}
              </a>
            )
          }
        </span>
        <span>
          {
            next && (
              <a class="text-link" href={`/devlog/${next.id}`} style="font-size: 0.875rem;">
                {next.data.title} →
              </a>
            )
          }
        </span>
      </nav>
    </div>
  </section>
</Base>
