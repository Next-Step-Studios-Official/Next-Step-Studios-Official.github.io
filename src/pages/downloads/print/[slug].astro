---
import { getCollection, render } from 'astro:content';
import { getDocuments, slugOf } from '../../../lib/documents';
import { SITE } from '../../../lib/site';

export async function getStaticPaths() {
  const policies = await getCollection('policies');
  return policies.map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const documents = await getDocuments();
const document = documents.find((item) => item.slug === slugOf(entry.id));
const slug = slugOf(entry.id);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{entry.data.title} — print edition</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #14181f;
        --muted: #55606f;
        --line: #d8dde5;
        --accent: #1c4fd8;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: #eef1f5;
        color: var(--ink);
        font-family: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        font-size: 11.5pt;
        line-height: 1.62;
      }

      .screen-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem 1.5rem;
        max-width: 46rem;
        margin: 0 auto;
        padding: 1.25rem 1rem 0;
        font-family: ui-monospace, "SF Mono", "Cascadia Mono", monospace;
        font-size: 0.68rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .screen-bar a { color: var(--accent); text-decoration: none; }
      .screen-bar a:hover { text-decoration: underline; }

      .screen-actions { display: flex; gap: 0.6rem; }

      .screen-actions button,
      .screen-actions a {
        display: inline-flex;
        align-items: center;
        min-height: 2.4rem;
        padding: 0.45rem 0.9rem;
        border: 1px solid #c3cad5;
        border-radius: 2px;
        background: #fff;
        color: var(--ink);
        font: inherit;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
      }

      .screen-actions button:hover,
      .screen-actions a:hover { border-color: #8b98aa; }

      .sheet {
        max-width: 46rem;
        margin: 1.25rem auto 3rem;
        padding: 3.25rem 3rem 3.5rem;
        background: #fff;
        box-shadow: 0 20px 60px -30px rgba(15, 25, 40, 0.45);
      }

      .sheet-head { border-bottom: 1px solid var(--line); padding-bottom: 1.5rem; margin-bottom: 2rem; }
      .sheet-studio { font-family: ui-monospace, monospace; font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
      .sheet h1 { margin: 0.6rem 0 0.75rem; font-size: 1.9rem; line-height: 1.15; letter-spacing: -0.02em; }
      .sheet-meta { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; font-family: ui-monospace, monospace; font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
      .sheet-summary { margin: 1.15rem 0 0; font-size: 1rem; color: #2a3340; }

      .doc > * + * { margin-top: 0.9em; }
      .doc h2 { margin-top: 1.9em; padding-top: 1.1em; border-top: 1px solid var(--line); font-size: 1.18rem; line-height: 1.25; }
      .doc h3 { margin-top: 1.5em; font-size: 1rem; }
      .doc h4 { margin-top: 1.3em; font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
      .doc p { margin: 0; }
      .doc ul, .doc ol { margin: 0; padding-left: 1.25rem; }
      .doc li + li { margin-top: 0.35em; }
      .doc a { color: var(--accent); }
      .doc strong { color: #000; }
      .doc blockquote { margin: 0; padding-left: 1rem; border-left: 2px solid var(--line); color: var(--muted); }
      .doc table { width: 100%; border-collapse: collapse; font-size: 0.92em; }
      .doc th, .doc td { padding: 0.4rem 0.5rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
      .doc code { font-family: ui-monospace, monospace; font-size: 0.88em; }

      .sheet-foot { margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid var(--line); font-family: ui-monospace, monospace; font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }

      @page { size: A4; margin: 18mm 16mm 20mm; }

      @media print {
        body { background: #fff; font-size: 10.5pt; }
        .screen-bar, .screen-actions { display: none !important; }
        .sheet { max-width: none; margin: 0; padding: 0; box-shadow: none; }
        .doc h2 { break-after: avoid; }
        .doc li, .doc p { break-inside: avoid; }
        a { color: inherit; text-decoration: none; }
      }
    </style>
  </head>
  <body>
    <div class="screen-bar">
      <span>Print edition · {document?.version ?? entry.data.version}</span>
      <div class="screen-actions">
        <a href={`/policies/bot/${slug}`}>Read online</a>
        <a href={`/downloads/${slug}.pdf`}>PDF</a>
        <button type="button" onclick="window.print()">Print / save as PDF</button>
      </div>
    </div>

    <main class="sheet">
      <header class="sheet-head">
        <p class="sheet-studio">{SITE.name} · Discord bot documentation</p>
        <h1>{entry.data.title}</h1>
        <p class="sheet-meta">
          <span>Version {entry.data.version}</span>
          <span>{entry.data.docStatus}</span>
          <span>Applies to: {entry.data.appliesTo}</span>
        </p>
        <p class="sheet-summary">{entry.data.summary}</p>
      </header>

      <article class="doc">
        <Content />
      </article>

      <footer class="sheet-foot">
        <p>
          {SITE.name}, operated by {SITE.operator}. Contact: {SITE.contactEmail}.
          This is a draft document; the version published on the website is authoritative.
        </p>
      </footer>
    </main>
  </body>
</html>
