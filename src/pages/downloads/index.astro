---
import Base from '../../layouts/Base.astro';
import { getDocuments } from '../../lib/documents';

const documents = await getDocuments();
const version = documents[0]?.version ?? '—';

const formatSize = (bytes: number) => `${(bytes / 1024).toFixed(1)} KB`;
---

<Base
  title="Downloads"
  description="Download the Next Step Studios Discord bot policy documents as plain Markdown files. No form, no account, no email address required."
  path="/downloads"
>
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack">
        <p class="eyebrow">Downloads</p>
        <h1 class="display display--page">Every document, as a file.</h1>
        <p class="lede">
          The Discord bot's policy documents, downloadable as plain Markdown. There is no
          form, no account and no email address to enter — click a link and the file is
          yours.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--flush">
    <div class="container">
      <div class="notice" role="note" style="margin-bottom: 1.75rem;">
        <span class="status status--draft">Draft · v{version}</span>
        <p class="notice-body">
          These files are copies of documents that are still <strong>drafts for review</strong>
          and <strong>not yet effective</strong>. Downloading one does not change its status,
          and nothing here claims legal compliance.
        </p>
      </div>

      <div class="split" style="margin-bottom: 2rem;">
        <div class="panel panel--pad">
          <p class="label">The complete set</p>
          <p class="dl-note">
            All {documents.length} documents in one file, for archiving or reading offline.
            Each section keeps its own version header.
          </p>
          <div class="doc-actions" style="margin-top: 0.9rem;">
            <a class="btn btn-primary" href="/downloads/all.md" download="next-step-studios-policies.md">
              Combined .md
              <span class="btn-arrow" aria-hidden="true">↓</span>
            </a>
            <a class="text-link doc-action-link" href="/downloads/print/privacy">Print editions →</a>
          </div>
        </div>
        <div class="panel panel--pad">
          <p class="label">Four formats, same text</p>
          <ul class="format-list">
            <li><strong>Markdown</strong> — the source wording, for editors and repositories.</li>
            <li><strong>Plain text</strong> — no syntax at all, for reading anywhere.</li>
            <li><strong>PDF</strong> — a fixed layout, A4, for printing or filing.</li>
            <li><strong>Print page</strong> — a clean sheet you can print or save from the browser.</li>
          </ul>
        </div>
      </div>

      <div class="panel panel--pad" style="margin-bottom: 2rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;">
        <div style="max-width: 44ch;">
          <p class="label">Printable cheatsheet</p>
          <p class="dl-note">
            All 51 slash commands, grouped, on a two-page A4 sheet. Names and descriptions come
            from the same register as the <a class="text-link" href="/commands">command reference</a>.
          </p>
        </div>
        <a class="btn btn-primary" href="/downloads/command-cheatsheet.pdf" download>
          Cheatsheet PDF <span class="btn-arrow" aria-hidden="true">↓</span>
        </a>
      </div>

      <p class="label" style="margin-bottom: 0.75rem;">Discord bot · every document</p>
      <ul class="link-list" style="border-top: 1px solid var(--color-line-soft);">
        {documents.map((doc) => (
          <li style="display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 0.9rem 1.5rem; padding-block: 1rem;">
            <div style="min-width: 0; flex: 1 1 20rem;">
              <a
                href={doc.pagePath}
                style="display: block; color: var(--color-ink); font-family: var(--font-display); font-size: 1rem;"
              >
                {doc.shortTitle}
              </a>
              <p style="color: var(--color-muted); font-size: 0.875rem; margin-top: 0.25rem;">
                {doc.summary}
              </p>
              <p class="label" style="margin-top: 0.5rem;">
                v{doc.version} · Draft · Markdown · {formatSize(doc.bytes)}
              </p>
            </div>
            <div class="dl-actions">
              <a class="btn btn-primary" href={`/downloads/${doc.slug}.pdf`} download={`${doc.slug}.pdf`}>
                PDF
                <span class="btn-arrow" aria-hidden="true">↓</span>
              </a>
              <a class="btn" href={doc.downloadPath} download={doc.fileName}>MD</a>
              <a class="btn" href={`/downloads/${doc.slug}.txt`} download={`${doc.slug}.txt`}>TXT</a>
              <a class="text-link" href={`/downloads/print/${doc.slug}`}>Print</a>
              <a class="text-link" href={doc.githubUrl} rel="noopener">GitHub ↗</a>
            </div>
          </li>
        ))}
      </ul>

      <div class="split" style="margin-top: 2rem;">
        <div class="panel panel--pad">
          <p class="label">What these files are</p>
          <p style="color: var(--color-muted); font-size: 0.9375rem; margin-top: 0.6rem;">
            Each file is the same document as its web page, with a short header naming the
            version, status and scope. The wording of the document itself is unchanged.
          </p>
        </div>
        <div class="panel panel--pad">
          <p class="label">Which version is authoritative</p>
          <p style="color: var(--color-muted); font-size: 0.9375rem; margin-top: 0.6rem;">
            The published page at <span class="mono">/policies/bot/…</span> is the authoritative
            version. A downloaded copy can go out of date, so check the page before relying on
            one.
          </p>
        </div>
      </div>

      <p style="color: var(--color-muted); font-size: 0.875rem; margin-top: 1.5rem; max-width: 68ch;">
        Markdown files open in any text editor and render in most documentation tools. They
        contain no images, no scripts and nothing that tracks the download.
        <a class="text-link" href="/policies">Read the documents online →</a>
      </p>
    </div>
  </section>
</Base>
