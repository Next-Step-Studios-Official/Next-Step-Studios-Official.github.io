---
import Base from '../../layouts/Base.astro';
import { getDocuments } from '../../lib/documents';
import {
  CATEGORY_DESCRIPTIONS,
  CATEGORY_LABELS,
  KIND_LABELS,
  PLATFORM_LABELS,
  getCatalogue,
  type DownloadCategory,
} from '../../lib/downloads';

const documents = await getDocuments();
const catalogue = await getCatalogue();

const categories = Object.entries(CATEGORY_LABELS) as [DownloadCategory, string][];
const categoryCount = (category: DownloadCategory) =>
  catalogue.filter((item) => item.category === category).length;
const buildCategories: DownloadCategory[] = ['games', 'apps', 'tools', 'media'];
const buildCount = catalogue.filter((item) => buildCategories.includes(item.category)).length;

const platforms = ['windows', 'linux', 'macos', 'android', 'any'] as const;
const kinds = ['installer', 'archive', 'document', 'source', 'media'] as const;
---

<Base
  title="Downloads"
  description="Files, games, apps and other downloads from Next Step Studios — policies, brand assets, reference sheets and any builds published on GitHub Releases."
  path="/downloads"
  ogImage="og/downloads.png"
>
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack">
        <p class="eyebrow">Downloads</p>
        <h1 class="display display--page">Everything downloadable, in one place.</h1>
        <p class="lede">
          Policy documents, brand and press files, reference sheets, and — as they are published
          — games, apps, tools and media. Nothing here needs an account, a form or an email address.
        </p>
        <div class="meta-bar">
          <span>{catalogue.length} items</span>
          <span>{categories.length} categories</span>
          <span>From GitHub Releases where a build exists</span>
          <span>No sign-in</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--flush">
    <div class="container">
      <div class="notice" role="note" style="margin-bottom: 1.75rem;">
        <span class="status status--draft">Draft & current</span>
        <p class="notice-body">
          The bot documents and the website terms and copyright notice are still
          <strong>drafts for review</strong> and <strong>not yet effective</strong>. The website
          privacy notice and security overview describe the published site and are current.
          Downloading a file does not change its status, and nothing here claims legal compliance.
        </p>
      </div>

      {
        buildCount === 0 && (
          <div class="notice notice--neutral" role="note" style="margin-bottom: 1.75rem;">
            <span class="status status--planned">Builds & media</span>
            <p class="notice-body">
              No game, app, tool or media builds are published yet. When one is ready it appears
              here from a GitHub Release — the site does not host executables of its own. The
              <a class="text-link" href="/roadmap">roadmap</a> shows what is planned.
            </p>
          </div>
        )
      }

      <div class="dl-filters" data-dl-filters>
        <div class="dl-chips" role="group" aria-label="Filter by category">
          <button type="button" class="dl-chip is-active" data-dl-cat="all" aria-pressed="true">
            All <span class="dl-count">{catalogue.length}</span>
          </button>
          {categories.map(([id, label]) => (
            <button
              type="button"
              class="dl-chip"
              data-dl-cat={id}
              data-label={label}
              aria-pressed="false"
              title={CATEGORY_DESCRIPTIONS[id]}
            >
              {label} <span class="dl-count">{categoryCount(id)}</span>
            </button>
          ))}
        </div>

        <div class="dl-selects">
          <label class="dl-select">
            <span class="label">Platform</span>
            <select data-dl-platform>
              <option value="all">All platforms</option>
              {platforms.map((platform) => (
                <option value={platform}>{PLATFORM_LABELS[platform]}</option>
              ))}
            </select>
          </label>
          <label class="dl-select">
            <span class="label">File type</span>
            <select data-dl-kind>
              <option value="all">All types</option>
              {kinds.map((kind) => (
                <option value={kind}>{KIND_LABELS[kind]}</option>
              ))}
            </select>
          </label>
          <label class="dl-select dl-select--search">
            <span class="label">Search</span>
            <input type="search" placeholder="Name or description" data-dl-search autocomplete="off" />
          </label>
        </div>
      </div>

      <p class="filter-note">
        Counts show what each category would show with the platform, file type and search
        unchanged. The filters are kept in the address, so a filtered list can be linked or
        reloaded.
      </p>

      <details class="dl-legend">
        <summary>
          <span class="label">What each category means</span>
          <span class="dl-legend-caret" aria-hidden="true">▾</span>
        </summary>
        <div class="dl-legend-grid">
          {categories.map(([id, label]) => (
            <div>
              <p class="label">{label} · {categoryCount(id)}</p>
              <p class="dl-note">{CATEGORY_DESCRIPTIONS[id]}</p>
            </div>
          ))}
        </div>
      </details>

      <p class="filter-note">
        The Documents category includes the {documents.length} individual policies plus the
        complete-set ZIP and the command cheatsheet, so it counts more than the policy set alone.
      </p>

      <div class="dl-state">
        <p class="dl-status" data-dl-status aria-live="polite">{catalogue.length} items shown</p>
        <button type="button" class="dl-reset" data-dl-reset hidden>Reset filters</button>
      </div>

      <div class="dl-grid" data-dl-grid>
        {
          catalogue.map((item) => (
            <article
              class="panel panel--pad dl-card"
              data-dl-item
              data-category={item.category}
              data-platforms={item.platforms.join(' ')}
              data-kinds={item.kinds.join(' ')}
              data-search={`${item.title} ${item.summary} ${CATEGORY_LABELS[item.category]}`.toLowerCase()}
            >
              <div class="dl-card-head">
                <span class="label">{CATEGORY_LABELS[item.category]}</span>
                <span class="dl-badge">{item.kinds.map((kind) => KIND_LABELS[kind]).join(' · ')}</span>
              </div>
              <h2 class="dl-title">{item.title}</h2>
              <p class="dl-summary">{item.summary}</p>
              <p class="dl-meta">
                {item.platforms.map((platform) => PLATFORM_LABELS[platform]).join(' · ')}
                {item.version && <> · v{item.version}</>}
                {item.size && <> · {item.size}</>}
              </p>
              <div class="dl-card-actions">
                <a class="btn btn-primary" href={item.href} download={!item.releaseUrl} data-astro-prefetch="false" aria-label={`Download ${item.title}`}>
                  Download <span class="btn-arrow" aria-hidden="true">↓</span>
                </a>
                {item.releaseUrl && (
                  <a class="text-link" href={item.releaseUrl} rel="noopener" aria-label={`Release page for ${item.title}`}>Release page ↗</a>
                )}
                {item.formats
                  ?.filter((format) => format.href !== item.href)
                  .map((format) => (
                    <a
                      class="text-link"
                      href={format.href}
                      download={format.download ? true : undefined}
                      data-astro-prefetch="false"
                      aria-label={`${format.label} — ${item.title}`}
                    >
                      {format.label}
                    </a>
                  ))}
              </div>
            </article>
          ))
        }
      </div>

      <p class="empty-state" data-dl-empty>
        Nothing matches those filters. Try another category, or clear the search.
      </p>

      <div class="split" style="margin: 2.5rem 0;">
                  <div class="panel panel--pad">
          <p class="label">The complete policy set</p>
          <p class="dl-note">
            All {documents.length} documents in one ZIP — the bot set and the website set — with a
            README and a combined file, for archiving or reading offline. Each document keeps its
            own version header. Places Left Behind has a separate game scope in preparation; no
            game document is included or presented as effective yet.
          </p>
          <div class="doc-actions" style="margin-top: 0.9rem;">
            <a class="btn btn-primary" href="/downloads/next-step-studios-policies.zip" download="next-step-studios-policies.zip" data-astro-prefetch="false">
              Policy set .zip <span class="btn-arrow" aria-hidden="true">↓</span>
            </a>
            <a class="text-link doc-action-link" href="/downloads/all.md" download="next-step-studios-policies.md" data-astro-prefetch="false">
              Combined .md →
            </a>
            <a class="text-link doc-action-link" href="/downloads/print/privacy">Print editions →</a>
          </div>
        </div>
        <div class="panel panel--pad">
          <p class="label">Four formats, same text</p>
          <ul class="format-list">
            <li><strong>Markdown</strong> — the source wording, for editors and repositories.</li>
            <li><strong>Plain text</strong> — no syntax at all, for reading anywhere.</li>
            <li><strong>PDF</strong> — a fixed layout, A4, for printing or filing.</li>
            <li><strong>Print page</strong> — a clean sheet you can print or save from the browser.</li>
          </ul>
        </div>
      </div>

      <div class="split">
        <div class="panel panel--pad">
          <p class="label">Where builds come from</p>
          <p class="dl-note">
            Games, apps and tools are published as GitHub Releases, not as files in this
            repository. The page records the release's name, version and size, and links
            straight to it, so the download stays with the source.
          </p>
        </div>
        <div class="panel panel--pad">
          <p class="label">Which version is authoritative</p>
          <p class="dl-note">
            For policies, the published page at <span class="mono">/policies/…</span> is
            the authoritative version. A downloaded copy can go out of date, so check the
            page before relying on one.
          </p>
        </div>
      </div>

      <p style="color: var(--color-muted); font-size: 0.875rem; margin-top: 1.5rem; max-width: 68ch;">
        Markdown files open in any text editor and render in most documentation tools. They
        contain no images, no scripts and nothing that tracks the download.
        <a class="text-link" href="/policies">Read the documents online →</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .dl-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-line-soft);
  }
  .dl-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .dl-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.3rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink-dim);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .dl-chip:hover { color: var(--color-ink); border-color: var(--color-accent); }
  .dl-chip.is-active {
    color: var(--color-accent-soft);
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }
  .dl-count { opacity: 0.7; }
  .dl-selects {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .dl-select {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .dl-select select,
  .dl-select input {
    min-height: 2.3rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--color-control-line);
    border-radius: 0.4rem;
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
    /* 16px keeps iOS from zooming the page when a field is focused. */
    font-size: 1rem;
  }
  .dl-select--search input { min-width: 12rem; }
  .dl-legend {
    margin-top: 1rem;
    border: 1px solid var(--color-line-soft);
    border-radius: 0.5rem;
    background: var(--color-surface);
  }
  .dl-legend > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1rem;
    cursor: pointer;
    list-style: none;
  }
  .dl-legend > summary::-webkit-details-marker { display: none; }
  .dl-legend-caret { color: var(--color-muted); }
  .dl-legend[open] .dl-legend-caret { transform: rotate(180deg); }
  .dl-legend-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1rem;
    padding: 0 1rem 1rem;
  }
  .dl-legend-grid p { margin: 0; }
  .dl-state {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin: 1rem 0;
  }
  .dl-status {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .dl-reset {
    min-height: 2.3rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink-dim);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .dl-reset:hover { color: var(--color-ink); border-color: var(--color-accent); }
  .dl-reset[hidden] { display: none; }
  .dl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1rem;
  }
  .dl-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .dl-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .dl-badge {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .dl-title {
    font-size: 1.15rem;
    margin: 0.15rem 0 0;
  }
  .dl-summary {
    color: var(--color-ink-dim);
    font-size: 0.9375rem;
    margin: 0;
  }
  .dl-meta {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0.15rem 0 0.5rem;
  }
  .dl-card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.85rem;
    margin-top: auto;
  }
  .dl-card[hidden] { display: none; }

  @media (pointer: coarse) {
    .dl-chip,
    .dl-reset,
    .dl-legend > summary,
    .dl-select select,
    .dl-select input {
      min-height: 2.75rem;
    }
  }
</style>

  <script>
    const filters = document.querySelector<HTMLElement>('[data-dl-filters]');
    const grid = document.querySelector<HTMLElement>('[data-dl-grid]');
    const empty = document.querySelector<HTMLElement>('[data-dl-empty]');
    const status = document.querySelector<HTMLElement>('[data-dl-status]');
    const reset = document.querySelector<HTMLButtonElement>('[data-dl-reset]');

    if (filters && grid) {
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-dl-item]'));
      const chips = Array.from(filters.querySelectorAll<HTMLButtonElement>('[data-dl-cat]'));
      const platform = filters.querySelector<HTMLSelectElement>('[data-dl-platform]');
      const kind = filters.querySelector<HTMLSelectElement>('[data-dl-kind]');
      const search = filters.querySelector<HTMLInputElement>('[data-dl-search]');
      const emptyDefault = empty?.textContent?.trim() ?? '';

      const categoryIds = new Set(chips.map((chip) => chip.dataset.dlCat ?? 'all'));
      const platformIds = new Set(Array.from(platform?.options ?? []).map((option) => option.value));
      const kindIds = new Set(Array.from(kind?.options ?? []).map((option) => option.value));

      let category = 'all';

      const readUrl = () => {
        const params = new URLSearchParams(window.location.search);
        const requestedCategory = params.get('category');
        const requestedPlatform = params.get('platform');
        const requestedKind = params.get('kind');

        category =
          requestedCategory && categoryIds.has(requestedCategory) ? requestedCategory : 'all';
        if (platform) {
          platform.value =
            requestedPlatform && platformIds.has(requestedPlatform) ? requestedPlatform : 'all';
        }
        if (kind) {
          kind.value = requestedKind && kindIds.has(requestedKind) ? requestedKind : 'all';
        }
        if (search) search.value = params.get('q') ?? '';

        chips.forEach((chip) => {
          const active = chip.dataset.dlCat === category;
          chip.classList.toggle('is-active', active);
          chip.setAttribute('aria-pressed', String(active));
        });
      };

      const syncUrl = () => {
        const url = new URL(window.location.href);

        if (category === 'all') url.searchParams.delete('category');
        else url.searchParams.set('category', category);

        const selectedPlatform = platform?.value ?? 'all';
        if (selectedPlatform === 'all') url.searchParams.delete('platform');
        else url.searchParams.set('platform', selectedPlatform);

        const selectedKind = kind?.value ?? 'all';
        if (selectedKind === 'all') url.searchParams.delete('kind');
        else url.searchParams.set('kind', selectedKind);

        const query = (search?.value ?? '').trim();
        if (query) url.searchParams.set('q', query);
        else url.searchParams.delete('q');

        window.history.replaceState({}, '', url);
      };

      const apply = () => {
        const query = (search?.value ?? '').trim().toLowerCase();
        const matchesPlatform = (card: HTMLElement) =>
          !platform?.value ||
          platform.value === 'all' ||
          (card.dataset.platforms ?? '').split(' ').includes(platform.value);
        const matchesKind = (card: HTMLElement) =>
          !kind?.value ||
          kind.value === 'all' ||
          (card.dataset.kinds ?? '').split(' ').includes(kind.value);
        const matchesQuery = (card: HTMLElement) =>
          !query || (card.dataset.search ?? '').includes(query);
        const matchesBase = (card: HTMLElement) =>
          matchesPlatform(card) && matchesKind(card) && matchesQuery(card);

        let shown = 0;
        let categoryTotal = 0;

        cards.forEach((card) => {
          if (category === 'all' || card.dataset.category === category) categoryTotal += 1;
          const matchesCategory = category === 'all' || card.dataset.category === category;
          const visible = matchesCategory && matchesBase(card);
          card.hidden = !visible;
          if (visible) shown += 1;
        });

        // A chip's count respects platform, file type and search, but not the
        // category chip group itself. The All chip is the current base total.
        chips.forEach((chip) => {
          const value = chip.dataset.dlCat ?? 'all';
          const count = cards.filter(
            (card) => matchesBase(card) && (value === 'all' || card.dataset.category === value),
          ).length;
          const countEl = chip.querySelector<HTMLElement>('.dl-count');
          if (countEl) countEl.textContent = String(count);
        });

        if (status) {
          status.textContent = `${shown} of ${cards.length} items shown`;
        }
        if (empty) {
          empty.classList.toggle('is-visible', shown === 0);
          if (shown === 0) {
            const chip = chips.find((item) => item.dataset.dlCat === category);
            const label =
              chip?.dataset.label ??
              chip?.textContent?.replace(/\s*\d+\s*$/, '').trim() ??
              'this category';
            empty.textContent =
              category !== 'all' && categoryTotal === 0
                ? `No downloads in ${label} yet. Nothing is hidden — there is simply no file to download.`
                : emptyDefault;
          }
        }

        const filtered =
          category !== 'all' ||
          (platform?.value ?? 'all') !== 'all' ||
          (kind?.value ?? 'all') !== 'all' ||
          Boolean(query);

        if (reset) reset.hidden = !filtered;
      };

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          category = chip.dataset.dlCat ?? 'all';
          chips.forEach((other) => {
            const active = other === chip;
            other.classList.toggle('is-active', active);
            other.setAttribute('aria-pressed', String(active));
          });
          apply();
          syncUrl();
        });
      });

      platform?.addEventListener('change', () => {
        apply();
        syncUrl();
      });
      kind?.addEventListener('change', () => {
        apply();
        syncUrl();
      });
      search?.addEventListener('input', () => {
        apply();
        syncUrl();
      });

      reset?.addEventListener('click', () => {
        category = 'all';
        chips.forEach((chip) => {
          const active = chip.dataset.dlCat === 'all';
          chip.classList.toggle('is-active', active);
          chip.setAttribute('aria-pressed', String(active));
        });
        if (platform) platform.value = 'all';
        if (kind) kind.value = 'all';
        if (search) search.value = '';
        apply();
        syncUrl();
      });

      window.addEventListener('popstate', () => {
        readUrl();
        apply();
      });

      readUrl();
      apply();
      syncUrl();
    }
  </script>
