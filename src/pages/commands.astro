---
import Base from '../layouts/Base.astro';
import {
  COMMANDS,
  COMMAND_GROUPS,
  COMMAND_STATUS_LABEL,
  PLANNED_COMMANDS,
  commandCountByGroup,
  commandsByGroup,
} from '../lib/commands';

const groups = commandsByGroup();
const total = COMMANDS.length;
---

<Base
  title="Command reference"
  description="Every slash command in the Next Step Bot, grouped by what it does, with the same honest status labels the rest of the site uses."
  path="/commands"
  ogImage="og/commands.png"
>
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack">
        <p class="eyebrow"><a class="text-link" href="/projects/next-step-bot">Next Step Bot</a> · Command reference</p>
        <h1 class="display display--page">Every command, named exactly as it runs.</h1>
        <p class="lede">
          Read from the bot's own cogs, not from a plan. {total} slash commands exist in source across
          {COMMAND_GROUPS.length} areas. Existing in source is not the same as verified: the project page marks what
          has actually been exercised end to end.
        </p>
        <div class="meta-bar">
          <span>{total} commands</span>
          <span>{COMMAND_GROUPS.length} groups</span>
          <span>No prefix commands</span>
          <span>Source: bot cogs</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--flush">
    <div class="container">
      <div class="toolbar" data-cmd-toolbar>
        <div class="toolbar-row">
          <label class="search-field">
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="6.8" cy="6.8" r="4.4" stroke="currentColor" stroke-width="1.3" />
              <path d="M10.2 10.2 14 14" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
            </svg>
            <input
              type="search"
              data-cmd-search
              placeholder="Filter commands by name or purpose…"
              aria-label="Filter commands"
              autocomplete="off"
            />
          </label>
          <span class="read-time" data-cmd-count aria-live="polite">{total} commands</span>
        </div>

        <div class="toolbar-row">
          <div class="chip-group" data-cmd-chips>
            <button type="button" class="chip" data-group="all" aria-pressed="true">
              All groups <span class="chip-count">{total}</span>
            </button>
            {groups.map(({ group }) => (
              <button type="button" class="chip" data-group={group.id} aria-pressed="false">
                {group.label} <span class="chip-count">{commandCountByGroup(group.id)}</span>
              </button>
            ))}
          </div>
          <button type="button" class="btn btn-reset" data-cmd-reset hidden>Clear filters</button>
        </div>
      </div>

      <p class="empty-state" data-cmd-empty>
        No command matches that filter. Try part of a name, or clear the field.
      </p>

      <div class="cmd-groups">
        {
          groups.map(({ group, commands }, index) => (
            <section class="cmd-group panel" data-cmd-group={group.id} aria-labelledby={`cmd-group-${group.id}`}>
              <header class="cmd-group-head">
                <span class="cmd-group-icon" aria-hidden="true">{group.icon}</span>
                <div>
                  <h2 id={`cmd-group-${group.id}`} class="cmd-group-title">{group.label}</h2>
                  <p class="cmd-group-blurb">{group.blurb}</p>
                  <span class="cmd-group-status">{COMMAND_STATUS_LABEL[group.status]}</span>
                </div>
                <span class="label cmd-group-count">
                  {commands.length} {commands.length === 1 ? 'command' : 'commands'}
                </span>
              </header>

              <ul class="cmd-list">
                {commands.map((command) => (
                  <li
                    class="cmd-row"
                    id={`cmd-${command.name}`}
                    data-cmd-row
                    data-search={`${command.name} ${command.description} ${group.label}`.toLowerCase()}
                  >
                    <code class="cmd-name">/{command.name}</code>
                    <span class="cmd-desc">{command.description}</span>
                    {command.note ? <span class="cmd-note">{command.note}</span> : <span class="cmd-note cmd-note--blank" aria-hidden="true">—</span>}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <section class="panel cmd-group" aria-labelledby="cmd-group-planned">
        <header class="cmd-group-head">
          <span class="cmd-group-icon" aria-hidden="true">◌</span>
          <div>
            <h2 id="cmd-group-planned" class="cmd-group-title">Planned commands</h2>
            <p class="cmd-group-blurb">Intended, but not in the source yet. Not counted above.</p>
            <span class="cmd-group-status">Planned</span>
          </div>
          <span class="label cmd-group-count">
            {PLANNED_COMMANDS.length} {PLANNED_COMMANDS.length === 1 ? 'command' : 'commands'}
          </span>
        </header>
        <ul class="cmd-list">
          {
            PLANNED_COMMANDS.map((command) => (
              <li class="cmd-row" id={`cmd-${command.name}`}>
                <code class="cmd-name">/{command.name}</code>
                <span class="cmd-desc">{command.description}</span>
                <span class="cmd-note">{command.note}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <div class="callout">
        <p class="callout-title">How to read this page</p>
        <p class="callout-body">
          A command listed here is a command the source defines. Each group carries the status the
          studio has confirmed: tested, in testing, or planned. The module register carries the same
          status per feature, and the policies describe what the commands may do with data.
        </p>
        <div class="callout-actions">
          <a class="btn" href="/modules">Module register <span class="btn-arrow" aria-hidden="true">→</span></a>
          <a class="btn" href="/policies">Policies</a>
          <a class="btn" href="/downloads/command-cheatsheet.pdf" download>Cheatsheet PDF</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">In practice</p>
          <h2 class="section-title" style="margin-top: 0.75rem;">What a few of them look like</h2>
          <p class="section-sub">
            Rebuilt in HTML, not screenshots: these show the shape of the interaction without
            pretending to be live output, and they use no real member data.
          </p>
        </div>
      </div>

      <div class="mockup-grid">
        <figure class="mock-discord">
          <div class="mock-head"><span class="mock-dot"></span> <span>/ticket-panel</span></div>
          <div class="mock-embed">
            <p class="mock-title">Support tickets</p>
            <p class="mock-body">Need help? Open a private ticket and a member of staff will pick it up. One ticket per issue.</p>
            <div class="mock-select">Choose a category… <span aria-hidden="true">▾</span></div>
          </div>
          <figcaption>Posts the persistent panel. The select menu creates a private channel.</figcaption>
        </figure>

        <figure class="mock-discord">
          <div class="mock-head"><span class="mock-dot mock-dot--ephemeral"></span> <span>/status</span></div>
          <div class="mock-ephemeral">Only you can see this</div>
          <div class="mock-embed">
            <p class="mock-title">Application status</p>
            <p class="mock-body">Your application is <strong>under review</strong>. You will be contacted if an interview is needed.</p>
            <p class="mock-meta">Submitted · 12 days ago</p>
          </div>
          <figcaption>A private reply. Application data is covered by the privacy and retention policies.</figcaption>
        </figure>

        <figure class="mock-discord">
          <div class="mock-head"><span class="mock-dot"></span> <span>/suggest</span></div>
          <div class="mock-embed">
            <p class="mock-title">Suggestion · #142</p>
            <p class="mock-body">Add a channel for weekly screenshots so the showcase stays readable.</p>
            <div class="mock-buttons"><span>▲ 14</span><span>▼ 2</span><span>Status · Open</span></div>
          </div>
          <figcaption>Suggestions can be searched and their status changed by staff.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <style>
    .cmd-group-status {
      display: inline-block;
      margin-top: 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-accent-soft);
    }
  </style>

  <script>
    const toolbar = document.querySelector<HTMLElement>('[data-cmd-toolbar]');

    if (toolbar) {
      const search = toolbar.querySelector<HTMLInputElement>('[data-cmd-search]');
      const countEl = toolbar.querySelector<HTMLElement>('[data-cmd-count]');
      const chips = Array.from(toolbar.querySelectorAll<HTMLButtonElement>('[data-cmd-chips] .chip'));
      const reset = toolbar.querySelector<HTMLButtonElement>('[data-cmd-reset]');
      const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-cmd-row]'));
      const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-cmd-group]'));
      const empty = document.querySelector<HTMLElement>('[data-cmd-empty]');
      const total = rows.length;
      let activeGroup = 'all';

      const apply = () => {
        const query = (search?.value ?? '').trim().toLowerCase();
        let visible = 0;

        rows.forEach((row) => {
          const group = row.closest<HTMLElement>('[data-cmd-group]')?.dataset.cmdGroup ?? '';
          const inGroup = activeGroup === 'all' || group === activeGroup;
          const matches = inGroup && (!query || (row.dataset.search ?? '').includes(query));
          row.hidden = !matches;
          if (matches) visible += 1;
        });

        groups.forEach((section) => {
          const any = Array.from(section.querySelectorAll<HTMLElement>('[data-cmd-row]')).some(
            (row) => !row.hidden,
          );
          section.hidden = !any;
        });

        if (countEl) {
          countEl.textContent =
            visible === total ? `${total} commands` : `${visible} of ${total} commands`;
        }

        empty?.classList.toggle('is-visible', visible === 0);
        if (reset) reset.hidden = !(query || activeGroup !== 'all');
      };

      search?.addEventListener('input', apply);

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          activeGroup = chip.dataset.group ?? 'all';
          chips.forEach((other) => other.setAttribute('aria-pressed', String(other === chip)));
          apply();
        });
      });

      reset?.addEventListener('click', () => {
        if (search) search.value = '';
        activeGroup = 'all';
        chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.group === 'all')));
        apply();
        search?.focus();
      });
    }
  </script>
</Base>
