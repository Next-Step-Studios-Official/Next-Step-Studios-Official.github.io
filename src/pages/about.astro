---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
import {
  CONTRIBUTORS,
  CONTRIBUTORS_CONFIRMED,
  CONTRIBUTOR_WORD,
  TEAM_SIZE,
  contributorName,
} from '../lib/contributors';

const principles = [
  {
    title: 'Honest status, always',
    body: 'Every project is listed at the stage it has actually reached. The status labels do not include a way to describe unfinished work as released.',
  },
  {
    title: 'Small and maintained',
    body: 'Prefer fewer moving parts that stay working over more features that quietly rot. This site is static HTML for exactly that reason.',
  },
  {
    title: 'Nothing collected quietly',
    body: 'No accounts, no analytics, no tracking pixels, no third-party embeds. The one form on the site stores only what you send, and the privacy notice says so plainly.',
  },
];
---

<Base
  title="About"
  description="Next Step Studios is an independent creative and software studio run by Candler Shaw — currently building a private Discord bot."
  path="/about"
>
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack">
        <p class="eyebrow">About</p>
        <h1 class="display display--page">A small studio, described accurately.</h1>
        <p class="lede">
          Next Step Studios is the public-facing name of a small, independent studio. It is a
          creative and software-development identity, currently focused on one project and open
          to what comes next.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split" style="align-items: start;">
        <div class="prose">
          <h2 style="margin-top: 0; padding-top: 0; border-top: 0;">What this is</h2>
          <p>
            A studio in the straightforward sense: one operator, with volunteer contributors
            being confirmed, rather than a company with staff and departments behind it.
            {SITE.operator} runs the studio and is its only legal operator. Contributor credits
            are still being confirmed, and the team page labels the current example entries
            rather than presenting them as real people. The name exists so the work has a
            consistent identity and one official place to be found.
          </p>
          <p>
            The current project is <a href="/projects/next-step-bot">Next Step Bot</a>, a
            private Discord bot built for a single community server — applications and staff
            review, support tickets, announcements and administration.
          </p>

          <h2>Where it's going</h2>
          <p>
            Games, software tools and other digital projects. Nothing beyond the bot is in
            development yet, so nothing else is listed here. When another project starts, it
            will appear with its real status attached, whatever that status is.
          </p>
          <p>
            Work happens in Unreal Engine, Unity and Roblox Studio. Nothing built in those
            engines has been published yet, so none of it is listed as a project.
          </p>

          <h2>What this is not</h2>
          <p>
            Being precise about this is more useful than sounding bigger than the studio is:
          </p>
          <ul>
            <li>Not a registered company or corporation.</li>
            <li>No employees and no paid staff — everyone who helps is a volunteer contributor.</li>
            <li>No published games or released products.</li>
            <li>No customers, clients, awards or partnerships to cite.</li>
            <li>No account anywhere is official unless it is listed on the <a href="/links">official links page</a>.</li>
          </ul>
          <p>
            If that changes, this page changes with it.
          </p>
        </div>

        <div class="panel panel--pad">
          <p class="label" style="margin-bottom: 1rem;">Studio facts</p>
          <dl class="fact-grid" style="grid-template-columns: 1fr; margin: 0; border-top: 0;">
            <div class="fact" style="border-left: 0; padding-left: 0; border-top: 1px solid var(--color-line-soft);">
              <dt>Operator</dt>
              <dd>{SITE.operator}</dd>
            </div>
            <div class="fact" style="border-left: 0; padding-left: 0; border-top: 1px solid var(--color-line-soft);">
              <dt>Public name</dt>
              <dd>Next Step Studios</dd>
            </div>
            <div class="fact" style="border-left: 0; padding-left: 0; border-top: 1px solid var(--color-line-soft);">
              <dt>Team</dt>
              <dd>
                {CONTRIBUTORS_CONFIRMED
                  ? `${TEAM_SIZE} people · ${CONTRIBUTOR_WORD} contributors`
                  : '1 operator · roster being confirmed'}
              </dd>
            </div>
            <div class="fact" style="border-left: 0; padding-left: 0; border-top: 1px solid var(--color-line-soft);">
              <dt>Tools</dt>
              <dd>Unreal Engine · Unity · Roblox Studio</dd>
            </div>
            <div class="fact" style="border-left: 0; padding-left: 0; border-top: 1px solid var(--color-line-soft);">
              <dt>Current project</dt>
              <dd>Next Step Bot — in development</dd>
            </div>
            <div class="fact" style="border-left: 0; padding-left: 0; border-top: 1px solid var(--color-line-soft);">
              <dt>Contact</dt>
              <dd style="word-break: break-word;">
                <a class="text-link" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div
        class="panel panel--pad"
        style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem;"
      >
        <div style="max-width: 58ch;">
          <p class="label">Contact</p>
          <h2 style="font-size: clamp(1.3rem, 2.4vw, 1.7rem); margin-top: 0.6rem;">
            Ask the studio directly.
          </h2>
          <p style="color: var(--color-muted); margin-top: 0.6rem; font-size: 0.9375rem;">
            Use the contact form or email. Messages reach the studio directly, and the person
            who runs it reads them. General questions, press, privacy requests and security
            reports all start here.
          </p>
        </div>
        <div class="hero-actions" style="margin: 0;">
          <a class="btn btn-primary" href="/contact">Use the contact form</a>
          <a class="btn" href={`mailto:${SITE.contactEmail}`} style="word-break: break-all;">
            {SITE.contactEmail}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">The people</p>
          <h2 class="section-title" style="margin-top: 0.75rem;">Who contributes</h2>
          <p class="section-sub">
            {CONTRIBUTORS_CONFIRMED
              ? `${SITE.operator} runs the studio. These are the people helping with it, all voluntarily — nobody is employed or paid.`
              : `${SITE.operator} runs the studio. The cards below are example entries until each contributor confirms how they want to be credited.`}
          </p>
        </div>
        <a class="text-link mono" href="/team" style="font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;">
          The full list
        </a>
      </div>

      <div class="card-grid">
        {CONTRIBUTORS.map((person) => (
          <div class="panel panel--pad">
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;">
              <span class="label">{person.role}</span>
              {!CONTRIBUTORS_CONFIRMED && <span class="status status--draft">Example</span>}
            </div>
            <h3 style="font-size: 1.15rem; margin-top: 0.75rem;">{contributorName(person)}</h3>
            <p style="color: var(--color-muted); font-size: 0.9375rem; margin-top: 0.6rem;">{person.focus}</p>
          </div>
        ))}
      </div>

      {!CONTRIBUTORS_CONFIRMED && (
        <p style="color: var(--color-muted); font-size: 0.875rem; margin-top: 1.25rem;">
          These are example entries, not real people, while each contributor confirms how
          they want to be credited. <a class="text-link" href="/team">The team page</a>
          explains the list.
        </p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">How the studio works</p>
          <h2 class="section-title" style="margin-top: 0.75rem;">Three commitments</h2>
        </div>
      </div>
      <div class="card-grid">
        {principles.map((principle, index) => (
          <div class="panel panel--pad">
            <span class="label">0{index + 1}</span>
            <h3 style="font-size: 1.15rem; margin-top: 0.75rem;">{principle.title}</h3>
            <p style="color: var(--color-muted); font-size: 0.9375rem; margin-top: 0.6rem;">{principle.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
