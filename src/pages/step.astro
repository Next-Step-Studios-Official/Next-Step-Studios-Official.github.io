---
import Base from '../layouts/Base.astro';
import { STARTER_QUESTIONS, STEP_TOPICS } from '../lib/assistant';

const limits = [
  {
    title: 'It only knows this site',
    body: 'Step answers from the studio’s public pages: the studio, the bot, projects, policies, team, links and contact. If a subject is not in those pages, it says so instead of inventing an answer.',
  },
  {
    title: 'It is not a language model',
    body: 'There is no model, no API key and no server behind Step. It matches your question against a generated fact file and the site index, then shows the closest published answer.',
  },
  {
    title: 'It does not remember',
    body: 'Messages and follow-up choices live in this browser tab only. Reloading the page, opening a new conversation or closing the tab clears them. Nothing is saved, profiled or sent to the studio.',
  },
  {
    title: 'It cannot take action',
    body: 'Step cannot change a policy, submit a privacy request, send email, join a server or open a ticket. Those routes are on the Contact page, and they are deliberately human.',
  },
];

const tips = [
  'Ask about one thing at a time, using words that appear on the page you are reading.',
  'Use the Topics menu for a browseable list, or the suggested questions under an answer.',
  'Follow a link in an answer when you need the source document rather than the summary.',
  'Start a new conversation to clear the log and return to the page’s starter questions.',
];

const steps = [
  {
    number: '01',
    title: 'Open Step',
    body: 'Use the Ask Step button in the corner, or a question button on this page. The panel opens without leaving the page.',
  },
  {
    number: '02',
    title: 'Ask or browse',
    body: 'Pick a starter question, open Topics, or type your own. Step loads two generated files from this site and looks for a published answer.',
  },
  {
    number: '03',
    title: 'Check the source',
    body: 'Answers name their confidence and link to the relevant page or document. Copy keeps the answer on your clipboard; New clears the conversation.',
  },
];
---

<Base
  title="How Step works"
  description="What Step, the Next Step Studios local guide, can answer, what it cannot do, and why it never sends your question anywhere."
  path="/step"
>
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack">
        <p class="eyebrow">Step · Local studio guide</p>
        <h1 class="display display--page">A guide with the limits written down.</h1>
        <p class="lede">
          Step answers questions about Next Step Studios from the studio’s own public pages.
          It runs entirely in this browser: no account, no API, no model and no conversation
          storage. This page is the full account of what it can and cannot do.
        </p>
        <div class="hero-actions">
          <button class="btn btn-primary" type="button" data-step-ask={STARTER_QUESTIONS[0]}>
            Try Step
          </button>
          <a class="btn" href="#topics">Browse topics</a>
        </div>
        <div class="meta-bar">
          <span>Local only</span>
          <span>No account</span>
          <span>No API</span>
          <span>Resets on reload</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--flush" id="topics">
    <div class="container">
      <div class="section-head">
        <h2>What Step can answer</h2>
        <span class="label">Curated from the site</span>
      </div>
      <p class="step-guide-intro">
        These are the topic groups in Step’s menu. Every question opens the panel with that
        question already asked, so you can see the answer and its source rather than a
        paraphrase here.
      </p>

      <div class="step-guide-topics">
        {STEP_TOPICS.map((topic) => (
          <section class="panel panel--pad step-guide-topic">
            <p class="label">{topic.label}</p>
            <div class="step-guide-questions">
              {topic.questions.map((question) => (
                <button class="step-guide-question" type="button" data-step-ask={question}>
                  {question}
                  <span aria-hidden="true">↗</span>
                </button>
              ))}
            </div>
          </section>
        ))}
      </div>

      <p class="step-guide-note">
        The same starters appear at the bottom of the panel, chosen for the page you are on:
        commands on the command reference, policies on a policy page, and the studio basics
        everywhere else.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>How a question is handled</h2>
        <span class="label">Three steps, no network service</span>
      </div>
      <div class="step-guide-steps">
        {steps.map((step) => (
          <article class="step-guide-step">
            <span class="step-guide-number" aria-hidden="true">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split-grid">
        <div class="panel panel--pad">
          <p class="label">The boundary</p>
          <h2>What it will not do</h2>
          <ul class="step-guide-list">
            {limits.map((limit) => (
              <li>
                <strong>{limit.title}.</strong> {limit.body}
              </li>
            ))}
          </ul>
        </div>
        <div class="panel panel--pad">
          <p class="label">Getting a useful answer</p>
          <h2>Small habits, better results</h2>
          <ul class="step-guide-list">
            {tips.map((tip) => (
              <li>{tip}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="panel panel--pad step-guide-privacy">
        <div>
          <p class="label">Privacy, in one paragraph</p>
          <h2>Your question stays in the tab.</h2>
        </div>
        <div>
          <p class="muted">
            When Step opens, the page fetches <span class="mono">/assistant-facts.json</span> and
            <span class="mono">/search-index.json</span> from this site. Those files are generated
            at build time. Your question is matched against them in JavaScript, and the log exists
            only in memory. There is no request to an AI provider, no analytics event and no
            server-side transcript.
          </p>
          <p class="step-guide-links">
            <a class="text-link" href="/policies/website/privacy">Website privacy notice →</a>
            <a class="text-link" href="/contact">Contact the studio →</a>
            <a class="text-link" href="/search">Search without Step →</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .step-guide-intro {
    max-width: 66ch;
    margin: 1rem 0 1.5rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .step-guide-topics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1rem;
  }

  .step-guide-topic {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .step-guide-questions {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .step-guide-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--color-line);
    border-radius: 2px;
    background: var(--color-surface-2);
    color: var(--color-ink-dim);
    font: inherit;
    font-size: 0.8125rem;
    line-height: 1.4;
    text-align: left;
  }

  .step-guide-question span {
    flex: none;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .step-guide-question:hover {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface-2));
    color: var(--color-ink);
  }

  .step-guide-note {
    max-width: 72ch;
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.03em;
    line-height: 1.7;
  }

  .step-guide-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .step-guide-step {
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
  }

  .step-guide-number {
    display: block;
    color: var(--color-accent-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
  }

  .step-guide-step h3 {
    margin: 0.5rem 0 0.35rem;
    font-size: 1.05rem;
  }

  .step-guide-step p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .step-guide-list {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .step-guide-list li {
    padding-left: 0.9rem;
    border-left: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .step-guide-list strong {
    color: var(--color-ink);
  }

  .step-guide-privacy {
    display: grid;
    grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1.3fr);
    gap: 1.5rem;
  }

  .step-guide-privacy h2 {
    margin-top: 0.5rem;
  }

  .step-guide-privacy p {
    margin-top: 0;
  }

  .step-guide-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1rem !important;
  }

  @media (max-width: 720px) {
    .step-guide-privacy {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
