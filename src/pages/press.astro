---
import Base from '../layouts/Base.astro';
import brandAssets from '../data/brand-assets.json';
import { SITE } from '../lib/site';
import { statSync } from 'node:fs';

const current = brandAssets.marks.find((mark) => mark.id === 'logo')!;
const retired = brandAssets.marks.find((mark) => mark.id === 'neon-emblem-2026-07-25')!;

const fileFor = (
  mark: (typeof brandAssets.marks)[number],
  size: number,
  format: string,
  variant = 'standard',
) =>
  mark.files.find(
    (file) => file.size === size && file.format === format && file.variant === variant,
  );

const kb = (bytes: number) => `${Math.max(1, Math.round(bytes / 1024))} KB`;

const zipPath = 'public/downloads/next-step-studios-brand-kit.zip';
const zipBytes = statSync(zipPath).size;
const zipSize = `${(zipBytes / 1024 / 1024).toFixed(2)} MB`;

const whiteTile = '/brand/archive/logo-white-tile-2026-11-21.png';
const whiteTileBytes = statSync(`public${whiteTile}`).size;

const colours = [
  { name: 'Base', value: '#07080B', role: 'Background' },
  { name: 'Ink', value: '#E9EEF7', role: 'Primary text' },
  { name: 'Accent blue', value: '#4D8DFF', role: 'Primary accent' },
  { name: 'Violet', value: '#A78BFA', role: 'Secondary accent' },
  { name: 'Magenta', value: '#FF64D8', role: 'Rare highlight' },
];

const typefaces = [
  { name: 'Space Grotesk', role: 'Display and headings', sample: 'One careful step' },
  { name: 'Inter', role: 'Body text and interface copy', sample: 'A studio, described accurately.' },
  { name: 'JetBrains Mono', role: 'Code, labels and figures', sample: 'v0.2.0 · 51 commands' },
];

const facts = [
  { label: 'Studio', value: SITE.name },
  { label: 'Operator', value: SITE.operator },
  { label: 'Team', value: 'Operator plus volunteer contributors' },
  { label: 'Focus', value: 'A private Discord bot; first game in development' },
  { label: 'Contact', value: SITE.contactEmail },
  { label: 'Current mark', value: 'Pixel-art ninja, since 25 July 2026' },
];

const boilerplate =
  `Next Step Studios is an independent creative and software studio run by ${SITE.operator}, ` +
  'with volunteer contributors. It builds a private Discord bot for one community server, and ' +
  'is developing its first game from scratch in C#.';

const sections = [
  { href: '#press', label: 'Press kit' },
  { href: '#downloads', label: 'Logo files' },
  { href: '#guidelines', label: 'Guidelines' },
  { href: '#colours', label: 'Colours & type' },
  { href: '#archive', label: 'Archive' },
];
---

<Base
  title="Press & brand"
  description="Press boilerplate, quick facts, every current logo file, the palette, type guidance, usage rules and a permanent archive of retired marks — all on one page."
  path="/press"
  ogImage="og/press.png"
>
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack">
        <p class="eyebrow">Press &amp; brand</p>
        <h1 class="display display--page">Everything about the studio, on one page.</h1>
        <p class="lede">
          Boilerplate and quick facts for a story, every current logo file, the palette and
          type, the rules for using the mark, and the retired artwork the studio refuses to
          erase. No sign-up, no request form, no separate brand microsite.
        </p>
        <div class="meta-bar">
          <span>{current.files.length} current files</span>
          <span>{retired.files.length} retired files</span>
          <span>{zipSize} complete kit</span>
          <span>Nothing overwritten</span>
        </div>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/downloads/next-step-studios-brand-kit.zip" download>
            Download the brand kit (.zip) <span class="btn-arrow" aria-hidden="true">↓</span>
          </a>
          <a class="btn" href="#archive">Jump to the archive</a>
        </div>
      </div>
    </div>
  </section>

  <nav class="brand-toc" aria-label="On this page">
    <div class="container brand-toc-inner">
      <span class="label">On this page</span>
      {sections.map((section) => <a href={section.href}>{section.label}</a>)}
    </div>
  </nav>

  <section class="section section--flush" id="press">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Press kit</p>
          <h2 class="section-title">What to say, and who to ask.</h2>
          <p class="section-sub">
            A description written to be accurate rather than flattering, and the facts most
            stories need first.
          </p>
        </div>
        <a class="text-link" href={`mailto:${SITE.contactEmail}`}>Press enquiries →</a>
      </div>

      <div class="press-layout">
        <div class="panel press-panel">
          <p class="label">Current mark</p>
          <div class="press-previews">
            <figure class="press-preview press-preview--light">
              <img
                src="/brand/press/logo-512.png"
                width="512"
                height="512"
                alt="Next Step Studios logo, transparent"
              />
              <figcaption>Transparent</figcaption>
            </figure>
            <figure class="press-preview press-preview--dark">
              <img
                src="/brand/press/logo-light-512.png"
                width="512"
                height="512"
                alt="Next Step Studios logo with a light outline for dark backgrounds"
              />
              <figcaption>For dark surfaces</figcaption>
            </figure>
          </div>
          <p class="muted">
            One mark, two treatments. The standard transparent file is for light surfaces; the
            light-outline file exists because the black ninja otherwise disappears on dark.
          </p>
        </div>

        <div>
          <div class="copy-head">
            <p class="label">Boilerplate</p>
            <button
              type="button"
              class="copy-btn"
              data-copy={boilerplate}
              data-label="Boilerplate"
              aria-label="Copy the studio boilerplate"
            >
              Copy
            </button>
          </div>
          <blockquote class="press-quote">“{boilerplate}”</blockquote>
          <p class="muted">Use it whole; it is written to be accurate rather than flattering.</p>

          <h3 class="fact-title">Quick facts</h3>
          <dl class="fact-grid fact-grid--press">
            {facts.map((fact) => (
              <div class="fact">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
          <p class="copy-status" data-copy-status role="status" aria-live="polite"></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="downloads">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Logo files</p>
          <h2 class="section-title">Every current file, direct.</h2>
          <p class="section-sub">
            PNG, SVG and JPG at four sizes. Links download the file itself; the ZIP is there
            for anyone who wants all of it at once.
          </p>
        </div>
        <span class="label">{current.files.length} files · {brandAssets.sizes.join(' / ')}</span>
      </div>

      <div class="asset-table-wrap">
        <table class="asset-table">
          <thead>
            <tr>
              <th scope="col">Size</th>
              <th scope="col">PNG · transparent</th>
              <th scope="col">JPG · dark</th>
              <th scope="col">SVG</th>
              <th scope="col">PNG · light outline</th>
              <th scope="col">SVG · light outline</th>
            </tr>
          </thead>
          <tbody>
            {brandAssets.sizes.map((size) => (
              <tr>
                <th scope="row">{size} × {size}</th>
                {[
                  ['png', 'standard'],
                  ['jpg', 'light'],
                  ['svg', 'standard'],
                  ['png', 'light'],
                  ['svg', 'light'],
                ].map(([format, variant]) => {
                  const file = fileFor(current, size, format, variant);
                  return (
                    <td>
                      {file ? <a href={file.path} download>{kb(file.bytes)}</a> : '—'}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="notice notice--neutral" style="margin-top: 1.25rem;">
        <span class="status status--info">About these files</span>
        <p class="notice-body">
          The PNGs are genuinely transparent: the white tile was removed by flooding inward
          from the edges, so white details enclosed by the artwork survive. The JPGs cannot
          store transparency, so they are flattened on <code>#07080B</code> using the
          light-outline treatment. The SVGs embed the transparent PNG at each size; they
          scale in layout, but they are not a vector redraw of the mark.
        </p>
      </div>

      <div class="split" style="margin-top: 1.25rem;">
        <div class="panel panel--pad">
          <p class="label">One download</p>
          <p class="archive-copy archive-copy--muted">
            The ZIP contains every current file, the favicons, both archived editions and a
            README explaining what to use where. {zipSize}, no form.
          </p>
          <a
            class="btn btn-primary"
            href="/downloads/next-step-studios-brand-kit.zip"
            download
            style="margin-top: 1rem;"
          >
            Brand kit .zip <span class="btn-arrow" aria-hidden="true">↓</span>
          </a>
        </div>
        <div class="panel panel--pad">
          <p class="label">Need another format?</p>
          <p class="archive-copy archive-copy--muted">
            The kit is the complete set, not a limit on what can exist. If a placement needs
            something it does not cover, ask before improvising with the mark.
          </p>
          <a class="btn" href={`mailto:${SITE.contactEmail}`} style="margin-top: 1rem;">
            Email the studio
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="guidelines">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Guidelines</p>
          <h2 class="section-title">Use the mark without breaking it.</h2>
          <p class="section-sub">
            A short, practical set of rules. They exist so the studio looks like one thing
            wherever it appears — not to make anyone read a manual.
          </p>
        </div>
      </div>

      <div class="brand-grid">
        <article class="prose brand-prose">
          <h2>The logo</h2>
          <p>
            The mark is a pixel-art lockup supplied as a transparent raster master at 1024px,
            with smaller files at 512, 256 and 128. Use the largest size the placement allows
            and let it scale down, never up: enlarging a raster mark is the fastest way to make
            it look cheap.
          </p>

          <h3>Two treatments, not two logos</h3>
          <p>
            The standard transparent file is for light surfaces. On a dark surface the black
            ninja and the black “STUDIOS” line disappear, so a second treatment adds a light
            outline grown from the artwork itself. Use the light-outline file on dark, and the
            standard file on light. They are the same mark.
          </p>

          <h3>Clear space</h3>
          <p>
            Leave clear space around the mark equal to at least one quarter of its height on
            every side. Nothing — text, other logos, a border — enters that space.
          </p>

          <h3>Minimum size</h3>
          <p>
            24px high on screen, 10mm high in print. Below that the detail inside the mark
            stops resolving and it becomes a smudge.
          </p>

          <h3>Backgrounds</h3>
          <p>
            The PNGs are genuinely transparent, so the mark can sit on any flat colour. Use
            the light treatment on dark backgrounds and the standard treatment on light ones.
            Never place the mark on a busy photograph, and never add a plate behind it to make
            it work.
          </p>

          <h3>JPG files</h3>
          <p>
            JPG cannot store transparency. The JPGs in the kit are therefore flattened on the
            studio's dark base <code>#07080B</code>, using the light-outline treatment. If you
            need the mark on white, use the transparent PNG over white rather than a flattened
            JPG.
          </p>

          <h2>What not to do</h2>
          <ul>
            <li>Do not recolour, gradient or outline the mark.</li>
            <li>Do not stretch, squash or rotate it.</li>
            <li>Do not add effects, shadows or glow.</li>
            <li>Do not crop the mark or place text inside its clear space.</li>
            <li>Do not use it to suggest endorsement, partnership or sponsorship.</li>
            <li>Do not use the transparent file on dark and call the black areas “subtle”.</li>
          </ul>
        </article>

        <aside class="brand-aside">
          <div class="panel pad">
            <p class="label">At a glance</p>
            <dl class="brand-facts">
              <div><dt>Current since</dt><dd>25 July 2026</dd></div>
              <div><dt>Master</dt><dd>1024px transparent PNG</dd></div>
              <div><dt>Treatments</dt><dd>Standard and light outline</dd></div>
              <div><dt>SVG</dt><dd>Embedded raster, not a redraw</dd></div>
              <div><dt>Minimum</dt><dd>24px screen · 10mm print</dd></div>
              <div><dt>Clear space</dt><dd>¼ of the mark's height</dd></div>
            </dl>
          </div>

          <div class="panel pad">
            <p class="label">A note on the SVG</p>
            <p class="muted">
              The SVG files wrap the transparent PNG at each size so layout scales cleanly,
              but a true vector master is still to be produced. When it is, it will be
              published alongside — not in place of — today's files.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section" id="colours">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Colours &amp; type</p>
          <h2 class="section-title">The palette, with the values.</h2>
          <p class="section-sub">
            Five colours and three typefaces. Copy a hex value directly; the name is there so
            nobody has to memorise the code.
          </p>
        </div>
      </div>

      <div class="swatch-grid brand-swatches">
        {colours.map((colour) => (
          <div class="swatch brand-swatch">
            <span class="swatch-chip" style={`background:${colour.value}`} aria-hidden="true" />
            <span class="swatch-name">{colour.name}</span>
            <code>{colour.value}</code>
            <span class="muted">{colour.role}</span>
            <button
              type="button"
              class="copy-btn copy-btn--compact"
              data-copy={colour.value}
              data-label={`${colour.name} hex`}
              aria-label={`Copy ${colour.name} hex ${colour.value}`}
            >
              Copy hex
            </button>
          </div>
        ))}
      </div>

      <div class="type-list">
        {typefaces.map((typeface) => (
          <div class="type-row">
            <div>
              <p class="swatch-name">{typeface.name}</p>
              <p class="muted">{typeface.role}</p>
            </div>
            <p class={`type-sample type-sample--${typeface.name.toLowerCase().replace(/\s+/g, '-')}`}>
              {typeface.sample}
            </p>
          </div>
        ))}
      </div>

      <p class="copy-status" data-copy-status role="status" aria-live="polite"></p>
    </div>
  </section>

  <section class="section" id="archive">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Archive</p>
          <h2 class="section-title">Every mark, kept.</h2>
          <p class="section-sub">
            Old logos do not stop appearing because a studio replaced them. Each mark keeps a
            permanent address, in every size and format, so an article written years ago still
            points at the file it described.
          </p>
        </div>
        <span class="label">{retired.files.length} retired · 1 superseded</span>
      </div>

      <div class="panel panel--pad archive-key">
        <div>
          <p class="label">Current · since 25 July 2026</p>
          <h3 class="archive-title">The ninja mark</h3>
          <p class="archive-copy">
            A transparent PNG master cut from the original artwork, with white removed from the
            outside only. White details inside the mark — the eyes, the highlights — are still
            there. The JPGs are flattened on <code>#07080B</code> and use the light-outline
            treatment, because a black ninja on a near-black background otherwise disappears.
          </p>
          <p class="archive-copy archive-copy--muted">
            The current files are in the <a class="text-link" href="#downloads">download table
            above</a>. The SVG files wrap the transparent PNG at each size; they scale in
            layout without a blurry browser resize, but they are not a vector redraw.
          </p>
        </div>
        <dl class="archive-stats">
          <div><dt>Current</dt><dd>{current.files.length} files</dd></div>
          <div><dt>Retired</dt><dd>{retired.files.length} files</dd></div>
          <div><dt>Superseded</dt><dd>1 white-tile PNG</dd></div>
        </dl>
      </div>

      <div class="section-head archive-mark-head">
        <div>
          <p class="eyebrow">Retired · 25 July 2026</p>
          <h3 class="section-title">Neon orbit emblem</h3>
        </div>
        <span class="label">{retired.files.length} files</span>
      </div>

      <div class="retired-grid">
        <div class="panel retired-preview">
          <img
            src="/brand/archive/neon-emblem-2026-07-25-512.png"
            width="512"
            height="512"
            alt="Retired neon orbit emblem"
            loading="lazy"
          />
        </div>
        <div>
          <p class="archive-copy">
            The mark used before the current logo. Kept because old posts, videos and documents
            still show it, and a press kit that erases its own history is not much of an
            archive. Its white background has been removed the same way, and the bright artwork
            needs no light-outline treatment.
          </p>
          <p class="archive-copy archive-copy--muted">
            The original flattened 1024px file is still at
            <a class="text-link" href="/brand/archive/neon-emblem-2026-07-25.png" download>
              neon-emblem-2026-07-25.png
            </a>
            and has not been touched.
          </p>
        </div>
      </div>

      <div class="asset-block">
        <div class="asset-table-wrap">
          <table class="asset-table">
            <thead>
              <tr>
                <th scope="col">Size</th>
                <th scope="col">PNG</th>
                <th scope="col">JPG · dark</th>
                <th scope="col">SVG</th>
              </tr>
            </thead>
            <tbody>
              {brandAssets.sizes.map((size) => (
                <tr>
                  <th scope="row">{size} × {size}</th>
                  {[
                    ['png', 'standard'],
                    ['jpg', 'light'],
                    ['svg', 'standard'],
                  ].map(([format, variant]) => {
                    const file = fileFor(retired, size, format, variant);
                    return (
                      <td>
                        {file ? <a href={file.path} download>{kb(file.bytes)}</a> : '—'}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="section-head archive-mark-head">
        <div>
          <p class="eyebrow">Superseded · 21 November 2026</p>
          <h3 class="section-title">The white-tile edition</h3>
        </div>
      </div>

      <div class="retired-grid">
        <div class="panel retired-preview retired-preview--white">
          <img
            src={whiteTile}
            width="1024"
            height="1024"
            alt="The superseded white-tile version of the Next Step Studios logo"
            loading="lazy"
          />
        </div>
        <div>
          <p class="archive-copy">
            The logo as it appeared before transparency: the same artwork on a solid white tile.
            The live files were replaced in place, so this flattened copy is the record of how
            the mark used to look.
          </p>
          <p class="archive-links">
            <a class="text-link" href={whiteTile} download>PNG · 1024px · {kb(whiteTileBytes)}</a>
          </p>
        </div>
      </div>

      <div class="split archive-notes">
        <div class="panel panel--pad">
          <p class="label">How the archive works</p>
          <p class="archive-copy archive-copy--muted">
            A mark is never overwritten once it has been superseded. New artwork gets a new
            filename; the old files stay where they are. That is why the retired emblem still
            resolves, and why the white-tile edition is kept as a dated file.
          </p>
        </div>
        <div class="panel panel--pad">
          <p class="label">Download everything</p>
          <p class="archive-copy archive-copy--muted">
            One ZIP with every mark on this page, the site's favicons and a README explaining
            what to use where. {zipSize}, {current.files.length + retired.files.length} mark
            files plus the superseded tile.
          </p>
          <a
            class="btn btn-primary"
            href="/downloads/next-step-studios-brand-kit.zip"
            download
            style="margin-top: 1rem;"
          >
            Brand kit .zip <span class="btn-arrow" aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="notice notice--neutral">
        <span class="status status--info">Usage</span>
        <p class="notice-body">
          Use the mark to refer to Next Step Studios in editorial work. Do not alter it,
          recolour it, stretch it, or use it to imply endorsement. The
          <a class="text-link" href="#guidelines">guidelines above</a> give the exact rules,
          and <a class="text-link" href="/contact">contact</a> is open if something is unclear.
        </p>
      </div>
    </div>
  </section>

  <script>
    const copyText = async (text: string) => {
      if (navigator.clipboard?.writeText) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          // Fall through to the textarea method when clipboard permission is unavailable.
        }
      }

      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.append(area);
      area.select();
      const copied = document.execCommand('copy');
      area.remove();
      return copied;
    };

    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        const label = button.dataset.label ?? 'Text';
        const copied = await copyText(button.dataset.copy ?? '');
        const original = button.textContent;
        button.dataset.copied = String(copied);
        button.textContent = copied ? 'Copied' : 'Copy failed';
        const status = button
          .closest('section')
          ?.querySelector<HTMLElement>('[data-copy-status]');
        if (status) {
          status.textContent = copied
            ? `${label} copied to the clipboard.`
            : `Could not copy ${label.toLowerCase()}. Select it manually.`;
        }
        window.setTimeout(() => {
          delete button.dataset.copied;
          button.textContent = original;
        }, 1800);
      });
    });
  </script>

  <style>
    .brand-toc {
      position: sticky;
      top: 4.15rem;
      z-index: 30;
      border-block: 1px solid var(--color-line-soft);
      background: var(--color-bg);
    }

    .brand-toc-inner {
      display: flex;
      align-items: center;
      gap: 0.25rem 1.25rem;
      overflow-x: auto;
      padding-block: 0.35rem;
      scrollbar-width: none;
    }

    .brand-toc-inner::-webkit-scrollbar { display: none; }

    .brand-toc .label { flex: none; margin-right: 0.25rem; }

    .brand-toc a {
      display: inline-flex;
      align-items: center;
      flex: none;
      min-height: 2.75rem;
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .brand-toc a:hover,
    .brand-toc a:focus-visible { color: var(--color-ink); }

    #press,
    #downloads,
    #guidelines,
    #colours,
    #archive { scroll-margin-top: 8.5rem; }

    .press-panel {
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
      padding: 1.5rem;
    }

    .press-previews {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }

    .press-preview {
      margin: 0;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--color-line);
    }

    .press-preview img { display: block; width: 100%; height: auto; }

    .press-preview figcaption {
      padding: 0.45rem 0.6rem;
      border-top: 1px solid var(--color-line-soft);
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: 0.6rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

