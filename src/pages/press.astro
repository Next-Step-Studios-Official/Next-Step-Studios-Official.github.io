---
import Base from '../layouts/Base.astro';
import brandAssets from '../data/brand-assets.json';
import { SITE } from '../lib/site';
import { TEAM_SIZE, TEAM_WORD } from '../lib/contributors';

const current = brandAssets.marks.find((mark) => mark.id === 'logo')!;
const retired = brandAssets.marks.find((mark) => mark.id === 'neon-emblem-2026-07-25')!;

const fileFor = (size: number, format: string, variant = 'standard') =>
  current.files.find(
    (file) => file.size === size && file.format === format && file.variant === variant,
  );

const kb = (bytes: number) => `${Math.max(1, Math.round(bytes / 1024))} KB`;

const colours = [
  { name: 'Base', value: '#07080B', role: 'Background' },
  { name: 'Ink', value: '#E9EEF7', role: 'Primary text' },
  { name: 'Accent blue', value: '#4D8DFF', role: 'Primary accent' },
  { name: 'Violet', value: '#A78BFA', role: 'Secondary accent' },
  { name: 'Magenta', value: '#FF64D8', role: 'Rare highlight' },
];

const facts = [
  { label: 'Studio', value: SITE.name },
  { label: 'Team', value: `${TEAM_SIZE} people` },
  { label: 'Operator', value: SITE.operator },
  { label: 'Focus', value: 'A private Discord bot; games and tools next' },
  { label: 'Contact', value: SITE.contactEmail },
];
---

<Base
  title="Press kit"
  description="Transparent logos at four sizes in PNG, JPG and SVG, the colours, a description you can quote, and a permanent archive of retired marks."
  path="/press"
  ogImage="og/press.png"
>
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack">
        <p class="eyebrow">Press kit</p>
        <h1 class="display display--page">Everything needed to write about the studio.</h1>
        <p class="lede">
          Transparent logos at four sizes in three formats, the colours and typefaces, a
          description you can quote, and a permanent archive of retired marks. No sign-up, no
          request form.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/downloads/next-step-studios-brand-kit.zip" download>
            Download all assets (.zip) <span class="btn-arrow" aria-hidden="true">↓</span>
          </a>
          <a class="btn" href="/archive">Browse the archive</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--flush">
    <div class="container">
      <div class="press-layout">
        <div class="panel press-logo-panel">
          <p class="label">Current mark</p>
          <div class="press-previews">
            <figure class="press-preview press-preview--light">
              <img src="/brand/press/logo-512.png" width="512" height="512" alt="Next Step Studios logo, transparent" />
              <figcaption>Transparent</figcaption>
            </figure>
            <figure class="press-preview press-preview--dark">
              <img src="/brand/press/logo-light-512.png" width="512" height="512" alt="Next Step Studios logo with a light outline for dark backgrounds" />
              <figcaption>For dark surfaces</figcaption>
            </figure>
          </div>
          <p class="muted">
            One mark, two treatments. The standard transparent file is for light surfaces; the
            light-outline file exists because the black ninja otherwise disappears on dark.
          </p>
        </div>

        <div>
          <h2>Boilerplate</h2>
          <p class="press-quote">
            “Next Step Studios is an independent creative and software studio made up of
            {TEAM_WORD} people. It builds a private Discord bot for one community server, and
            games and tools are the direction it is working toward.”
          </p>
          <p class="muted">Use it whole; it is written to be accurate rather than flattering.</p>

          <h2 style="margin-top: 2rem;">Quick facts</h2>
          <dl class="fact-grid fact-grid--press">
            {
              facts.map((fact) => (
                <div class="fact">
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Logo downloads</h2>
          <p class="section-sub">
            Every size in PNG and SVG, plus a JPG flattened on the studio's dark background.
            Links are direct downloads; nothing is zipped in your browser.
          </p>
        </div>
        <span class="label">{current.files.length} files · {brandAssets.sizes.join(' / ')}</span>
      </div>

      <div class="asset-table-wrap">
        <table class="asset-table">
          <thead>
            <tr>
              <th scope="col">Size</th>
              <th scope="col">PNG · transparent</th>
              <th scope="col">JPG · dark</th>
              <th scope="col">SVG</th>
              <th scope="col">PNG · light outline</th>
              <th scope="col">SVG · light outline</th>
            </tr>
          </thead>
          <tbody>
            {
              brandAssets.sizes.map((size) => (
                <tr>
                  <th scope="row">{size} × {size}</th>
                  {[
                    ['png', 'standard'],
                    ['jpg', 'light'],
                    ['svg', 'standard'],
                    ['png', 'light'],
                    ['svg', 'light'],
                  ].map(([format, variant]) => {
                    const file = fileFor(size, format, variant);
                    return (
                      <td>
                        {file ? (
                          <a href={file.path} download>
                            {kb(file.bytes)}
                          </a>
                        ) : (
                          '—'
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="notice notice--neutral" style="margin-top: 1.25rem;">
        <span class="status status--info">About these files</span>
        <p class="notice-body">
          The PNGs are genuinely transparent: the white tile was removed by flooding inward from
          the edges, so white details enclosed by the artwork survive. The JPGs cannot store
          transparency, so they are flattened on <code>#07080B</code> using the light-outline
          treatment. The SVGs embed the transparent PNG at each size; they scale in layout, but
          they are not a vector redraw of the mark.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Colours and type</h2>
        <a class="text-link" href="/brand">Full guidelines →</a>
      </div>
      <div class="swatch-grid">
        {
          colours.map((colour) => (
            <div class="swatch">
              <span class="swatch-chip" style={`background:${colour.value}`} aria-hidden="true" />
              <span class="swatch-name">{colour.name}</span>
              <code>{colour.value}</code>
              <span class="muted">{colour.role}</span>
            </div>
          ))
        }
      </div>
      <p class="muted" style="margin-top: 1rem;">
        Typefaces: Space Grotesk for display, Inter for body, JetBrains Mono for code and labels.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Archive</h2>
          <p class="section-sub">
            Retired marks and superseded editions, kept at permanent addresses. The archive is
            its own page now.
          </p>
        </div>
        <a class="btn" href="/archive">Open the archive</a>
      </div>
      <div class="archive-grid">
        <div class="panel archive-card">
          <img src="/brand/archive/neon-emblem-2026-07-25-512.png" width="320" height="320" alt="Retired neon orbit emblem" loading="lazy" />
          <div>
            <p class="label">Retired · 25 July 2026</p>
            <h3>Neon orbit emblem</h3>
            <p class="muted">
              The mark used before the current logo. Kept because old posts, videos and documents
              still show it.
            </p>
            <p class="archive-links">
              <a class="text-link" href="/brand/archive/neon-emblem-2026-07-25-1024.png" download>PNG · 1024px</a>
              <a class="text-link" href="/archive">All sizes and formats →</a>
            </p>
          </div>
        </div>
      </div>
      <p class="muted" style="margin-top: 1rem;">
        Archived marks live under <code>/brand/archive/</code> with the date in the filename. They
        are never overwritten and never deleted, so a link in an old article keeps working.
        The retired emblem has {retired.files.length} files; the full list is on the archive page.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="notice notice--neutral">
        <span class="status status--info">Usage</span>
        <p class="notice-body">
          Use the mark to refer to Next Step Studios in editorial work. Do not alter it, recolour it,
          stretch it, or use it to imply endorsement. The
          <a class="text-link" href="/brand">brand guidelines</a> give the exact rules, and
          <a class="text-link" href="/contact">contact</a> is open if something is unclear.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .press-previews { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin: 0.75rem 0 1rem; }

  .press-preview { margin: 0; border-radius: 12px; overflow: hidden; border: 1px solid var(--color-line); }
  .press-preview img { display: block; width: 100%; height: auto; }

  .press-preview figcaption {
    padding: 0.45rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    border-top: 1px solid var(--color-line-soft);
  }

  .press-preview--light {
    background-color: #e9eef7;
    background-image:
      linear-gradient(45deg, #d3dae6 25%, transparent 25%),
      linear-gradient(-45deg, #d3dae6 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #d3dae6 75%),
      linear-gradient(-45deg, transparent 75%, #d3dae6 75%);
    background-size: 20px 20px;
    background-position: 0 0, 0 10px, 10px -10px, -10px 0;
  }

  .press-preview--dark { background: #07080b; }

  .asset-table-wrap { overflow-x: auto; border: 1px solid var(--color-line); border-radius: 12px; }
  .asset-table { width: 100%; border-collapse: collapse; min-width: 680px; }
  .asset-table th,
  .asset-table td { padding: 0.8rem 1rem; text-align: left; border-bottom: 1px solid var(--color-line-soft); font-size: 0.875rem; }
  .asset-table thead th { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-muted); background: var(--color-panel); }
  .asset-table tbody tr:last-child th,
  .asset-table tbody tr:last-child td { border-bottom: 0; }
  .asset-table tbody th { font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-ink); }
  .asset-table td a { color: var(--color-accent-soft); text-decoration: none; }
  .asset-table td a:hover { text-decoration: underline; }
</style>
