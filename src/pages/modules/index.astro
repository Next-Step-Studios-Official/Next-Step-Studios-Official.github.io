---
import Base from '../../layouts/Base.astro';
import { BOT_MODULES, MODULE_GROUPS, MODULE_STATUS_LABEL, modulesByGroup, moduleCommandCount } from '../../lib/modules';
import { COMMANDS } from '../../lib/commands';

const groups = modulesByGroup();
const statusCount = (status: string) => BOT_MODULES.filter((module) => module.status === status).length;
const commandsInModules = moduleCommandCount();
---

<Base
  title="Bot modules"
  description="Every module in the Next Step Bot source, with its commands, its status and what it touches."
  path="/modules"
  ogImage="og/modules.png"
>
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack">
        <p class="eyebrow">Next Step Bot · Module register</p>
        <h1 class="display display--page">The bot, module by module.</h1>
        <p class="lede">
          {BOT_MODULES.length} modules exist in the bot's source across {MODULE_GROUPS.length} areas.
          A module being present is not proof that it works: each entry carries the status it has
          actually reached, and links the policy that governs the data it touches.
        </p>
        <div class="meta-bar">
          <span>{BOT_MODULES.length} modules</span>
          <span>{statusCount('in-source')} in source · unverified</span>
          <span>{statusCount('partial')} partial</span>
          <span>{statusCount('planned')} planned</span>
          <span>{commandsInModules} of {COMMANDS.length} commands mapped</span>
        </div>
      </div>
    </div>
  </section>

  {groups.map((group) => (
    <section class="section section--flush">
      <div class="container">
        <div class="section-head">
          <h2>{group.group}</h2>
          <span class="label">{group.modules.length} modules</span>
        </div>
        <div class="card-grid module-grid">
          {group.modules.map((module) => (
            <a class="panel panel-link module-card" href={`/modules/${module.id}`}>
              <div class="module-card-top">
                <span class={`status status--${module.status}`}>{MODULE_STATUS_LABEL[module.status]}</span>
              </div>
              <h3>{module.name}</h3>
              <p>{module.summary}</p>
              <span class="module-card-foot">
                <span>{module.commands?.length ?? 0} {(module.commands?.length ?? 0) === 1 ? 'command' : 'commands'}</span>
                <span class="card-arrow" aria-hidden="true">↗</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="container">
      <div class="notice notice--neutral">
        <span class="status status--info">How to read this</span>
        <p class="notice-body">
          "In source · unverified" means the files and command definitions exist, not that the
          behaviour has been confirmed end to end. "Partial" means part of the area is implemented.
          "Planned" means it does not exist as a working feature. The
          <a class="text-link" href="/projects/next-step-bot">project page</a> is the authority on
          overall status; the <a class="text-link" href="/policies">policies</a> are the authority on
          what the bot may do with data.
        </p>
      </div>
    </div>
  </section>
</Base>
