---
import Base from '../layouts/Base.astro';
import { COMMANDS } from '../lib/commands';
import { FAQ } from '../lib/faq';
import { getDocuments } from '../lib/documents';
import {
  STATUS_FALLBACK_URL,
  STATUS_FEED_URL,
  STATUS_INTERVAL_MS,
  STATUS_SLOTS,
  STATUS_STALE_MS,
  STATUS_WINDOW_MS,
} from '../lib/status';

const documents = await getDocuments();
const buildDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date());

const rows = [
  {
    name: 'This website',
    state: 'live',
    detail: 'Every page is pre-built and served as a static file. No runtime, no database, no login.',
    meta: 'Static build',
  },
  {
    name: 'Contact form',
    state: 'live',
    detail:
      'Messages are stored by a small contact service so they can be answered. No account is needed to send one.',
    meta: 'Service inbox',
  },
  {
    name: 'Policy documents',
    state: 'draft',
    detail: `${documents.length} documents published at version 0.2.0. Complete, downloadable, not legally reviewed.`,
    meta: 'Draft',
  },
  {
    name: 'Discord bot',
    state: 'dev',
    detail: 'Running in one private community server. The live cards above come from the bot\u2019s own checks.',
    meta: 'In development',
  },
  {
    name: 'Command surface',
    state: 'dev',
    detail: `${COMMANDS.length} slash commands exist in source. Transcripts remain unverified end to end.`,
    meta: 'In source',
  },
  {
    name: 'Document search',
    state: 'live',
    detail: 'Full-text search runs in the browser against a generated index. No query leaves the page.',
    meta: 'Client side',
  },
  {
    name: 'Analytics, accounts, cookies',
    state: 'none',
    detail:
      'None of these exist. The status feed is the only request a page makes to another host on its own; the contact form sends only when you submit it.',
    meta: 'Not applicable',
  },
];

const stateLabel: Record<string, string> = {
  live: 'Operational',
  draft: 'Draft',
  dev: 'In development',
  none: 'Not present',
};

const stateClass: Record<string, string> = {
  live: 'status status--testing',
  draft: 'status status--draft',
  dev: 'status status--dev',
  none: 'status status--planned',
};
---

<Base
  title="Status"
  description="Live checks from the Next Step Bot, refreshed every five minutes, plus the state of the website and its documents."
  path="/status"
>
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack">
        <p class="eyebrow"><a class="text-link" href="/about">Studio</a> · Status</p>
        <h1 class="display display--page">What's up, in plain terms.</h1>
        <p class="lede">
          The bot writes a check every five minutes and this page reads it. No uptime theatre and
          no invented green dots: if the feed stops, the page says so rather than pretending
          everything is fine.
        </p>
        <div class="meta-bar" id="status-config"
          data-status-root
          data-feed={STATUS_FEED_URL}
          data-fallback={STATUS_FALLBACK_URL}
          data-stale={String(STATUS_STALE_MS)}
          data-interval={String(STATUS_INTERVAL_MS)}
          data-window={String(STATUS_WINDOW_MS)}
          data-slots={String(STATUS_SLOTS)}
        >
          <span>Live feed</span>
          <span>5-minute checks</span>
          <span>24-hour history</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--flush">
    <div class="container" data-status-board>
      <div class="live-banner" data-live-banner data-state="loading" role="status" aria-live="polite">
        <span class="live-dot" aria-hidden="true"></span>
        <span data-live-banner-text>Reading the status feed…</span>
        <time class="live-time" data-live-generated></time>
      </div>

      <div class="live-grid">
        <article class="panel live-card" data-live-card="bot">
          <p class="label">Bot</p>
          <p class="live-value" data-live-bot>—</p>
          <p class="live-sub" data-live-bot-sub>Waiting for the first check</p>
        </article>

        <article class="panel live-card" data-live-card="latency">
          <p class="label">Response time</p>
          <p class="live-value" data-live-latency>—</p>
          <p class="live-sub">Round trip reported by the bot</p>
        </article>

        <article class="panel live-card" data-live-card="uptime">
          <p class="label">Uptime · 24h</p>
          <p class="live-value" data-live-uptime>—</p>
          <p class="live-sub" data-live-uptime-sub>No checks in the window</p>
        </article>

        <article class="panel live-card" data-live-card="version">
          <p class="label">Version</p>
          <p class="live-value" data-live-version>—</p>
          <p class="live-sub">Reported by the running bot</p>
        </article>

        <article class="panel live-card" data-live-card="checked">
          <p class="label">Last check</p>
          <p class="live-value live-value--small" data-live-checked>—</p>
          <p class="live-sub" data-live-checked-sub>Nothing published yet</p>
        </article>

        <article class="panel live-card" data-live-card="count">
          <p class="label">Checks in window</p>
          <p class="live-value" data-live-count>—</p>
          <p class="live-sub">Expected every five minutes</p>
        </article>
      </div>

      <div class="panel live-history">
        <div class="section-head">
          <div>
            <p class="label">Last 24 hours</p>
            <h2 class="live-history-title">One bar per five-minute check.</h2>
          </div>
          <span class="label" data-live-window></span>
        </div>
        <div class="uptime-strip" data-uptime-strip aria-hidden="true"></div>
        <p class="live-legend">
          <span><i class="legend-dot legend-dot--up"></i> Online</span>
          <span><i class="legend-dot legend-dot--down"></i> Offline</span>
          <span><i class="legend-dot legend-dot--none"></i> No check</span>
        </p>
      </div>

      <div class="split">
        <div class="panel panel--pad">
          <p class="label">Incidents from the history</p>
          <div class="incident-list" data-live-incidents>
            <p class="live-sub">Waiting for the first check.</p>
          </div>
        </div>

        <div class="panel panel--pad">
          <p class="label">How this works</p>
          <p class="live-note">
            The bot writes <code>status.json</code> to the public repository after each check. This
            page reads that file in your browser; there is no monitoring service and no analytics.
            GitHub sees the request for the file, as it would for any image or link.
          </p>
          <div class="live-links">
            <a class="text-link" href="/policies/website/privacy">Website privacy →</a>
            <a class="text-link" href="/changelog">What changed →</a>
          </div>
        </div>
      </div>

      <p class="live-note" data-live-fallback hidden>
        The live feed could not be read, so the cards show the last copy published with the site.
        The rest of this page is unaffected.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">The rest of the site</p>
          <h2 class="section-title" style="margin-top: 0.65rem;">What is built, and what is still a draft.</h2>
        </div>
        <span class="label">As of {buildDate}</span>
      </div>

      <div class="status-table">
        {
          rows.map((row) => (
            <div class="status-row">
              <div class="status-row-main">
                <h3 class="status-name">{row.name}</h3>
                <p class="status-detail">{row.detail}</p>
              </div>
              <div class="status-row-state">
                <span class={stateClass[row.state]}>{stateLabel[row.state]}</span>
                <span class="label">{row.meta}</span>
              </div>
            </div>
          ))
        }
      </div>

      <p class="live-note" style="margin-top: 1.25rem;">
        This lower table is written at build time. {documents.length} documents, {COMMANDS.length}
        commands and {FAQ.length} answered questions feed it, so the counts cannot drift from the
        pages they describe.
      </p>
    </div>
  </section>
</Base>

<style>
  .live-banner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    background: var(--color-panel);
    margin-bottom: 1rem;
  }

  .live-dot {
    width: 9px;
    height: 9px;
    border-radius: 99px;
    background: var(--color-muted);
    box-shadow: 0 0 0 4px rgba(141, 153, 171, 0.12);
  }

  .live-banner[data-state='up'] .live-dot { background: #7ee0c0; box-shadow: 0 0 0 4px rgba(126, 224, 192, 0.14); }
  .live-banner[data-state='down'] .live-dot { background: #ff8a8a; box-shadow: 0 0 0 4px rgba(255, 138, 138, 0.14); }
  .live-banner[data-state='stale'] .live-dot { background: #f0c674; box-shadow: 0 0 0 4px rgba(240, 198, 116, 0.14); }

  .live-banner span[data-live-banner-text] { font-size: 0.9375rem; color: var(--color-ink-dim); }
  .live-time { margin-left: auto; font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-muted); }

  .live-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .live-card { padding: 1.1rem 1.15rem; }
  .live-value { font-family: var(--font-display); font-size: clamp(1.6rem, 3vw, 2.1rem); letter-spacing: -0.03em; margin-top: 0.55rem; }
  .live-value--small { font-size: clamp(1.05rem, 2vw, 1.3rem); }
  .live-sub { color: var(--color-muted); font-size: 0.78rem; margin-top: 0.4rem; line-height: 1.5; }

  .live-history { padding: 1.25rem; margin-top: 1rem; }
  .live-history-title { font-size: 1.05rem; margin-top: 0.4rem; }

  .uptime-strip {
    display: flex;
    gap: 2px;
    height: 46px;
    margin-top: 1.1rem;
    align-items: stretch;
    overflow: hidden;
    border-radius: 6px;
  }

  .uptime-slot { flex: 1 1 0; border-radius: 2px; background: #1a2130; min-width: 1px; }
  .uptime-slot--up { background: #3f9d82; }
  .uptime-slot--down { background: #b04a4a; }

  .live-legend { display: flex; flex-wrap: wrap; gap: 1.1rem; margin-top: 0.8rem; font-size: 0.75rem; color: var(--color-muted); }
  .live-legend span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .legend-dot { width: 8px; height: 8px; border-radius: 2px; display: inline-block; background: #1a2130; }
  .legend-dot--up { background: #3f9d82; }
  .legend-dot--down { background: #b04a4a; }

  .incident-list { margin-top: 0.75rem; display: grid; gap: 0.7rem; }

  .incident {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--color-line-soft);
  }

  .incident:last-child { border-bottom: 0; padding-bottom: 0; }
  .incident-name { font-size: 0.9rem; color: var(--color-ink); }
  .incident-meta { font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-muted); }

  .live-note { color: var(--color-muted); font-size: 0.85rem; line-height: 1.65; margin-top: 0.75rem; }
  .live-links { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.9rem; }

  @media (max-width: 700px) {
    .live-time { margin-left: 0; width: 100%; }
    .uptime-strip { height: 34px; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-status-root]');
  const board = document.querySelector<HTMLElement>('[data-status-board]');

  if (root && board) {
    const feedUrl = root.dataset.feed ?? '';
    const fallbackUrl = root.dataset.fallback ?? '/status.json';
    const staleAfter = Number(root.dataset.stale ?? 600000);
    const interval = Number(root.dataset.interval ?? 300000);
    const windowMs = Number(root.dataset.window ?? 86400000);
    const slots = Number(root.dataset.slots ?? 288);

    const text = (selector: string) => board.querySelector<HTMLElement>(selector);

    const banner = text('[data-live-banner]');
    const bannerText = text('[data-live-banner-text]');
    const generatedEl = text('[data-live-generated]');
    const botEl = text('[data-live-bot]');
    const botSub = text('[data-live-bot-sub]');
    const latencyEl = text('[data-live-latency]');
    const uptimeEl = text('[data-live-uptime]');
    const uptimeSub = text('[data-live-uptime-sub]');
    const versionEl = text('[data-live-version]');
    const checkedEl = text('[data-live-checked]');
    const checkedSub = text('[data-live-checked-sub]');
    const countEl = text('[data-live-count]');
    const windowEl = text('[data-live-window]');
    const strip = text('[data-uptime-strip]');
    const incidentsEl = text('[data-live-incidents]');
    const fallbackNote = text('[data-live-fallback]');

    type Check = { t: string; online: boolean; ms?: number | null };
    type Feed = {
      schema: number;
      generatedAt: string;
      bot: { online: boolean | null; latencyMs?: number | null; version?: string | null };
      checks: Check[];
    };

    const relative = (date: Date) => {
      const seconds = Math.round((date.getTime() - Date.now()) / 1000);
      const formatter = new Intl.RelativeTimeFormat('en-GB', { numeric: 'auto' });
      const units: [Intl.RelativeTimeFormatUnit, number][] = [
        ['day', 86400],
        ['hour', 3600],
        ['minute', 60],
        ['second', 1],
      ];
      for (const [unit, size] of units) {
        if (Math.abs(seconds) >= size || unit === 'second') {
          return formatter.format(Math.round(seconds / size), unit);
        }
      }
      return 'just now';
    };

    const duration = (ms: number) => {
      const minutes = Math.round(ms / 60000);
      if (minutes < 60) return `${minutes} min`;
      const hours = Math.floor(minutes / 60);
      const rest = minutes % 60;
      return rest ? `${hours} h ${rest} min` : `${hours} h`;
    };

    const setBanner = (state: 'up' | 'down' | 'stale' | 'unknown', message: string) => {
      if (banner) banner.dataset.state = state;
      if (bannerText) bannerText.textContent = message;
    };

    const renderStrip = (checks: Check[], end: number) => {
      if (!strip) return;
      strip.replaceChildren();
      const buckets = new Array(slots).fill('none');

      for (const check of checks) {
        const time = new Date(check.t).getTime();
        const age = end - time;
        if (age < 0 || age > windowMs) continue;
        const index = slots - 1 - Math.min(slots - 1, Math.floor(age / interval));
        if (buckets[index] === 'down') continue;
        buckets[index] = check.online ? 'up' : 'down';
      }

      const fragment = document.createDocumentFragment();
      for (const state of buckets) {
        const slot = document.createElement('span');
        slot.className = `uptime-slot${state === 'up' ? ' uptime-slot--up' : state === 'down' ? ' uptime-slot--down' : ''}`;
        fragment.append(slot);
      }
      strip.append(fragment);
    };

    const renderIncidents = (checks: Check[]) => {
      if (!incidentsEl) return;
      incidentsEl.replaceChildren();

      const sorted = [...checks]
        .map((check) => ({ ...check, time: new Date(check.t).getTime() }))
        .filter((check) => Number.isFinite(check.time))
        .sort((a, b) => a.time - b.time);

      const incidents: { start: number; end: number; kind: 'offline' | 'gap' }[] = [];
      let run: { start: number; end: number } | null = null;

      for (let index = 0; index < sorted.length; index += 1) {
        const check = sorted[index];
        if (!check.online) {
          run = run ? { start: run.start, end: check.time } : { start: check.time, end: check.time };
        } else if (run) {
          incidents.push({ ...run, kind: 'offline' });
          run = null;
        }

        const next = sorted[index + 1];
        if (next && next.time - check.time > interval * 3) {
          incidents.push({ start: check.time, end: next.time, kind: 'gap' });
        }
      }
      if (run) incidents.push({ ...run, kind: 'offline' });

      incidents.sort((a, b) => b.end - a.end);

      if (incidents.length === 0) {
        const none = document.createElement('p');
        none.className = 'live-sub';
        none.textContent =
          sorted.length === 0
            ? 'No checks have been published yet.'
            : 'No outages or data gaps in the window.';
        incidentsEl.append(none);
        return;
      }

      for (const incident of incidents.slice(0, 6)) {
        const row = document.createElement('div');
        row.className = 'incident';

        const name = document.createElement('span');
        name.className = 'incident-name';
        name.textContent = incident.kind === 'offline' ? 'Bot reported offline' : 'No status updates';

        const meta = document.createElement('span');
        meta.className = 'incident-meta';
        const span = Math.max(interval, incident.end - incident.start);
        meta.textContent = `${duration(span)} · ${relative(new Date(incident.end))}`;

        row.append(name, meta);
        incidentsEl.append(row);
      }
    };

    const render = (feed: Feed, usedFallback: boolean) => {
      const checks = Array.isArray(feed.checks) ? feed.checks : [];
      const now = Date.now();
      const generated = new Date(feed.generatedAt);
      const generatedTime = Number.isFinite(generated.getTime()) ? generated.getTime() : 0;
      const stale = !generatedTime || now - generatedTime > staleAfter;

      const recent = checks.filter((check) => {
        const time = new Date(check.t).getTime();
        return Number.isFinite(time) && now - time <= windowMs;
      });
      const online = recent.filter((check) => check.online).length;
      const uptime = recent.length > 0 ? Math.round((online / recent.length) * 1000) / 10 : null;
      const latest = recent.length > 0 ? recent[recent.length - 1] : null;
      const botOnline = feed.bot?.online;

      if (generatedEl) {
        generatedEl.textContent = generatedTime
          ? `Feed written ${relative(generated)}`
          : 'Feed has no timestamp';
      }

      if (botEl) botEl.textContent = botOnline === true ? 'Online' : botOnline === false ? 'Offline' : 'Unknown';
      if (botSub) {
        botSub.textContent =
          botOnline === null || botOnline === undefined
            ? 'No check has been published yet'
            : botOnline
              ? 'Reporting normally'
              : 'The bot is not reporting';
      }

      const latency = feed.bot?.latencyMs ?? latest?.ms ?? null;
      if (latencyEl) latencyEl.textContent = typeof latency === 'number' ? `${Math.round(latency)} ms` : '—';
      if (uptimeEl) uptimeEl.textContent = uptime === null ? '—' : `${uptime}%`;
      if (uptimeSub) {
        uptimeSub.textContent =
          recent.length === 0 ? 'No checks in the window' : `${online} of ${recent.length} checks online`;
      }
      if (versionEl) versionEl.textContent = feed.bot?.version ? String(feed.bot.version) : '—';
      if (checkedEl) checkedEl.textContent = latest ? relative(new Date(latest.t)) : '—';
      if (checkedSub) {
        checkedSub.textContent = latest
          ? new Date(latest.t).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })
          : 'Nothing published yet';
      }
      if (countEl) countEl.textContent = String(recent.length);
      if (windowEl) {
        windowEl.textContent = `${Math.round(windowMs / 3600000)} h · ${Math.round(interval / 60000)} min`;
      }

      renderStrip(recent, now);
      renderIncidents(recent);

      if (usedFallback) {
        fallbackNote?.removeAttribute('hidden');
        setBanner('stale', 'Showing the status copy published with this build. The live feed could not be read.');
      } else if (recent.length === 0) {
        setBanner('unknown', 'No status checks have been published yet. The page will update when the bot reports.');
      } else if (stale) {
        setBanner('stale', `The feed is stale: last written ${relative(generated)}. The values below are the last known ones.`);
      } else if (latest?.online) {
        setBanner('up', 'The bot is reporting normally.');
      } else {
        setBanner('down', 'The bot is reporting offline.');
      }
    };

    const fetchFeed = async (url: string): Promise<Feed> => {
      const separator = url.includes('?') ? '&' : '?';
      const response = await fetch(`${url}${separator}t=${Date.now()}`, { cache: 'no-store' });
      if (!response.ok) throw new Error(`Status feed returned ${response.status}`);
      return (await response.json()) as Feed;
    };

    const load = async () => {
      try {
        render(await fetchFeed(feedUrl), false);
      } catch {
        try {
          render(await fetchFeed(fallbackUrl), true);
        } catch {
          setBanner('stale', 'The status feed could not be read. The rest of the page is unaffected.');
        }
      }
    };

    void load();
    window.setInterval(() => {
      if (document.visibilityState === 'visible') void load();
    }, 60000);
  }
</script>
