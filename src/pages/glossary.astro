---
import Base from '../layouts/Base.astro';
import { GLOSSARY, GLOSSARY_COUNT } from '../lib/glossary';
---

<Base
  title="Glossary"
  description="Plain-language definitions of the terms used in the bot's policies and command reference."
  path="/glossary"
  ogImage="og/glossary.png"
>
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack">
        <p class="eyebrow">Glossary</p>
        <h1 class="display display--page">The words, defined once.</h1>
        <p class="lede">
          {GLOSSARY_COUNT} terms used across the policies, the command reference and the module
          register. Each definition is short on purpose; where a policy is the authority, the entry
          links to it.
        </p>
        <nav class="letter-nav" aria-label="Jump to a letter">
          {GLOSSARY.map((group) => (
            <a href={`#letter-${group.letter}`}>{group.letter}</a>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <section class="section section--flush">
    <div class="container glossary">
      {GLOSSARY.map((group) => (
        <section class="glossary-group" id={`letter-${group.letter}`} aria-labelledby={`letter-${group.letter}-heading`}>
          <h2 class="glossary-letter" id={`letter-${group.letter}-heading`}>{group.letter}</h2>
          <dl class="term-list">
            {group.terms.map((term) => (
              <div class="term">
                <dt id={term.term.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>{term.term}</dt>
                <dd>
                  <p>{term.definition}</p>
                  {term.see && <a class="text-link" href={term.see}>Read more →</a>}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="notice notice--neutral">
        <span class="status status--info">A term missing?</span>
        <p class="notice-body">
          If a policy uses a word this page does not explain, that is a documentation bug. Email
          <a class="text-link" href="mailto:nextstepstudiosofficial.contact@gmail.com">nextstepstudiosofficial.contact@gmail.com</a>
          with the word and where it appears.
        </p>
      </div>
    </div>
  </section>
</Base>
