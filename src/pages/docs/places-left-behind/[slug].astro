---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PlacesDocNotice from '../../../components/PlacesDocNotice.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../../lib/site';
import { readingLabel } from '../../../lib/reading';
import {
  PLACES_DOCS_INDEX,
  PLACES_DOCS_SOURCE,
  categoryFor,
  docPath,
  docStatusClass,
  formatDocDate,
  getPlacesDocs,
  versionLabel,
} from '../../../lib/placesDocs';

export async function getStaticPaths() {
  const docs = await getCollection('placesDocs');
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const category = categoryFor(entry.data.category);
const pagePath = docPath(entry);
const toc = headings.filter((heading) => heading.depth === 2);
const docs = await getPlacesDocs();
const index = docs.findIndex((doc) => doc.id === entry.id);
const previous = index > 0 ? docs[index - 1] : undefined;
const next = index < docs.length - 1 ? docs[index + 1] : undefined;

const metaDescription = `${entry.data.summary} ${category.label} document from Places Left Behind, version ${entry.data.version}. Status: ${entry.data.docStatus}`;

const articleSchema = {
  '@type': 'Article',
  '@id': `${new URL(pagePath, Astro.site ?? SITE.url).toString()}#article`,
  headline: entry.data.title,
  description: entry.data.summary,
  ...(entry.data.lastRevised ? { dateModified: entry.data.lastRevised.toISOString() } : {}),
  version: entry.data.version,
  creativeWorkStatus: entry.data.docStatus,
  inLanguage: 'en-GB',
  isPartOf: { '@id': `${(Astro.site ?? SITE.url).origin}#website` },
  about: { '@type': 'CreativeWork', name: 'Places Left Behind', creativeWorkStatus: 'In development' },
  author: { '@type': 'Person', name: SITE.operator },
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site ?? SITE.url).toString() },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: new URL('/projects', Astro.site ?? SITE.url).toString() },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Places Left Behind',
      item: new URL('/projects/places-left-behind', Astro.site ?? SITE.url).toString(),
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: 'Documentation',
      item: new URL(PLACES_DOCS_INDEX, Astro.site ?? SITE.url).toString(),
    },
    { '@type': 'ListItem', position: 5, name: entry.data.title, item: new URL(pagePath, Astro.site ?? SITE.url).toString() },
  ],
};

const categoryUrl = `${PLACES_DOCS_INDEX}#category-${category.id}`;
---

<Base
  title={entry.data.title}
  description={metaDescription}
  path={pagePath}
  ogImage="og/project-places-left-behind.png"
  ogAlt={`${entry.data.title} — Places Left Behind documentation`}
  schema={[articleSchema, breadcrumbSchema]}
>
  <section class="page-head">
    <div class="container">
      <div class="page-head-stack" style="max-width: 70rem;">
        <Breadcrumbs
          items={[
            { label: 'Home', href: '/' },
            { label: 'Projects', href: '/projects' },
            { label: 'Places Left Behind', href: '/projects/places-left-behind' },
            { label: 'Documentation', href: PLACES_DOCS_INDEX },
            { label: entry.data.title },
          ]}
        />
        <p class="eyebrow">Places Left Behind · {category.label}</p>
        <h1 class="display display--page">{entry.data.title}</h1>
        <div class="meta-bar">
          <span class={docStatusClass(entry.data.docStatus)}>{entry.data.docStatus}</span>
          <span>{versionLabel(entry.data.version)}</span>
          {entry.data.sourceId && <span>{entry.data.sourceId}</span>}
          {entry.data.lastRevised && <span>Revised {formatDocDate(entry.data.lastRevised)}</span>}
          <span>{readingLabel(entry.body)}</span>
        </div>
        <PlacesDocNotice
          docStatus={entry.data.docStatus}
          version={entry.data.version}
          legal={entry.data.legal}
        />
        <div class="scope-panel panel panel--pad">
          <div class="scope-panel-head">
            <p class="label">Scope</p>
            <span>From the source document</span>
          </div>
          <p>{entry.data.summary}</p>
        </div>
        <div class="doc-actions">
          <a class="text-link doc-action-link" href={PLACES_DOCS_INDEX}>← All documentation</a>
          <a class="text-link doc-action-link" href={categoryUrl}>More in {category.label} →</a>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="doc-layout">
      {
        toc.length > 0 && (
          <aside class="doc-aside">
            <details class="toc">
              <summary class="toc-summary">
                <span class="label">On this page</span>
                <span class="toc-caret" aria-hidden="true">▾</span>
              </summary>
              <ol>
                {toc.map((heading) => (
                  <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                ))}
              </ol>
            </details>
          </aside>
        )
      }

      <article class="prose" data-policy-prose>
        <Content />
      </article>
    </div>

    <div class="source-record panel panel--pad">
      <div class="scope-panel-head">
        <p class="label">Source record</p>
        <span>Snapshot from the game repository</span>
      </div>
      <dl>
        <div><dt>Status</dt><dd>{entry.data.docStatus}</dd></div>
        <div><dt>Version</dt><dd>{entry.data.version}</dd></div>
        {entry.data.sourceId && <div><dt>Document ID</dt><dd>{entry.data.sourceId}</dd></div>}
        {entry.data.lastRevised && (
          <div><dt>Last revised</dt><dd>{formatDocDate(entry.data.lastRevised)}</dd></div>
        )}
        <div><dt>Repository path</dt><dd><code>{entry.data.sourcePath}</code></dd></div>
        <div><dt>Source commit</dt><dd><code>{PLACES_DOCS_SOURCE.shortCommit}</code></dd></div>
      </dl>
      <p>
        The wording is reproduced from the source document. Relative links are pointed at the
        matching website pages; standalone licence files are not reproduced and those links return
        to the <a class="text-link" href={`${PLACES_DOCS_INDEX}#source-only-files`}>source-files note</a>.
        Statements about the website reflect the source commit and may predate this section.
      </p>
      <p class="source-copyright">{SITE.copyright}</p>
    </div>

    <nav
      class="doc-pager"
      aria-label="Documentation navigation"
    >
      <span>
        {previous && (
          <a class="text-link" href={docPath(previous)}>
            ← {previous.data.title}
          </a>
        )}
      </span>
      <span>
        <a class="text-link" href={categoryUrl}>Back to {category.label} ↑</a>
      </span>
      <span>
        {next && (
          <a class="text-link" href={docPath(next)}>
            {next.data.title} →
          </a>
        )}
      </span>
    </nav>

    <div class="notice notice--neutral" role="note">
      <p class="notice-body">
        This document belongs to Places Left Behind. It does not replace the
        <a class="text-link" href="/policies">website or Discord bot policies</a>, and the
        <a class="text-link" href="/projects/places-left-behind">game project page</a> describes the
        current stage of development. Questions about the game go to
        <a class="text-link" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.
      </p>
    </div>
  </div>

  <style>
    .scope-panel {
      margin-top: 1rem;
      border-left: 2px solid var(--color-accent);
    }

    .scope-panel-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.4rem 1rem;
      margin-bottom: 0.6rem;
    }

    .scope-panel-head > span {
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: 0.625rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .scope-panel p:last-child {
      margin: 0;
      color: var(--color-ink-dim);
      font-size: 0.9375rem;
      line-height: 1.65;
    }

    .source-record {
      margin-bottom: 1.5rem;
    }

    .source-record dl {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
      gap: 0.6rem 1.5rem;
      margin-top: 0.85rem;
    }

    .source-record dl > div {
      display: grid;
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: 0.5rem;
      padding-top: 0.5rem;
      border-top: 1px solid var(--color-line-soft);
    }

    .source-record dt {
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: 0.625rem;
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }

    .source-record dd {
      margin: 0;
      color: var(--color-ink-dim);
      font-size: 0.875rem;
      overflow-wrap: anywhere;
    }

    .source-record > p {
      margin-top: 0.85rem;
      color: var(--color-muted);
      font-size: 0.8125rem;
      line-height: 1.65;
    }

    .source-record .source-copyright {
      padding-top: 0.8rem;
      border-top: 1px solid var(--color-line-soft);
      color: var(--color-ink-dim);
    }

    .doc-pager {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.75rem 1.5rem;
      padding-block: 1.2rem;
      border-top: 1px solid var(--color-line-soft);
    }

    .doc-pager span {
      min-width: 0;
    }

    .doc-pager .text-link {
      font-size: 0.8125rem;
    }

    @media (max-width: 640px) {
      .source-record dl > div {
        grid-template-columns: minmax(0, 1fr);
        gap: 0.2rem;
      }

      .doc-pager {
        flex-direction: column;
      }
    }
  </style>
</Base>
