---
import Base from '../layouts/Base.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../lib/site';
import { enabledLinks, LINK_SECTIONS } from '../lib/links';
import { BOT_MODULES } from '../lib/modules';
import { COMMANDS, COMMAND_GROUPS } from '../lib/commands';
import { TEAM_SIZE, TEAM_WORD } from '../lib/contributors';
import { numberWord } from '../lib/words';
import { STARTER_QUESTIONS } from '../lib/assistant';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.find((project) => project.data.featured) ?? projects[0];

const allPosts = (await getCollection('devlog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const posts = allPosts.slice(0, 3);

const policies = (await getCollection('policies')).sort((a, b) => a.data.order - b.data.order);
const policyWord = numberWord(policies.length);
const PolicyWord = policyWord.charAt(0).toUpperCase() + policyWord.slice(1);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).format(date);

const pad = (value: number) => String(value).padStart(2, '0');

const stepDemo = [STARTER_QUESTIONS[0], STARTER_QUESTIONS[1], 'What policies do you have?'];

const tickerItems = [
  'Static build · no server',
  'No accounts',
  'No tracking',
  'No cookies',
  `Bot documentation · v${policies[0]?.data.version ?? '0.2.0'} drafts`,
  `${COMMANDS.length} slash commands documented`,
  'Full-text search · no third parties',
  `Independent studio · ${TEAM_WORD} people`,
  'Next Step Bot · in development',
];

const routes = [
  {
    index: '01',
    href: '/projects',
    title: 'Projects',
    body: 'What the studio is building, each one carrying the status it has actually reached.',
    meta: `${projects.length} listed · ${BOT_MODULES.length} modules documented`,
    cta: 'See the work',
  },
  {
    index: '02',
    href: '/commands',
    title: 'Commands',
    body: 'Every slash command the Discord bot defines, grouped by what it does and marked with what is verified.',
    meta: `${COMMANDS.length} commands · ${COMMAND_GROUPS.length} groups`,
    cta: 'Open the reference',
  },
  {
    index: '03',
    href: '/policies',
    title: 'Documents',
    body: `${PolicyWord} policy documents for the Discord bot — readable here, downloadable four ways, mirrored on GitHub.`,
    meta: `v${policies[0]?.data.version ?? '0.2.0'} · all drafts`,
    cta: 'Read the documents',
  },
  {
    index: '04',
    href: '/links',
    title: 'Official links',
    body: 'Every account and community space the studio actually runs, in one verified list.',
    meta: `${enabledLinks().length} entries · ${LINK_SECTIONS.length} sections`,
    cta: 'Open the list',
  },
  {
    index: '05',
    href: '/roadmap',
    title: 'Roadmap',
    body: 'What is in development, what is only planned, and what has been decided against.',
    meta: 'Statuses · no dates',
    cta: 'See what is next',
  },
];
---

<Base
  description={`Next Step Studios is an independent creative and software studio of ${TEAM_WORD} people, run by Candler Shaw — currently building a private Discord bot, with games and tools to follow.`}
  path="/"
>
  <section class="hero">
    <div class="hero-art" aria-hidden="true">
      <img src="/images/hero.webp" alt="" width="1392" height="752" fetchpriority="high" decoding="async" />
    </div>
    <div class="container">
      <div class="hero-grid">
        <div class="hero-stack">
          <p class="eyebrow">Independent studio · {TEAM_WORD} people · In development</p>
          <h1 class="display">
            Games and software,<br />
            built one careful <span class="accent-text">step</span> at a time.
          </h1>
          <p class="lede">
            Next Step Studios is the independent creative and software practice of
            {SITE.operator}. The current work is a private Discord bot for one community
            server. Games and tools are where it goes next.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="/projects">
              See the work <span class="btn-arrow" aria-hidden="true">→</span>
            </a>
            <a class="btn" href="/policies">Read the documents</a>
            <a class="btn" href="/links">Official links</a>
          </div>
        </div>

        <aside class="hud" aria-label="Site status">
          <div class="hud-scan" aria-hidden="true"></div>
          <div class="hud-head">
            <span class="label">System</span>
            <span class="hud-live">Live</span>
          </div>
          <dl class="hud-rows">
            <div><dt>Studio</dt><dd>Independent · {TEAM_SIZE} people</dd></div>
            <div><dt>Build</dt><dd>Static HTML</dd></div>
            <div><dt>Tracking</dt><dd>None</dd></div>
            <div><dt>Accounts</dt><dd>None</dd></div>
            <div><dt>Focus</dt><dd>Next Step Bot</dd></div>
            <div><dt>Bot docs</dt><dd>v{policies[0]?.data.version ?? '0.2.0'} · draft</dd></div>
            <div><dt>Modules</dt><dd>{BOT_MODULES.length} · {COMMANDS.length} commands</dd></div>
            <div><dt>Search</dt><dd>Full text</dd></div>
          </dl>
          <div class="hud-foot">
            <span class="label">Local time</span>
            <time class="hud-clock" data-clock>--:--:--</time>
          </div>
        </aside>
      </div>

      <div class="stat-strip">
        <a class="stat" href="/projects">
          <span class="stat-value">{pad(projects.length)}</span>
          <span class="stat-label">Projects listed</span>
        </a>
        <a class="stat" href="/policies">
          <span class="stat-value">{pad(policies.length)}</span>
          <span class="stat-label">Policy documents</span>
        </a>
        <a class="stat" href="/links">
          <span class="stat-value">{pad(enabledLinks().length)}</span>
          <span class="stat-label">Official links</span>
        </a>
        <a class="stat" href="/devlog">
          <span class="stat-value">{pad(allPosts.length)}</span>
          <span class="stat-label">Devlog entries</span>
        </a>
        <a class="stat" href="/commands">
          <span class="stat-value">{pad(COMMANDS.length)}</span>
          <span class="stat-label">Slash commands indexed</span>
        </a>
      </div>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {
        [0, 1].map(() => (
          <div class="ticker-group">
            {tickerItems.map((item) => (
              <span>{item}</span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Start here</p>
          <h2 class="section-title" style="margin-top: 0.75rem;">{numberWord(routes.length).replace(/^./, (letter) => letter.toUpperCase())} ways into the studio</h2>
          <p class="section-sub">
            The site is small on purpose. Everything published lives behind one of these doors.
          </p>
        </div>
      </div>

      <div class="route-grid">
        {
          routes.map((route) => (
            <a class="panel panel-link route-card" href={route.href}>
              <span class="route-index">{route.index}</span>
              <h3>{route.title}</h3>
              <p>{route.body}</p>
              <span class="route-foot">
                {route.cta} <span class="card-arrow" aria-hidden="true">↗</span>
              </span>
              <span class="read-time">{route.meta}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    featured && (
      <section class="section">
        <div class="container">
          <div class="panel step-demo">
            <div class="step-demo-main">
              <p class="eyebrow">Step · Local studio guide</p>
              <h2 class="section-title">Ask the site a question.</h2>
              <p class="section-sub">
                Step reads a fact file generated from these pages and answers in the corner of the
                screen. It runs in this browser only: no account, no API, no model and no stored
                conversation.
              </p>
              <div class="step-demo-questions" role="group" aria-label="Sample questions for Step">
                {stepDemo.map((question) => (
                  <button class="step-demo-question" type="button" data-step-ask={question}>
                    {question}
                    <span aria-hidden="true">↗</span>
                  </button>
                ))}
              </div>
              <p class="step-demo-note">
                <a class="text-link" href="/step">What Step can answer, and what it cannot →</a>
              </p>
            </div>
            <aside class="step-demo-aside" aria-label="Step's privacy boundary">
              <p class="label">It never asks for</p>
              <ul>
                <li>An account or email address</li>
                <li>Permission to send your question</li>
                <li>An API key or third-party service</li>
                <li>Anything beyond this tab</li>
              </ul>
              <p class="step-demo-stamp">Local only · resets on reload</p>
            </aside>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow">Current focus</p>
              <h2 class="section-title" style="margin-top: 0.75rem;">What the Studio is building now</h2>
            </div>
            <a class="text-link mono" href="/projects" style="font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;">
              All projects
            </a>
          </div>

          <a class="panel panel-link panel--pad featured-project" href={`/projects/${featured.id}`}>
            {featured.data.cover && (
              <img class="featured-project-cover" src={featured.data.cover} alt="" width={1100} height={594} loading="lazy" />
            )}
            <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1.5rem;">
              <span class="project-card-cat">{featured.data.category}</span>
              <StatusBadge status={featured.data.status} />
            </div>
            <h3 style="font-size: clamp(1.6rem, 3.4vw, 2.35rem); margin-top: 1.1rem; letter-spacing: -0.03em;">
              {featured.data.title}
            </h3>
            <p style="color: var(--color-ink-dim); font-size: 1.0625rem; margin-top: 0.6rem; max-width: 52ch;">
              {featured.data.tagline}
            </p>
            <p style="color: var(--color-muted); margin-top: 1.15rem; max-width: 66ch; font-size: 0.9375rem;">
              {featured.data.summary}
            </p>
            <span class="project-card-foot" style="margin-top: 1.5rem;">
              Read the project page <span class="card-arrow" aria-hidden="true">↗</span>
            </span>
          </a>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Policies and contact</p>
          <h2 class="section-title" style="margin-top: 0.75rem;">Where to find the official documents</h2>
          <p class="section-sub">
            The Discord bot's policies live here at stable addresses. They are drafts
            pending review, and they cover the bot only — not this website.
          </p>
        </div>
        <a class="text-link mono" href="/downloads" style="font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;">
          Downloads
        </a>
      </div>

      <div class="split">
        <div class="panel panel--pad">
          <p class="label" style="margin-bottom: 0.9rem;">Discord bot policies · v{policies[0]?.data.version ?? '—'} drafts</p>
          <ul class="link-list">
            {policies.map((policy) => (
              <li>
                <a href={`/policies/bot/${policy.id.replace(/^bot\//, '')}`}>
                  {policy.data.shortTitle}
                  <span class="link-meta">Draft</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="panel panel--pad" style="display: flex; flex-direction: column; gap: 1rem;">
          <p class="label">Contact</p>
          <p style="color: var(--color-ink-dim); font-size: 0.9375rem;">
            Use the contact form or email directly. Both reach the studio — the form in a
            private inbox, email at the address below — and both are read by the person who
            runs the studio.
          </p>
          <a class="btn" href={`mailto:${SITE.contactEmail}`} style="align-self: flex-start; word-break: break-all;">
            {SITE.contactEmail}
          </a>
          <p style="color: var(--color-muted); font-size: 0.875rem;">
            Privacy requests are handled the same way — see
            <a class="text-link" href="/contact#privacy-requests">how to send one</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Devlog</p>
          <h2 class="section-title" style="margin-top: 0.75rem;">Notes from the work</h2>
          <p class="section-sub">Written when there is something worth reporting, not to a schedule.</p>
        </div>
        <a class="text-link mono" href="/devlog" style="font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;">
          All entries
        </a>
      </div>

      <ul class="entry-list">
        {posts.map((post) => (
          <li>
            <a class="entry" href={`/devlog/${post.id}`}>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <span class="entry-title">{post.data.title}</span>
              <span class="card-arrow" aria-hidden="true" style="color: var(--color-muted);">→</span>
              <span class="entry-summary">{post.data.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <style>
    .step-demo {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 0.65fr);
      gap: 1.5rem;
      padding: clamp(1.25rem, 3vw, 2.25rem);
      border-color: rgba(143, 182, 255, 0.24);
      background:
        linear-gradient(110deg, rgba(77, 141, 255, 0.08), rgba(167, 139, 250, 0.04)),
        var(--color-surface);
    }

    .step-demo .section-title {
      margin-top: 0.75rem;
    }

    .step-demo .section-sub {
      max-width: 58ch;
    }

    .step-demo-questions {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      margin-top: 1.15rem;
      max-width: 34rem;
    }

    .step-demo-question {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      min-height: 2.75rem;
      padding: 0.55rem 0.7rem;
      border: 1px solid var(--color-line);
      border-radius: 2px;
      background: var(--color-bg);
      color: var(--color-ink-dim);
      font: inherit;
      font-size: 0.8125rem;
      line-height: 1.4;
      text-align: left;
    }

    .step-demo-question span {
      flex: none;
      color: var(--color-accent-soft);
      font-family: var(--font-mono);
      font-size: 0.7rem;
    }

    .step-demo-question:hover {
      border-color: var(--color-accent);
      background: var(--color-surface-2);
      color: var(--color-ink);
    }

    .step-demo-note {
      margin: 0.9rem 0 0;
      font-size: 0.8125rem;
    }

    .step-demo-aside {
      padding-left: 1.5rem;
      border-left: 1px solid var(--color-line);
    }

    .step-demo-aside ul {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      margin: 0.8rem 0 0;
      padding: 0;
      list-style: none;
    }

    .step-demo-aside li {
      position: relative;
      padding-left: 1rem;
      color: var(--color-muted);
      font-size: 0.8125rem;
      line-height: 1.5;
    }

    .step-demo-aside li::before {
      content: '×';
      position: absolute;
      left: 0;
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: 0.7rem;
    }

    .step-demo-stamp {
      margin: 1.25rem 0 0;
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: 0.625rem;
      letter-spacing: 0.06em;
      line-height: 1.5;
      text-transform: uppercase;
    }

    @media (max-width: 760px) {
      .step-demo {
        grid-template-columns: 1fr;
        gap: 1.25rem;
      }

      .step-demo-aside {
        padding: 1.1rem 0 0;
        border-top: 1px solid var(--color-line);
        border-left: 0;
      }
    }
  </style>

  <script>
    const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
    if (clock) {
      const tick = () => {
        const now = new Date();
        clock.textContent = now.toLocaleTimeString('en-GB', { hour12: false });
        clock.setAttribute('datetime', now.toISOString());
      };
      tick();
      window.setInterval(tick, 1000);
    }
  </script>
</Base>
