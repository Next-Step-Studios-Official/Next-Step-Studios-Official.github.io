---
import '../styles/global.css';
import '../styles/pages.css';
import '../styles/editorial.css';
import '../styles/print.css';
import '../styles/theme.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Shortcuts from '../components/Shortcuts.astro';
import Assistant from '../components/Assistant.astro';
import { BOT_MODULES } from '../lib/modules';
import { SITE } from '../lib/site';
import { COMMANDS, COMMAND_GROUPS } from '../lib/commands';
import { TEAM_WORD } from '../lib/contributors';
import { sameAsLinks } from '../lib/links';
import { getCollection, render } from 'astro:content';

interface Props {
  title?: string;
  description: string;
  path: string;
  /** Optional share image path, e.g. /og/commands.png. */
  ogImage?: string;
  ogAlt?: string;
  /** Extra schema.org nodes appended to the page graph. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, path, ogImage: ogImageProp, ogAlt, schema } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — Independent creative and software studio`;

const base = import.meta.env.BASE_URL;
const origin = Astro.site ?? new URL(SITE.url);
const canonical = new URL(path, origin).toString();
const ogImage = new URL(
  `${base}${(ogImageProp ?? 'og-image.png').replace(/^\/+/, '')}`,
  origin,
).toString();

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).format(date);

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('devlog')).sort((b, a) => a.data.date.valueOf() - b.data.date.valueOf());
const policies = (await getCollection('policies')).sort((a, b) => a.data.order - b.data.order);

const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
const sameAs = sameAsLinks();

/** Section headings, so the palette can jump straight into a document. */
const policySections = (
  await Promise.all(
    policies.map(async (policy) => ({
      policy,
      headings: (await render(policy)).headings.filter((heading) => heading.depth === 2),
    })),
  )
).flatMap(({ policy, headings }) =>
  headings.map((heading) => ({
    title: heading.text,
    href: `/policies/bot/${policy.id.replace(/^bot\//, '')}#${heading.slug}`,
    kind: 'Section',
    meta: policy.data.shortTitle,
  })),
);

/** Everything the command palette can jump to, built once at build time. */
const searchItems = [
  { title: 'Home', href: '/', kind: 'Page', meta: 'Studio overview' },
  { title: 'Projects', href: '/projects', kind: 'Page', meta: 'Current work' },
  { title: 'Devlog', href: '/devlog', kind: 'Page', meta: 'Notes from the work' },
  { title: 'Command reference', href: '/commands', kind: 'Page', meta: `${COMMANDS.length} commands` },
  { title: 'Search', href: '/search', kind: 'Page', meta: 'Full text' },
  { title: 'Links', href: '/links', kind: 'Page', meta: 'Every official link' },
  { title: 'About', href: '/about', kind: 'Page', meta: 'The studio' },
  { title: 'Team', href: '/team', kind: 'Page', meta: 'Who contributes' },
  { title: 'Roadmap', href: '/roadmap', kind: 'Page', meta: 'What is next' },
  { title: 'Changelog', href: '/changelog', kind: 'Page', meta: 'Release record' },
  { title: 'Status', href: '/status', kind: 'Page', meta: 'Current state' },
  { title: 'Stack', href: '/stack', kind: 'Page', meta: 'What it runs on' },
  { title: 'FAQ', href: '/faq', kind: 'Page', meta: 'Straight answers' },
  { title: 'Bot modules', href: '/modules', kind: 'Page', meta: `${BOT_MODULES.length} modules` },
  { title: 'Trust centre', href: '/trust', kind: 'Page', meta: 'Data, security, requests' },
  { title: 'Glossary', href: '/glossary', kind: 'Page', meta: 'Terms defined' },
  { title: 'Press kit', href: '/press', kind: 'Page', meta: 'Logos and facts' },
  { title: 'Brand guidelines', href: '/brand', kind: 'Page', meta: 'Logo usage' },
  { title: 'Brand archive', href: '/archive', kind: 'Page', meta: 'Current and retired marks' },
  { title: 'Sitemap', href: '/sitemap', kind: 'Page', meta: 'Every page' },
  { title: 'Policies', href: '/policies', kind: 'Page', meta: 'Discord bot documents' },
  { title: 'Downloads', href: '/downloads', kind: 'Page', meta: 'Every document as a file' },
  { title: 'Contact', href: '/contact', kind: 'Page', meta: 'Email and privacy requests' },
  { title: 'Website privacy', href: '/website-privacy', kind: 'Page', meta: 'Notice for this site' },
  ...projects.map((project) => ({
    title: project.data.title,
    href: `/projects/${project.id}`,
    kind: 'Project',
    meta: project.data.category,
  })),
  ...policies.map((policy) => ({
    title: policy.data.shortTitle,
    href: `/policies/bot/${policy.id.replace(/^bot\//, '')}`,
    kind: 'Policy',
    meta: `v${policy.data.version} · draft`,
  })),
  ...posts.map((post) => ({
    title: post.data.title,
    href: `/devlog/${post.id}`,
    kind: 'Devlog',
    meta: formatDate(post.data.date),
  })),
  ...COMMAND_GROUPS.flatMap((group) =>
    COMMANDS.filter((command) => command.group === group.id).map((command) => ({
      title: `/${command.name}`,
      href: '/commands',
      kind: 'Command',
      meta: group.label,
    })),
  ),
  ...tags.map((tag) => ({
    title: `#${tag}`,
    href: `/devlog/tag/${tag}`,
    kind: 'Tag',
    meta: 'Devlog',
  })),
  // Section-level jumps last, so the first screen of an empty palette is pages.
  ...policySections,
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${origin.origin}#organization`,
      name: SITE.name,
      url: origin.origin,
      email: SITE.contactEmail,
      founder: { '@type': 'Person', name: SITE.operator },
      description:
        `An independent creative and software studio run by Candler Shaw with a team of ${TEAM_WORD} people.`,
      sameAs,

    },
    {
      '@type': 'WebSite',
      '@id': `${origin.origin}#website`,
      url: origin.origin,
      name: SITE.name,
      inLanguage: 'en-GB',
      publisher: { '@id': `${origin.origin}#organization` },
      potentialAction: {
        '@type': 'SearchAction',
        target: `${new URL('/search', origin).toString()}?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'WebPage',
      '@id': canonical,
      url: canonical,
      name: pageTitle,
      description,
      isPartOf: { '@id': `${origin.origin}#website` },
    },
    ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
  ],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Resolve the theme before the first paint, so a visitor never sees the
      // wrong palette flash. A stored choice wins; otherwise the system
      // preference decides. Dark remains the default when neither is known.
      (() => {
        try {
          const stored = localStorage.getItem('nss-theme');
          const systemLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          document.documentElement.dataset.theme =
            stored === 'light' || stored === 'dark' ? stored : systemLight ? 'light' : 'dark';
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#07080b" />
    <link rel="preload" href={`${base}fonts/inter-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/space-grotesk-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href={`${base}brand/favicon-16.png`} sizes="16x16" type="image/png" />
    <link rel="icon" href={`${base}brand/favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="icon" href={`${base}brand/favicon-64.png`} sizes="64x64" type="image/png" />
    <link rel="icon" href={`${base}brand/favicon-128.png`} sizes="128x128" type="image/png" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href={`${base}brand/apple-touch-icon.png`} />
    <link rel="alternate" type="application/rss+xml" title="Next Step Studios — Devlog" href={`${base}rss.xml`} />
    <link rel="alternate" type="application/rss+xml" title="Next Step Studios — Bot policies" href={`${base}policies/rss.xml`} />
    <link rel="sitemap" href={`${base}sitemap.xml`} type="application/xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt ?? 'Next Step Studios — games and software, built one careful step at a time.'} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header path={path} />
    <main id="main" class="site-main">
      <slot />
    </main>
    <Footer />
    <CommandPalette items={searchItems} />
    <Shortcuts />
    <Assistant />

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduceMotion && 'IntersectionObserver' in window) {
        const targets = Array.from(
          document.querySelectorAll<HTMLElement>('.section, .page-head, .hero-grid > *'),
        );
        targets.forEach((element) => element.classList.add('reveal'));

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.05 },
        );

        targets.forEach((element) => observer.observe(element));
      }

      // Pointer spotlight on panels and cards. Pure decoration, no tracking:
      // the pointer position never leaves the page.
      document.querySelectorAll<HTMLElement>('.panel, .project-card').forEach((element) => {
        element.classList.add('panel--glow');
        element.addEventListener('pointermove', (event) => {
          const rect = element.getBoundingClientRect();
          element.style.setProperty('--mx', `${Math.round(event.clientX - rect.left)}px`);
          element.style.setProperty('--my', `${Math.round(event.clientY - rect.top)}px`);
        });
      });

      // A copy-link button on every policy and devlog heading that has an id.
      // The URL is the visible address, so something copied on a local preview
      // is still useful when the site is published.
      const copyLabel = 'Copy link to this section';
      document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]').forEach((heading) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'heading-link';
        button.setAttribute('aria-label', `${copyLabel}: ${heading.textContent ?? ''}`.trim());
        button.title = copyLabel;
        button.innerHTML = '<span aria-hidden="true">#</span>';
        button.addEventListener('click', async () => {
          const url = `${location.origin}${location.pathname}#${heading.id}`;
          try {
            await navigator.clipboard.writeText(url);
            button.dataset.copied = 'true';
            window.setTimeout(() => delete button.dataset.copied, 1600);
          } catch {
            location.hash = heading.id;
          }
        });
        heading.append(button);
      });
    </script>
  </body>
</html>
