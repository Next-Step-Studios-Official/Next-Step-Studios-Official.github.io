# ── Copy this file to .env, then fill in the values you need ───────────────
#
#   D:\NextStepStudios\next-step-studios-website\.env
#
# .env is for running things on your computer. It is listed in .gitignore, so
# it is never committed. Do not add real secrets to this example file.
#
# The website build reads only PUBLIC_CONTACT_ENDPOINT. The local Node contact
# service reads the others when it starts. The deployed Cloudflare Worker does
# NOT read this file: its secrets live in Sites → Next Step Studios Contact →
# Secrets. GitHub Pages never reads .env at all.
#
# The names below are the names the code reads. Do not rename them.

# ── Website build ──────────────────────────────────────────────────────────
# Where the contact form posts. The template points at the deployed service.
# Leave this line out to use the deployed default; set it to an empty value to
# build the form in its "not connected" state, which still offers the email.
PUBLIC_CONTACT_ENDPOINT=https://next-step-studios-contact-wqep7k.freebuff.site/api/contact

# ── Local Node contact service (`npm run contact`) ─────────────────────────
PORT=8787
DATA_DIR=server-data

# The exact origin allowed to post the form. This is the GitHub Pages origin.
# The Worker uses the plural ALLOWED_ORIGINS secret instead; that belongs in
# Sites → Secrets, not in this file.
CONTACT_ALLOWED_ORIGIN=https://next-step-studios-official.github.io

# Random string, at least 32 characters. Signs session cookies and hashes IP
# addresses for rate limiting. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leaving this empty disables the local dashboard.
SESSION_SECRET=

# Output of: npm run hash-password -- "your password"
# Add --worker for the deployed Cloudflare Worker, which checks PBKDF2 hashes
# instead of scrypt. The local Node service has no first-run setup screen, so
# it needs this value. The deployed Worker can instead use its first-run screen
# and store the hash in D1.
ADMIN_PASSWORD_HASH=

# Optional: a Discord or Slack incoming webhook notified on each message.
# No bot, application or API key is involved. In Discord: hover the channel →
# Edit Channel → Integrations → Webhooks → New Webhook → Copy Webhook URL.
# Treat the URL as a password; anyone with it can post to that channel.
# For the live site put it in Sites → Next Step Studios Contact → Secrets.
# The deploy announcement uses the separate DISCORD_WEBHOOK_URL Actions secret.
CONTACT_WEBHOOK_URL=

# Optional: messages accepted per IP per 15 minutes (default 5).
CONTACT_RATE_LIMIT=5

# ── Email copies of contact messages (optional, free) ──────────────────────
# Resend's free plan sends 3,000 emails a month (100 a day), with no card and
# no company or postal address. Signup needs only an email and a password.
# Create a key at https://resend.com/api-keys (Sending access). No domain is
# required: send from onboarding@resend.dev to the account's own address.
#
# Until a domain is verified, NOTIFY_EMAIL must be the email address the Resend
# account was created with. Leave MAIL_FROM empty to use onboarding@resend.dev.
#
# If RESEND_API_KEY is empty, messages are still stored and the inbox still
# works: nothing is emailed, and nothing fails.
RESEND_API_KEY=

# Where the copy is delivered. If this is left empty, the service falls back to
# nextstepstudiosofficial.contact@gmail.com. If you change the public contact
# address, set NOTIFY_EMAIL explicitly so copies do not go to the old inbox.
# That address still has to be the Resend account address while the test sender
# is in use.
NOTIFY_EMAIL=

# The sender address. Empty means onboarding@resend.dev. Only set this to an
# address on a domain you have verified in Resend.
MAIL_FROM=
